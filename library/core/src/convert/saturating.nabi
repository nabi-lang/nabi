// core::convert::saturating: the `SaturatingFrom` impls of the
// primitives.

use core::convert::SaturatingFrom;

impl SaturatingFrom<i8> for i16 {
    const fn saturating_from(value: i8) -> i16 { value as i16 }
}

impl SaturatingFrom<i8> for i32 {
    const fn saturating_from(value: i8) -> i32 { value as i32 }
}

impl SaturatingFrom<i8> for i64 {
    const fn saturating_from(value: i8) -> i64 { value as i64 }
}

impl SaturatingFrom<i8> for isize {
    const fn saturating_from(value: i8) -> isize { value as isize }
}

impl SaturatingFrom<i8> for u8 {
    const fn saturating_from(value: i8) -> u8 {
        if value < 0 { return 0; }
        value as u8
    }
}

