// As `TryFrom<i64> for isize`.
impl TryFrom<u64> for usize {
    type Error = OverflowError;
    fn try_from(value: u64) throws (OverflowError) -> usize {
        if value > usize::MAX as u64 { throw overflow("usize"); }
        value as usize
    }
}

impl From<usize> for u64 {
    #[intrinsic("nabi.cast.usize.u64")]
    const fn from(value: usize) -> u64 { value as u64 }
}

impl From<f32> for f64 {
    #[intrinsic("nabi.cast.f32.f64")]
    const fn from(value: f32) -> f64 { value as f64 }
}
