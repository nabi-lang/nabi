// core::convert::from: the lossless `From` impls of the primitives.

use core::convert::{From, TryFrom, overflow};

impl From<i8> for i16 {
    #[intrinsic("nabi.cast.i8.i16")]
    const fn from(value: i8) -> i16 { value as i16 }
}

impl From<i8> for i32 {
    #[intrinsic("nabi.cast.i8.i32")]
    const fn from(value: i8) -> i32 { value as i32 }
}

/// The identity, so `i64: From<N>` holds for an `i64` `N` too.
impl From<i64> for i64 {
    const fn from(value: i64) -> i64 { value }
}

impl From<i8> for i64 {
    #[intrinsic("nabi.cast.i8.i64")]
    const fn from(value: i8) -> i64 { value as i64 }
}

impl From<i8> for isize {
    #[intrinsic("nabi.cast.i8.isize")]
    const fn from(value: i8) -> isize { value as isize }
}

impl From<i8> for f32 {
    #[intrinsic("nabi.cast.i8.f32")]
    const fn from(value: i8) -> f32 { value as f32 }
}

impl From<i8> for f64 {
    #[intrinsic("nabi.cast.i8.f64")]
    const fn from(value: i8) -> f64 { value as f64 }
}

impl From<i16> for i32 {
    #[intrinsic("nabi.cast.i16.i32")]
    const fn from(value: i16) -> i32 { value as i32 }
}

impl From<i16> for i64 {
    #[intrinsic("nabi.cast.i16.i64")]
    const fn from(value: i16) -> i64 { value as i64 }
}

impl From<i16> for isize {
    #[intrinsic("nabi.cast.i16.isize")]
    const fn from(value: i16) -> isize { value as isize }
}

impl From<i16> for f32 {
    #[intrinsic("nabi.cast.i16.f32")]
    const fn from(value: i16) -> f32 { value as f32 }
}

impl From<i16> for f64 {
    #[intrinsic("nabi.cast.i16.f64")]
    const fn from(value: i16) -> f64 { value as f64 }
}

impl From<i32> for i64 {
    #[intrinsic("nabi.cast.i32.i64")]
    const fn from(value: i32) -> i64 { value as i64 }
}

impl From<i32> for isize {
    #[intrinsic("nabi.cast.i32.isize")]
    const fn from(value: i32) -> isize { value as isize }
}

impl From<i32> for f64 {
    #[intrinsic("nabi.cast.i32.f64")]
    const fn from(value: i32) -> f64 { value as f64 }
}

// No `From`: `isize` is narrower than `i64` on 32-bit targets, and the
// same code builds on every target (on 64 bits it never throws).
impl TryFrom<i64> for isize {
    type Error = OverflowError;
    fn try_from(value: i64) throws (OverflowError) -> isize {
        if value < isize::MIN as i64 || value > isize::MAX as i64 { throw overflow("isize"); }
        value as isize
    }
}

impl From<isize> for i64 {
    #[intrinsic("nabi.cast.isize.i64")]
    const fn from(value: isize) -> i64 { value as i64 }
}

impl From<u8> for u16 {
    #[intrinsic("nabi.cast.u8.u16")]
    const fn from(value: u8) -> u16 { value as u16 }
}

impl From<u8> for u32 {
    #[intrinsic("nabi.cast.u8.u32")]
    const fn from(value: u8) -> u32 { value as u32 }
}

impl From<u8> for u64 {
    #[intrinsic("nabi.cast.u8.u64")]
    const fn from(value: u8) -> u64 { value as u64 }
}

impl From<u8> for usize {
    #[intrinsic("nabi.cast.u8.usize")]
    const fn from(value: u8) -> usize { value as usize }
}

impl From<u8> for i16 {
    #[intrinsic("nabi.cast.u8.i16")]
    const fn from(value: u8) -> i16 { value as i16 }
}

impl From<u8> for i32 {
    #[intrinsic("nabi.cast.u8.i32")]
    const fn from(value: u8) -> i32 { value as i32 }
}

impl From<u8> for i64 {
    #[intrinsic("nabi.cast.u8.i64")]
    const fn from(value: u8) -> i64 { value as i64 }
}

impl From<u8> for isize {
    #[intrinsic("nabi.cast.u8.isize")]
    const fn from(value: u8) -> isize { value as isize }
}

impl From<u8> for f32 {
    #[intrinsic("nabi.cast.u8.f32")]
    const fn from(value: u8) -> f32 { value as f32 }
}

impl From<u8> for f64 {
    #[intrinsic("nabi.cast.u8.f64")]
    const fn from(value: u8) -> f64 { value as f64 }
}

impl From<u16> for u32 {
    #[intrinsic("nabi.cast.u16.u32")]
    const fn from(value: u16) -> u32 { value as u32 }
}

impl From<u16> for u64 {
    #[intrinsic("nabi.cast.u16.u64")]
    const fn from(value: u16) -> u64 { value as u64 }
}

impl From<u16> for usize {
    #[intrinsic("nabi.cast.u16.usize")]
    const fn from(value: u16) -> usize { value as usize }
}

impl From<u16> for i32 {
    #[intrinsic("nabi.cast.u16.i32")]
    const fn from(value: u16) -> i32 { value as i32 }
}

impl From<u16> for i64 {
    #[intrinsic("nabi.cast.u16.i64")]
    const fn from(value: u16) -> i64 { value as i64 }
}

impl From<u16> for isize {
    #[intrinsic("nabi.cast.u16.isize")]
    const fn from(value: u16) -> isize { value as isize }
}

impl From<u16> for f32 {
    #[intrinsic("nabi.cast.u16.f32")]
    const fn from(value: u16) -> f32 { value as f32 }
}

impl From<u16> for f64 {
    #[intrinsic("nabi.cast.u16.f64")]
    const fn from(value: u16) -> f64 { value as f64 }
