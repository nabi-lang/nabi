        if !(x >= usize::MIN as f64 && x < usize::MAX as f64 + 1.0) { throw overflow("usize"); }
        x as usize
    }
}

impl TryFrom<f64> for f32 {
    type Error = OverflowError;
    /// Throws when a finite `value` is beyond `f32`'s range.
    const fn try_from(value: f64) throws (OverflowError) -> f32 {
        if value.is_finite() && value.abs() > f32::MAX as f64 { throw overflow("f32"); }
        value as f32
    }
}

// TryFrom<str>: `FromStr`'s parse; any failure (empty, a bad
// digit, out of range) throws its `ParseError`.

impl TryFrom<str> for i8 {
    type Error = ParseError;
    const fn try_from(s: str) throws (ParseError) -> i8 { try i8::from_str(s) }
}

impl TryFrom<str> for i16 {
    type Error = ParseError;
    const fn try_from(s: str) throws (ParseError) -> i16 { try i16::from_str(s) }
}

impl TryFrom<str> for i32 {
    type Error = ParseError;
    const fn try_from(s: str) throws (ParseError) -> i32 { try i32::from_str(s) }
}

impl TryFrom<str> for i64 {
    type Error = ParseError;
    const fn try_from(s: str) throws (ParseError) -> i64 { try i64::from_str(s) }
}

impl TryFrom<str> for isize {
    type Error = ParseError;
    const fn try_from(s: str) throws (ParseError) -> isize { try isize::from_str(s) }
}

impl TryFrom<str> for u8 {
    type Error = ParseError;
    const fn try_from(s: str) throws (ParseError) -> u8 { try u8::from_str(s) }
}

impl TryFrom<str> for u16 {
    type Error = ParseError;
