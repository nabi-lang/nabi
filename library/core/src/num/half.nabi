//! core::num::half: `f16` (IEEE 754 binary16) and `bf16`
//! (bfloat16), storage types held as their 16 bits. `#[keyword]` routes
//! the type names here; a literal in an `f16` / `bf16` slot is its bits,
//! rounded once from the decimal, and `as` converts to and from every
//! number primitive.
//!
//! Conversions round to nearest, ties to even, straight from the source
//! (an `f64` or an `i64` is never rounded to `f32` first). Arithmetic is
//! done in `f32` and rounded once to the type: for `+ - * / %` and
//! `sqrt` that is the correctly rounded result. Comparisons are those
//! of the `f32` values. `f16` <-> `f32` runs on the CPU where it
//! converts (x86-64 with F16C, arm64), else in the runtime.

use core::num::{Zero, One};

/// IEEE 754 binary16: 1 sign, 5 exponent and 10 significand bits.
#[lang("f16_type")]
#[keyword("f16")]
pub struct F16 {
    bits: u16;
}

/// bfloat16: `f32`'s sign and 8 exponent bits, 7 significand bits.
#[lang("bf16_type")]
#[keyword("bf16")]
pub struct BF16 {
    bits: u16;
}

impl F16 {
    /// The gap between 1.0 and the next larger value (2^-10).
    pub const EPSILON: F16 = F16 { bits: 0x1400u16 };
    /// The largest value, 65504.
    pub const MAX: F16 = F16 { bits: 0x7bffu16 };
    /// The smallest value, -65504.
    pub const MIN: F16 = F16 { bits: 0xfbffu16 };
    /// The smallest positive normal value (2^-14).
    pub const MIN_POSITIVE: F16 = F16 { bits: 0x0400u16 };
    /// Not a number: the quiet NaN with the sign bit clear.
    pub const NAN: F16 = F16 { bits: 0x7e00u16 };
    /// Positive infinity.
    pub const INFINITY: F16 = F16 { bits: 0x7c00u16 };
    /// Negative infinity.
    pub const NEG_INFINITY: F16 = F16 { bits: 0xfc00u16 };

    /// The value with the bit pattern `bits`.
    #[must_use]
    pub const fn from_bits(bits: u16) -> F16 { F16 { bits: bits } }

    /// The bit pattern.
    #[must_use]
    pub const fn to_bits(self) -> u16 { self.bits }

    /// `x` rounded to nearest, ties to even.
    #[must_use]
    pub const fn from_f32(x: f32) -> F16 { F16 { bits: unsafe { nabi_f16_from_f32(x) } } }

    /// `x` rounded to nearest, ties to even (once, not through `f32`).
    #[must_use]
    pub const fn from_f64(x: f64) -> F16 { F16 { bits: unsafe { nabi_f16_from_f64(x) } } }

    /// `x` rounded to nearest, ties to even.
    #[must_use]
    pub const fn from_i64(x: i64) -> F16 {
        // Exact in `f64` up to 2^53; past 65520 the result is inf either way.
        F16::from_f64(x as f64)
    }

    /// `x` rounded to nearest, ties to even.
    #[must_use]
    pub const fn from_u64(x: u64) -> F16 { F16::from_f64(x as f64) }

    /// The value as an `f32`, exactly.
    #[must_use]
    pub const fn to_f32(self) -> f32 { unsafe { nabi_f16_to_f32(self.bits) } }

    /// `true` for NaN.
    #[must_use]
    pub const fn is_nan(self) -> bool { self.bits & 0x7fffu16 > 0x7c00u16 }

    /// `true` for +/-inf.
    #[must_use]
    pub const fn is_infinite(self) -> bool { self.bits & 0x7fffu16 == 0x7c00u16 }

    /// `true` for neither inf nor NaN.
    #[must_use]
    pub const fn is_finite(self) -> bool { self.bits & 0x7c00u16 != 0x7c00u16 }

    /// `true` for neither zero, subnormal, inf nor NaN.
    #[must_use]
    pub const fn is_normal(self) -> bool {
        let e = self.bits & 0x7c00u16;
        e != 0u16 && e != 0x7c00u16
    }

    /// The absolute value (the sign bit cleared).
    #[must_use]
    pub const fn abs(self) -> F16 { F16 { bits: self.bits & 0x7fffu16 } }

    /// The value as an `f64`, exactly.
    #[must_use]
    pub const fn to_f64(self) -> f64 { self.to_f32() as f64 }

    /// `true` for a positive sign bit (`+0.0`, a positive NaN).
    #[must_use]
    pub const fn is_sign_positive(self) -> bool { self.bits & 0x8000u16 == 0u16 }

    /// `true` for a negative sign bit (`-0.0`, a negative NaN).
    #[must_use]
    pub const fn is_sign_negative(self) -> bool { self.bits & 0x8000u16 != 0u16 }

    /// `self`'s magnitude with `sign`'s sign bit.
    #[must_use]
    pub const fn copysign(self, sign: F16) -> F16 {
        F16::from_bits((self.bits & 0x7fffu16) | (sign.bits & 0x8000u16))
    }

    /// The smaller of the two; a NaN operand gives the other one, and
    /// `-0.0` is below `+0.0` (as `f32::min`).
    #[must_use]
    pub const fn min(self, other: F16) -> F16 { F16::from_f32(self.to_f32().min(other.to_f32())) }

    /// The larger of the two; a NaN operand gives the other one, and
    /// `+0.0` is above `-0.0` (as `f32::max`).
    #[must_use]
    pub const fn max(self, other: F16) -> F16 { F16::from_f32(self.to_f32().max(other.to_f32())) }

    /// The IEEE 754 total order: `-NaN < -inf < .. < -0 < +0 < .. < inf <
    /// NaN`. Sorting by it never fails: `xs.sort_by(f16::total_cmp)`.
    #[must_use]
    pub const fn total_cmp(self, other: F16) -> core::cmp::Ordering {
        order_key(self.bits).cmp(order_key(other.bits))
    }
}

impl BF16 {
    /// The gap between 1.0 and the next larger value (2^-7).
    pub const EPSILON: BF16 = BF16 { bits: 0x3c00u16 };
    /// The largest value, about 3.39e38.
    pub const MAX: BF16 = BF16 { bits: 0x7f7fu16 };
    /// The smallest value.
    pub const MIN: BF16 = BF16 { bits: 0xff7fu16 };
    /// The smallest positive normal value (2^-126).
    pub const MIN_POSITIVE: BF16 = BF16 { bits: 0x0080u16 };
    /// Not a number: the quiet NaN with the sign bit clear.
    pub const NAN: BF16 = BF16 { bits: 0x7fc0u16 };
    /// Positive infinity.
    pub const INFINITY: BF16 = BF16 { bits: 0x7f80u16 };
    /// Negative infinity.
    pub const NEG_INFINITY: BF16 = BF16 { bits: 0xff80u16 };

    /// The value with the bit pattern `bits`.
    #[must_use]
    pub const fn from_bits(bits: u16) -> BF16 { BF16 { bits: bits } }

    /// The bit pattern.
    #[must_use]
    pub const fn to_bits(self) -> u16 { self.bits }

    /// `x` rounded to nearest, ties to even.
    #[must_use]
    pub const fn from_f32(x: f32) -> BF16 {
        let b = x.to_bits();
        if b & 0x7fffffffu32 > 0x7f800000u32 {
            return BF16 { bits: ((b >> 16u32) | 0x40u32) as u16 };
        }
        // The high half, rounded on the low one; a carry may reach inf.
        let r = b + 0x7fffu32 + ((b >> 16u32) & 1u32);
        BF16 { bits: (r >> 16u32) as u16 }
    }

    /// `x` rounded to nearest, ties to even (once, not through `f32`).
    #[must_use]
    pub const fn from_f64(x: f64) -> BF16 { BF16 { bits: unsafe { nabi_bf16_from_f64(x) } } }

    /// `x` rounded to nearest, ties to even (once, not through `f64`).
    #[must_use]
    pub const fn from_i64(x: i64) -> BF16 { BF16 { bits: unsafe { nabi_bf16_from_i64(x) } } }

    /// `x` rounded to nearest, ties to even (once, not through `f64`).
    #[must_use]
    pub const fn from_u64(x: u64) -> BF16 { BF16 { bits: unsafe { nabi_bf16_from_u64(x) } } }

    /// The value as an `f32`, exactly: the high half of its bits.
    #[must_use]
    pub const fn to_f32(self) -> f32 {
        let b = (self.bits as u32) << 16u32;
        if self.is_nan() {
            return f32::from_bits(b | 0x400000u32);
        }
        f32::from_bits(b)
    }

    /// `true` for NaN.
    #[must_use]
    pub const fn is_nan(self) -> bool { self.bits & 0x7fffu16 > 0x7f80u16 }

    /// `true` for +/-inf.
    #[must_use]
    pub const fn is_infinite(self) -> bool { self.bits & 0x7fffu16 == 0x7f80u16 }

    /// `true` for neither inf nor NaN.
    #[must_use]
    pub const fn is_finite(self) -> bool { self.bits & 0x7f80u16 != 0x7f80u16 }

    /// `true` for neither zero, subnormal, inf nor NaN.
    #[must_use]
    pub const fn is_normal(self) -> bool {
        let e = self.bits & 0x7f80u16;
        e != 0u16 && e != 0x7f80u16
    }

    /// The absolute value (the sign bit cleared).
    #[must_use]
    pub const fn abs(self) -> BF16 { BF16 { bits: self.bits & 0x7fffu16 } }

    /// The value as an `f64`, exactly.
    #[must_use]
    pub const fn to_f64(self) -> f64 { self.to_f32() as f64 }

    /// `true` for a positive sign bit (`+0.0`, a positive NaN).
    #[must_use]
    pub const fn is_sign_positive(self) -> bool { self.bits & 0x8000u16 == 0u16 }

    /// `true` for a negative sign bit (`-0.0`, a negative NaN).
    #[must_use]
    pub const fn is_sign_negative(self) -> bool { self.bits & 0x8000u16 != 0u16 }

    /// `self`'s magnitude with `sign`'s sign bit.
    #[must_use]
    pub const fn copysign(self, sign: BF16) -> BF16 {
        BF16::from_bits((self.bits & 0x7fffu16) | (sign.bits & 0x8000u16))
    }

    /// The smaller of the two; a NaN operand gives the other one, and
    /// `-0.0` is below `+0.0` (as `f32::min`).
    #[must_use]
    pub const fn min(self, other: BF16) -> BF16 { BF16::from_f32(self.to_f32().min(other.to_f32())) }

    /// The larger of the two; a NaN operand gives the other one, and
    /// `+0.0` is above `-0.0` (as `f32::max`).
    #[must_use]
    pub const fn max(self, other: BF16) -> BF16 { BF16::from_f32(self.to_f32().max(other.to_f32())) }

    /// The IEEE 754 total order: `-NaN < -inf < .. < -0 < +0 < .. < inf <
    /// NaN`. Sorting by it never fails: `xs.sort_by(bf16::total_cmp)`.
    #[must_use]
    pub const fn total_cmp(self, other: BF16) -> core::cmp::Ordering {
        order_key(self.bits).cmp(order_key(other.bits))
    }
}

/// The IEEE 754 total order key of 16 bits: negatives reversed below
/// the positives.
const fn order_key(b: u16) -> u16 { if b & 0x8000u16 != 0u16 { ~b } else { b | 0x8000u16 } }

// What `F16` and `BF16` share, `@m` their `nabi_fmt_f64` mode bit.
#[impl_macro(half_impls)] @macro {
    (@rep[sep = ","] { (@t: ty, @m: expr) }) => {
        @for @t {
            impl Clone for @t {
                const fn clone(self) -> @t { self }
            }

            impl Copy for @t {}

            impl Default for @t {
                const fn default() -> @t { @t::from_bits(0u16) }
            }

            impl Zero for @t {
                const fn zero() -> @t { @t::from_bits(0u16) }
            }

            impl One for @t {
                const fn one() -> @t { @t::from_f32(1.0f32) }
            }

            impl Add for @t {
                type Output = @t;
                const fn add(self, rhs: @t) -> @t { @t::from_f32(self.to_f32() + rhs.to_f32()) }
            }

            impl Sub for @t {
                type Output = @t;
                const fn sub(self, rhs: @t) -> @t { @t::from_f32(self.to_f32() - rhs.to_f32()) }
            }

            impl Mul for @t {
                type Output = @t;
                const fn mul(self, rhs: @t) -> @t { @t::from_f32(self.to_f32() * rhs.to_f32()) }
            }

            impl Div for @t {
                type Output = @t;
                const fn div(self, rhs: @t) -> @t { @t::from_f32(self.to_f32() / rhs.to_f32()) }
            }

            /// IEEE `fmod`: exact, the dividend's sign.
            impl Rem for @t {
                type Output = @t;
                const fn rem(self, rhs: @t) -> @t { @t::from_f32(self.to_f32() % rhs.to_f32()) }
            }

            /// `%%`: floored, the divisor's sign.
            impl Modulo for @t {
                type Output = @t;
                const fn modulo(self, rhs: @t) -> @t { @t::from_f32(self.to_f32() %% rhs.to_f32()) }
            }

            impl Neg for @t {
                type Output = @t;
                const fn neg(self) -> @t { @t::from_bits(self.bits ^ 0x8000u16) }
            }

            impl Sqrt for @t {
                type Output = @t;
                const fn sqrt(self) -> @t { @t::from_f32(√self.to_f32()) }
            }

            impl AddAssign for @t {
                const fn add_assign(ref self, rhs: @t) { self = self + rhs; }
            }

            impl SubAssign for @t {
                const fn sub_assign(ref self, rhs: @t) { self = self - rhs; }
            }

            impl MulAssign for @t {
                const fn mul_assign(ref self, rhs: @t) { self = self * rhs; }
            }

            impl DivAssign for @t {
                const fn div_assign(ref self, rhs: @t) { self = self / rhs; }
            }

            impl RemAssign for @t {
                const fn rem_assign(ref self, rhs: @t) { self = self % rhs; }
            }

            impl ModuloAssign for @t {
                const fn modulo_assign(ref self, rhs: @t) { self = self %% rhs; }
            }

            /// IEEE equality: NaN is unequal to everything, `-0.0 == 0.0`.
            impl PartialEq for @t {
                const fn eq(self, rhs: @t) -> bool { self.to_f32() == rhs.to_f32() }
                const fn ne(self, rhs: @t) -> bool { self.to_f32() != rhs.to_f32() }
            }

            impl PartialOrd for @t {
                const fn lt(self, rhs: @t) -> bool { self.to_f32() < rhs.to_f32() }
                const fn gt(self, rhs: @t) -> bool { self.to_f32() > rhs.to_f32() }
                const fn le(self, rhs: @t) -> bool { self.to_f32() <= rhs.to_f32() }
                const fn ge(self, rhs: @t) -> bool { self.to_f32() >= rhs.to_f32() }
            }

            /// The shortest digits that read back as the same value (`0.1`,
            /// `65500`), never an exponent; `inf` / `NaN`.
            impl Display for @t {
                const fn fmt(self, ref f: Formatter) throws (FmtError) {
                    f.t = unsafe { nabi_fmt_f64(f.t, f.flags, f.counts, self.to_f64(), @m) };
                }
            }

            /// Display with `.0` on a whole number.
            impl Debug for @t {
                const fn fmt(self, ref f: Formatter) throws (FmtError) {
                    f.t = unsafe { nabi_fmt_f64(f.t, f.flags, f.counts, self.to_f64(), @m | 2u32) };
                }
            }

            /// The decimal rounded once to the type; as `f32`'s `parse`.
            impl FromStr for @t {
                type Err = ParseError;
                const fn from_str(s: str) throws (ParseError) -> @t {
                    @t::from_bits((try core::str::narrow_of(s, @m >> 2u32)) as u16)
                }
            }

            /// Exact.
            impl From<@t> for f32 {
                const fn from(value: @t) -> f32 { value.to_f32() }
            }

            /// Exact.
            impl From<@t> for f64 {
                const fn from(value: @t) -> f64 { value.to_f64() }
            }
        }
    }
}
half_impls!((F16, 4u32), (BF16, 8u32));
