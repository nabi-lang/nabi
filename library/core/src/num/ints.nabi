// core::num::ints: the integer primitives' methods and limits:
// bit operations, byte order, and the `checked_` /
// `wrapping_` / `saturating_` / `overflowing_` families that spell out
// overflow handling.
//
// `wrapping_add` / `_sub` / `_mul` and the bit counts are intrinsics;
// the rest is built on them. One regular block per type.

mod gcd;
mod signed;
mod size;
mod unsigned;

#[cfg(target_endian = "little")]
pub(pkg) const BIG_ENDIAN: bool = false;
#[cfg(target_endian = "big")]
pub(pkg) const BIG_ENDIAN: bool = true;
