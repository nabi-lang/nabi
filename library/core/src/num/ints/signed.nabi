// core::num::ints::signed: the fixed-width signed integers: i8, i16,
// i32 and i64.

use core::num::ints::BIG_ENDIAN;

// i8

impl i8 {
    /// The smallest value.
    pub const MIN: i8 = -127 - 1;
    /// The largest value.
    pub const MAX: i8 = 127;
    /// The width in bits.
    pub const BITS: u32 = 8;

    /// `self + rhs`, wrapping around at the bounds.
    #[intrinsic("nabi.wrapping_add.i8")]
    #[must_use]
    pub const fn wrapping_add(self, rhs: i8) -> i8 { self.wrapping_add(rhs) }
    /// `self - rhs`, wrapping around at the bounds.
    #[intrinsic("nabi.wrapping_sub.i8")]
    #[must_use]
    pub const fn wrapping_sub(self, rhs: i8) -> i8 { self.wrapping_sub(rhs) }
    /// `self * rhs`, wrapping around at the bounds.
    #[intrinsic("nabi.wrapping_mul.i8")]
    #[must_use]
    pub const fn wrapping_mul(self, rhs: i8) -> i8 { self.wrapping_mul(rhs) }
    #[intrinsic("nabi.ctpop.i8")]
    const fn ctpop(self) -> i8 { self.ctpop() }
    #[intrinsic("nabi.ctlz.i8")]
    const fn ctlz(self) -> i8 { self.ctlz() }
    #[intrinsic("nabi.cttz.i8")]
    const fn cttz(self) -> i8 { self.cttz() }

    /// The number of one bits.
    #[must_use]
    pub const fn count_ones(self) -> u32 { self.ctpop() as u32 }
    /// The number of zero bits.
    #[must_use]
    pub const fn count_zeros(self) -> u32 { (~self).ctpop() as u32 }
    /// The number of zero bits above the highest one bit.
    #[must_use]
    pub const fn leading_zeros(self) -> u32 { self.ctlz() as u32 }
    /// The number of zero bits below the lowest one bit.
    #[must_use]
    pub const fn trailing_zeros(self) -> u32 { self.cttz() as u32 }
    /// The number of one bits above the highest zero bit.
    #[must_use]
    pub const fn leading_ones(self) -> u32 { (~self).ctlz() as u32 }
    /// The number of one bits below the lowest zero bit.
    #[must_use]
    pub const fn trailing_ones(self) -> u32 { (~self).cttz() as u32 }

    /// The bits shifted left by `n`, those shifted out coming back on the right.
    #[must_use]
    pub const fn rotate_left(self, n: u32) -> i8 { (self as u8).rotate_left(n) as i8 }
    /// The bits shifted right by `n`, those shifted out coming back on the left.
    #[must_use]
    pub const fn rotate_right(self, n: u32) -> i8 { (self as u8).rotate_right(n) as i8 }
    /// The bytes in reverse order.
    #[must_use]
    pub const fn swap_bytes(self) -> i8 { (self as u8).swap_bytes() as i8 }

    /// `self` in big-endian byte order (unchanged on a big-endian target).
    #[must_use]
    pub const fn to_be(self) -> i8 { if BIG_ENDIAN { self } else { self.swap_bytes() } }
    /// `self` in little-endian byte order (unchanged on a little-endian target).
    #[must_use]
    pub const fn to_le(self) -> i8 { if BIG_ENDIAN { self.swap_bytes() } else { self } }
    /// The number whose big-endian bytes are `x`.
    #[must_use]
    pub const fn from_be(x: i8) -> i8 { x.to_be() }
    /// The number whose little-endian bytes are `x`.
    #[must_use]
    pub const fn from_le(x: i8) -> i8 { x.to_le() }
    /// The bytes, least significant first.
    #[must_use]
    pub const fn to_le_bytes(self) -> [u8; 1] { [self as u8] }
    /// The bytes, most significant first.
    #[must_use]
    pub const fn to_be_bytes(self) -> [u8; 1] { [self as u8] }
    /// The bytes in the target's byte order.
    #[must_use]
    pub const fn to_ne_bytes(self) -> [u8; 1] { if BIG_ENDIAN { self.to_be_bytes() } else { self.to_le_bytes() } }
    /// The number of `bytes`, least significant first.
    #[must_use]
    pub const fn from_le_bytes(bytes: [u8; 1]) -> i8 { bytes[0] as i8 }
    /// The number of `bytes`, most significant first.
    #[must_use]
    pub const fn from_be_bytes(bytes: [u8; 1]) -> i8 { bytes[0] as i8 }
    /// The number of `bytes`, in the target's byte order.
    #[must_use]
    pub const fn from_ne_bytes(bytes: [u8; 1]) -> i8 { if BIG_ENDIAN { i8::from_be_bytes(bytes) } else { i8::from_le_bytes(bytes) } }

    /// `self + rhs`, or `none` on overflow.
    #[must_use]
    pub const fn checked_add(self, rhs: i8) -> i8 | none {
        let r = self.wrapping_add(rhs);
        if (self ^ r) & (rhs ^ r) < 0 { return none; }
        r
    }
    /// `self - rhs`, or `none` on overflow.
    #[must_use]
    pub const fn checked_sub(self, rhs: i8) -> i8 | none {
        let r = self.wrapping_sub(rhs);
        if (self ^ rhs) & (self ^ r) < 0 { return none; }
        r
    }
    /// `self * rhs`, or `none` on overflow.
    #[must_use]
    pub const fn checked_mul(self, rhs: i8) -> i8 | none {
        if self == -1 { return rhs.checked_neg(); }
        let r = self.wrapping_mul(rhs);
        if self != 0 && r / self != rhs { return none; }
        r
    }
    /// `self / rhs`, or `none` when `rhs` is 0 or the quotient overflows (`MIN / -1`).
    #[must_use]
    pub const fn checked_div(self, rhs: i8) -> i8 | none {
        if rhs == 0 || self == i8::MIN && rhs == -1 { return none; }
        self / rhs
    }
    /// `self % rhs`, or `none` when `rhs` is 0 or the division overflows (`MIN % -1`).
    #[must_use]
    pub const fn checked_rem(self, rhs: i8) -> i8 | none {
        if rhs == 0 || self == i8::MIN && rhs == -1 { return none; }
        self % rhs
    }
    /// `-self`, or `none` for `MIN`.
    #[must_use]
    pub const fn checked_neg(self) -> i8 | none {
        if self == i8::MIN { return none; }
        -self
    }
    /// `self << n`, or `none` when `n` is at least `BITS`.
    #[must_use]
    pub const fn checked_shl(self, n: u32) -> i8 | none {
        if n >= 8 { return none; }
        self << (n as i8)
    }
    /// `self >> n`, or `none` when `n` is at least `BITS`.
    #[must_use]
    pub const fn checked_shr(self, n: u32) -> i8 | none {
        if n >= 8 { return none; }
        self >> (n as i8)
    }
    /// `self` to the `exp`, or `none` on overflow.
    #[must_use]
    pub const fn checked_pow(self, exp: u32) -> i8 | none {
        if exp == 0 { return 1; }
        let base = self;
        let acc: i8 = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc.checked_mul(base)?; }
            e = e >> 1;
            base = base.checked_mul(base)?;
        }
        acc.checked_mul(base)
    }

    /// `self / rhs`; `MIN / -1` wraps to `MIN`. Panics when `rhs` is 0.
    #[must_use]
    pub const fn wrapping_div(self, rhs: i8) -> i8 {
        if self == i8::MIN && rhs == -1 { return self; }
        self / rhs
    }
    /// `self % rhs`; `MIN % -1` is 0. Panics when `rhs` is 0.
    #[must_use]
    pub const fn wrapping_rem(self, rhs: i8) -> i8 {
        if rhs == -1 { return 0; }
        self % rhs
    }
    /// `-self`, wrapping around: `MIN` stays `MIN`.
    #[must_use]
    pub const fn wrapping_neg(self) -> i8 { i8::wrapping_sub(0, self) }
    /// `self << (n % BITS)`.
    #[must_use]
    pub const fn wrapping_shl(self, n: u32) -> i8 { self << ((n % 8) as i8) }
    /// `self >> (n % BITS)`.
    #[must_use]
    pub const fn wrapping_shr(self, n: u32) -> i8 { self >> ((n % 8) as i8) }
    /// `self` to the `exp`, wrapping around at the bounds.
    #[must_use]
    pub const fn wrapping_pow(self, exp: u32) -> i8 {
        let base = self;
        let acc: i8 = 1;
        let e = exp;
        while e > 0 {
            if e & 1 == 1 { acc = acc.wrapping_mul(base); }
            e = e >> 1;
            base = base.wrapping_mul(base);
        }
        acc
    }

    /// `self + rhs`, clamped to `MIN..=MAX`.
    #[must_use]
    pub const fn saturating_add(self, rhs: i8) -> i8 {
        self.checked_add(rhs) ?? (if rhs > 0 { i8::MAX } else { i8::MIN })
    }
    /// `self - rhs`, clamped to `MIN..=MAX`.
    #[must_use]
    pub const fn saturating_sub(self, rhs: i8) -> i8 {
        self.checked_sub(rhs) ?? (if rhs < 0 { i8::MAX } else { i8::MIN })
    }
    /// `self * rhs`, clamped to `MIN..=MAX`.
    #[must_use]
    pub const fn saturating_mul(self, rhs: i8) -> i8 {
        self.checked_mul(rhs) ?? (if (self < 0) != (rhs < 0) { i8::MIN } else { i8::MAX })
    }
    /// `-self`, clamped: `MIN` gives `MAX`.
    #[must_use]
    pub const fn saturating_neg(self) -> i8 { self.checked_neg() ?? i8::MAX }
    /// `self` to the `exp`, clamped to `MIN..=MAX`.
    #[must_use]
    pub const fn saturating_pow(self, exp: u32) -> i8 {
        self.checked_pow(exp) ?? (if self < 0 && exp % 2 == 1 { i8::MIN } else { i8::MAX })
    }

    /// `self + rhs` wrapped, and whether it overflowed.
    #[must_use]
    pub const fn overflowing_add(self, rhs: i8) -> (i8, bool) {
        (self.wrapping_add(rhs), self.checked_add(rhs) is none)
    }
    /// `self - rhs` wrapped, and whether it overflowed.
    #[must_use]
    pub const fn overflowing_sub(self, rhs: i8) -> (i8, bool) {
        (self.wrapping_sub(rhs), self.checked_sub(rhs) is none)
    }
    /// `self * rhs` wrapped, and whether it overflowed.
    #[must_use]
    pub const fn overflowing_mul(self, rhs: i8) -> (i8, bool) {
        (self.wrapping_mul(rhs), self.checked_mul(rhs) is none)
    }
    /// `self / rhs` wrapped, and whether it overflowed (`MIN / -1`). Panics when `rhs` is 0.
    #[must_use]
    pub const fn overflowing_div(self, rhs: i8) -> (i8, bool) {
        (self.wrapping_div(rhs), self == i8::MIN && rhs == -1)
    }
    /// `self % rhs` wrapped, and whether it overflowed (`MIN % -1`). Panics when `rhs` is 0.
    #[must_use]
    pub const fn overflowing_rem(self, rhs: i8) -> (i8, bool) {
        (self.wrapping_rem(rhs), self == i8::MIN && rhs == -1)
    }
    /// `-self` wrapped, and whether it overflowed (`MIN`).
    #[must_use]
    pub const fn overflowing_neg(self) -> (i8, bool) { (self.wrapping_neg(), self == i8::MIN) }
    /// `self << (n % BITS)`, and whether `n` was at least `BITS`.
    #[must_use]
    pub const fn overflowing_shl(self, n: u32) -> (i8, bool) { (self.wrapping_shl(n), n >= 8) }
    /// `self >> (n % BITS)`, and whether `n` was at least `BITS`.
    #[must_use]
    pub const fn overflowing_shr(self, n: u32) -> (i8, bool) { (self.wrapping_shr(n), n >= 8) }
    /// `self` to the `exp` wrapped, and whether it overflowed.
    #[must_use]
    pub const fn overflowing_pow(self, exp: u32) -> (i8, bool) {
        (self.wrapping_pow(exp), self.checked_pow(exp) is none)
    }

    /// `self` to the `exp`; overflow is the arithmetic's (a panic;
    /// a wrap with overflow checks off).
    #[must_use]
    pub const fn pow(self, exp: u32) -> i8 {
        if exp == 0 { return 1; }
        let base = self;
        let acc: i8 = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc * base; }
            e = e >> 1;
            base = base * base;
        }
        acc * base
    }
    /// The absolute value; `MIN.abs()` overflows (panics; wraps with overflow checks off).
    #[must_use]
    pub const fn abs(self) -> i8 { if self < 0 { -self } else { self } }
    /// The absolute value, or `none` for `MIN`.
    #[must_use]
    pub const fn checked_abs(self) -> i8 | none { if self < 0 { self.checked_neg() } else { self } }
    /// The absolute value, wrapping around: `MIN` stays `MIN`.
    #[must_use]
    pub const fn wrapping_abs(self) -> i8 { if self < 0 { self.wrapping_neg() } else { self } }
    /// The absolute value, clamped: `MIN` gives `MAX`.
    #[must_use]
    pub const fn saturating_abs(self) -> i8 { if self < 0 { self.saturating_neg() } else { self } }
    /// The absolute value as the unsigned type of the same width; never overflows.
    #[must_use]
    pub const fn unsigned_abs(self) -> u8 { self.wrapping_abs() as u8 }
    /// `|self - rhs|`, as the unsigned type of the same width; never overflows.
    #[must_use]
    pub const fn abs_diff(self, rhs: i8) -> u8 {
        if self < rhs {
            (rhs as u8).wrapping_sub(self as u8)
        } else {
            (self as u8).wrapping_sub(rhs as u8)
        }
    }
    /// `-1`, `0` or `1`.
    #[must_use]
    pub const fn signum(self) -> i8 {
        if self > 0 { return 1; }
        if self < 0 { return -1; }
        0
    }
    /// `true` when `self > 0`.
    #[must_use]
    pub const fn is_positive(self) -> bool { self > 0 }
    /// `true` when `self < 0`.
    #[must_use]
    pub const fn is_negative(self) -> bool { self < 0 }
    /// Quotient rounded toward negative infinity (Python's `//`);
    /// `rem_floor` is the matching remainder.
    #[must_use]
    #[track_caller]
    pub const fn div_floor(self, rhs: i8) -> i8 {
        let q = self / rhs;
        if self % rhs != 0 && ((self < 0) != (rhs < 0)) {
            return q - 1;
        }
        q
    }
    /// The remainder with the divisor's sign (Python's `%`, Nabi's
    /// `%%`): `self == self.div_floor(rhs) * rhs + self.rem_floor(rhs)`.
    #[must_use]
    #[track_caller]
    pub const fn rem_floor(self, rhs: i8) -> i8 { self %% rhs }
    /// Quotient rounded so that `rem_euclid` is never negative.
    #[must_use]
    pub const fn div_euclid(self, rhs: i8) -> i8 {
        let q = self / rhs;
        if self % rhs < 0 {
            return if rhs > 0 { q - 1 } else { q + 1 };
        }
        q
    }
    /// The remainder in `0..rhs.abs()`.
    #[must_use]
    pub const fn rem_euclid(self, rhs: i8) -> i8 {
        let r = self % rhs;
        if r < 0 {
            return if rhs < 0 { r.wrapping_sub(rhs) } else { r + rhs };
        }
        r
    }
    /// Integer square root; panics on a negative number.
    #[track_caller]
    #[must_use]
    pub const fn isqrt(self) -> i8 {
        if self < 0 { panic("i8::isqrt: the number is negative; use `checked_isqrt` to get `none` instead"); }
        (self as u8).isqrt() as i8
    }
    /// The integer square root, or `none` for a negative number.
    #[must_use]
    pub const fn checked_isqrt(self) -> i8 | none {
        if self < 0 { return none; }
        (self as u8).isqrt() as i8
    }
    /// `floor(log2(self))`; panics unless `self > 0`.
    #[track_caller]
    #[must_use]
    pub const fn ilog2(self) -> u32 { self.checked_ilog2() ?? panic("i8::ilog2: the number is not positive; use `checked_ilog2` to get `none` instead") }
    /// `floor(log10(self))`; panics unless `self > 0`.
    #[track_caller]
    #[must_use]
    pub const fn ilog10(self) -> u32 { self.checked_ilog10() ?? panic("i8::ilog10: the number is not positive; use `checked_ilog10` to get `none` instead") }
    /// `floor(log(self, base))`; panics unless `self > 0` and `base >= 2`.
    #[track_caller]
    #[must_use]
    pub const fn ilog(self, base: i8) -> u32 {
        self.checked_ilog(base) ?? panic("i8::ilog: the number is not positive or the base is below 2; use `checked_ilog` to get `none` instead")
    }
    /// `floor(log2(self))`, or `none` unless `self > 0`.
    #[must_use]
    pub const fn checked_ilog2(self) -> u32 | none {
        if self <= 0 { return none; }
        7 - self.leading_zeros()
    }
    /// `floor(log10(self))`, or `none` unless `self > 0`.
    #[must_use]
    pub const fn checked_ilog10(self) -> u32 | none { self.checked_ilog(10) }
    /// `floor(log(self, base))`, or `none` unless `self > 0` and `base >= 2`.
    #[must_use]
    pub const fn checked_ilog(self, base: i8) -> u32 | none {
        if self <= 0 || base < 2 { return none; }
        let n: u32 = 0;
        let x = self;
        while x >= base {
            x = x / base;
            n += 1;
        }
        n
    }
}

// i16

impl i16 {
    /// The smallest value.
    pub const MIN: i16 = -32767 - 1;
    /// The largest value.
    pub const MAX: i16 = 32767;
    /// The width in bits.
    pub const BITS: u32 = 16;

    /// `self + rhs`, wrapping around at the bounds.
    #[intrinsic("nabi.wrapping_add.i16")]
    #[must_use]
    pub const fn wrapping_add(self, rhs: i16) -> i16 { self.wrapping_add(rhs) }
    /// `self - rhs`, wrapping around at the bounds.
    #[intrinsic("nabi.wrapping_sub.i16")]
    #[must_use]
    pub const fn wrapping_sub(self, rhs: i16) -> i16 { self.wrapping_sub(rhs) }
    /// `self * rhs`, wrapping around at the bounds.
    #[intrinsic("nabi.wrapping_mul.i16")]
    #[must_use]
    pub const fn wrapping_mul(self, rhs: i16) -> i16 { self.wrapping_mul(rhs) }
    #[intrinsic("nabi.ctpop.i16")]
    const fn ctpop(self) -> i16 { self.ctpop() }
    #[intrinsic("nabi.ctlz.i16")]
    const fn ctlz(self) -> i16 { self.ctlz() }
    #[intrinsic("nabi.cttz.i16")]
    const fn cttz(self) -> i16 { self.cttz() }

    /// The number of one bits.
    #[must_use]
    pub const fn count_ones(self) -> u32 { self.ctpop() as u32 }
    /// The number of zero bits.
    #[must_use]
    pub const fn count_zeros(self) -> u32 { (~self).ctpop() as u32 }
    /// The number of zero bits above the highest one bit.
    #[must_use]
    pub const fn leading_zeros(self) -> u32 { self.ctlz() as u32 }
    /// The number of zero bits below the lowest one bit.
    #[must_use]
    pub const fn trailing_zeros(self) -> u32 { self.cttz() as u32 }
    /// The number of one bits above the highest zero bit.
    #[must_use]
    pub const fn leading_ones(self) -> u32 { (~self).ctlz() as u32 }
    /// The number of one bits below the lowest zero bit.
    #[must_use]
    pub const fn trailing_ones(self) -> u32 { (~self).cttz() as u32 }

    /// The bits shifted left by `n`, those shifted out coming back on the right.
    #[must_use]
    pub const fn rotate_left(self, n: u32) -> i16 { (self as u16).rotate_left(n) as i16 }
    /// The bits shifted right by `n`, those shifted out coming back on the left.
    #[must_use]
    pub const fn rotate_right(self, n: u32) -> i16 { (self as u16).rotate_right(n) as i16 }
    /// The bytes in reverse order.
    #[must_use]
    pub const fn swap_bytes(self) -> i16 { (self as u16).swap_bytes() as i16 }

    /// `self` in big-endian byte order (unchanged on a big-endian target).
    #[must_use]
    pub const fn to_be(self) -> i16 { if BIG_ENDIAN { self } else { self.swap_bytes() } }
    /// `self` in little-endian byte order (unchanged on a little-endian target).
    #[must_use]
    pub const fn to_le(self) -> i16 { if BIG_ENDIAN { self.swap_bytes() } else { self } }
    /// The number whose big-endian bytes are `x`.
    #[must_use]
    pub const fn from_be(x: i16) -> i16 { x.to_be() }
    /// The number whose little-endian bytes are `x`.
    #[must_use]
    pub const fn from_le(x: i16) -> i16 { x.to_le() }
    /// The bytes, least significant first.
    #[must_use]
    pub const fn to_le_bytes(self) -> [u8; 2] { [self as u8, (self >> 8) as u8] }
    /// The bytes, most significant first.
    #[must_use]
    pub const fn to_be_bytes(self) -> [u8; 2] { [(self >> 8) as u8, self as u8] }
    /// The bytes in the target's byte order.
    #[must_use]
    pub const fn to_ne_bytes(self) -> [u8; 2] { if BIG_ENDIAN { self.to_be_bytes() } else { self.to_le_bytes() } }
    /// The number of `bytes`, least significant first.
    #[must_use]
    pub const fn from_le_bytes(bytes: [u8; 2]) -> i16 {
        let x: u16 = 0;
        for i in 0..2 { x = x | (bytes[i] as u16) << (8 * i as u16); }
        x as i16
    }
    /// The number of `bytes`, most significant first.
    #[must_use]
    pub const fn from_be_bytes(bytes: [u8; 2]) -> i16 {
        let x: u16 = 0;
        for i in 0..2 { x = x << 8 | bytes[i] as u16; }
        x as i16
    }
    /// The number of `bytes`, in the target's byte order.
    #[must_use]
    pub const fn from_ne_bytes(bytes: [u8; 2]) -> i16 { if BIG_ENDIAN { i16::from_be_bytes(bytes) } else { i16::from_le_bytes(bytes) } }

    /// `self + rhs`, or `none` on overflow.
    #[must_use]
    pub const fn checked_add(self, rhs: i16) -> i16 | none {
        let r = self.wrapping_add(rhs);
        if (self ^ r) & (rhs ^ r) < 0 { return none; }
        r
    }
    /// `self - rhs`, or `none` on overflow.
    #[must_use]
    pub const fn checked_sub(self, rhs: i16) -> i16 | none {
        let r = self.wrapping_sub(rhs);
        if (self ^ rhs) & (self ^ r) < 0 { return none; }
        r
    }
    /// `self * rhs`, or `none` on overflow.
    #[must_use]
    pub const fn checked_mul(self, rhs: i16) -> i16 | none {
        if self == -1 { return rhs.checked_neg(); }
        let r = self.wrapping_mul(rhs);
        if self != 0 && r / self != rhs { return none; }
        r
    }
    /// `self / rhs`, or `none` when `rhs` is 0 or the quotient overflows (`MIN / -1`).
    #[must_use]
    pub const fn checked_div(self, rhs: i16) -> i16 | none {
        if rhs == 0 || self == i16::MIN && rhs == -1 { return none; }
        self / rhs
    }
    /// `self % rhs`, or `none` when `rhs` is 0 or the division overflows (`MIN % -1`).
    #[must_use]
    pub const fn checked_rem(self, rhs: i16) -> i16 | none {
        if rhs == 0 || self == i16::MIN && rhs == -1 { return none; }
        self % rhs
    }
    /// `-self`, or `none` for `MIN`.
    #[must_use]
    pub const fn checked_neg(self) -> i16 | none {
        if self == i16::MIN { return none; }
        -self
    }
    /// `self << n`, or `none` when `n` is at least `BITS`.
    #[must_use]
    pub const fn checked_shl(self, n: u32) -> i16 | none {
        if n >= 16 { return none; }
        self << (n as i16)
    }
    /// `self >> n`, or `none` when `n` is at least `BITS`.
    #[must_use]
    pub const fn checked_shr(self, n: u32) -> i16 | none {
        if n >= 16 { return none; }
        self >> (n as i16)
    }
    /// `self` to the `exp`, or `none` on overflow.
    #[must_use]
    pub const fn checked_pow(self, exp: u32) -> i16 | none {
        if exp == 0 { return 1; }
        let base = self;
        let acc: i16 = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc.checked_mul(base)?; }
            e = e >> 1;
            base = base.checked_mul(base)?;
        }
        acc.checked_mul(base)
    }

    /// `self / rhs`; `MIN / -1` wraps to `MIN`. Panics when `rhs` is 0.
    #[must_use]
    pub const fn wrapping_div(self, rhs: i16) -> i16 {
        if self == i16::MIN && rhs == -1 { return self; }
        self / rhs
    }
    /// `self % rhs`; `MIN % -1` is 0. Panics when `rhs` is 0.
    #[must_use]
    pub const fn wrapping_rem(self, rhs: i16) -> i16 {
        if rhs == -1 { return 0; }
        self % rhs
    }
    /// `-self`, wrapping around: `MIN` stays `MIN`.
    #[must_use]
    pub const fn wrapping_neg(self) -> i16 { i16::wrapping_sub(0, self) }
    /// `self << (n % BITS)`.
    #[must_use]
    pub const fn wrapping_shl(self, n: u32) -> i16 { self << ((n % 16) as i16) }
    /// `self >> (n % BITS)`.
    #[must_use]
    pub const fn wrapping_shr(self, n: u32) -> i16 { self >> ((n % 16) as i16) }
    /// `self` to the `exp`, wrapping around at the bounds.
    #[must_use]
    pub const fn wrapping_pow(self, exp: u32) -> i16 {
        let base = self;
        let acc: i16 = 1;
        let e = exp;
        while e > 0 {
            if e & 1 == 1 { acc = acc.wrapping_mul(base); }
            e = e >> 1;
            base = base.wrapping_mul(base);
        }
        acc
    }

    /// `self + rhs`, clamped to `MIN..=MAX`.
    #[must_use]
    pub const fn saturating_add(self, rhs: i16) -> i16 {
        self.checked_add(rhs) ?? (if rhs > 0 { i16::MAX } else { i16::MIN })
    }
    /// `self - rhs`, clamped to `MIN..=MAX`.
    #[must_use]
    pub const fn saturating_sub(self, rhs: i16) -> i16 {
        self.checked_sub(rhs) ?? (if rhs < 0 { i16::MAX } else { i16::MIN })
    }
    /// `self * rhs`, clamped to `MIN..=MAX`.
    #[must_use]
    pub const fn saturating_mul(self, rhs: i16) -> i16 {
        self.checked_mul(rhs) ?? (if (self < 0) != (rhs < 0) { i16::MIN } else { i16::MAX })
    }
    /// `-self`, clamped: `MIN` gives `MAX`.
    #[must_use]
    pub const fn saturating_neg(self) -> i16 { self.checked_neg() ?? i16::MAX }
    /// `self` to the `exp`, clamped to `MIN..=MAX`.
    #[must_use]
    pub const fn saturating_pow(self, exp: u32) -> i16 {
        self.checked_pow(exp) ?? (if self < 0 && exp % 2 == 1 { i16::MIN } else { i16::MAX })
    }

    /// `self + rhs` wrapped, and whether it overflowed.
    #[must_use]
    pub const fn overflowing_add(self, rhs: i16) -> (i16, bool) {
        (self.wrapping_add(rhs), self.checked_add(rhs) is none)
    }
    /// `self - rhs` wrapped, and whether it overflowed.
    #[must_use]
    pub const fn overflowing_sub(self, rhs: i16) -> (i16, bool) {
        (self.wrapping_sub(rhs), self.checked_sub(rhs) is none)
    }
    /// `self * rhs` wrapped, and whether it overflowed.
    #[must_use]
    pub const fn overflowing_mul(self, rhs: i16) -> (i16, bool) {
        (self.wrapping_mul(rhs), self.checked_mul(rhs) is none)
    }
    /// `self / rhs` wrapped, and whether it overflowed (`MIN / -1`). Panics when `rhs` is 0.
    #[must_use]
    pub const fn overflowing_div(self, rhs: i16) -> (i16, bool) {
        (self.wrapping_div(rhs), self == i16::MIN && rhs == -1)
    }
    /// `self % rhs` wrapped, and whether it overflowed (`MIN % -1`). Panics when `rhs` is 0.
    #[must_use]
    pub const fn overflowing_rem(self, rhs: i16) -> (i16, bool) {
        (self.wrapping_rem(rhs), self == i16::MIN && rhs == -1)
    }
    /// `-self` wrapped, and whether it overflowed (`MIN`).
    #[must_use]
    pub const fn overflowing_neg(self) -> (i16, bool) { (self.wrapping_neg(), self == i16::MIN) }
    /// `self << (n % BITS)`, and whether `n` was at least `BITS`.
    #[must_use]
    pub const fn overflowing_shl(self, n: u32) -> (i16, bool) { (self.wrapping_shl(n), n >= 16) }
    /// `self >> (n % BITS)`, and whether `n` was at least `BITS`.
    #[must_use]
    pub const fn overflowing_shr(self, n: u32) -> (i16, bool) { (self.wrapping_shr(n), n >= 16) }
    /// `self` to the `exp` wrapped, and whether it overflowed.
    #[must_use]
    pub const fn overflowing_pow(self, exp: u32) -> (i16, bool) {
        (self.wrapping_pow(exp), self.checked_pow(exp) is none)
    }

    /// `self` to the `exp`; overflow is the arithmetic's (a panic;
    /// a wrap with overflow checks off).
    #[must_use]
    pub const fn pow(self, exp: u32) -> i16 {
        if exp == 0 { return 1; }
        let base = self;
        let acc: i16 = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc * base; }
            e = e >> 1;
            base = base * base;
        }
        acc * base
    }
    /// The absolute value; `MIN.abs()` overflows (panics; wraps with overflow checks off).
    #[must_use]
    pub const fn abs(self) -> i16 { if self < 0 { -self } else { self } }
    /// The absolute value, or `none` for `MIN`.
    #[must_use]
    pub const fn checked_abs(self) -> i16 | none { if self < 0 { self.checked_neg() } else { self } }
    /// The absolute value, wrapping around: `MIN` stays `MIN`.
    #[must_use]
    pub const fn wrapping_abs(self) -> i16 { if self < 0 { self.wrapping_neg() } else { self } }
    /// The absolute value, clamped: `MIN` gives `MAX`.
    #[must_use]
    pub const fn saturating_abs(self) -> i16 { if self < 0 { self.saturating_neg() } else { self } }
    /// The absolute value as the unsigned type of the same width; never overflows.
    #[must_use]
    pub const fn unsigned_abs(self) -> u16 { self.wrapping_abs() as u16 }
    /// `|self - rhs|`, as the unsigned type of the same width; never overflows.
    #[must_use]
    pub const fn abs_diff(self, rhs: i16) -> u16 {
        if self < rhs {
            (rhs as u16).wrapping_sub(self as u16)
        } else {
            (self as u16).wrapping_sub(rhs as u16)
        }
    }
    /// `-1`, `0` or `1`.
    #[must_use]
    pub const fn signum(self) -> i16 {
        if self > 0 { return 1; }
        if self < 0 { return -1; }
        0
    }
    /// `true` when `self > 0`.
    #[must_use]
    pub const fn is_positive(self) -> bool { self > 0 }
    /// `true` when `self < 0`.
    #[must_use]
    pub const fn is_negative(self) -> bool { self < 0 }
    /// Quotient rounded toward negative infinity (Python's `//`);
    /// `rem_floor` is the matching remainder.
    #[must_use]
    #[track_caller]
    pub const fn div_floor(self, rhs: i16) -> i16 {
        let q = self / rhs;
        if self % rhs != 0 && ((self < 0) != (rhs < 0)) {
            return q - 1;
        }
        q
    }
    /// The remainder with the divisor's sign (Python's `%`, Nabi's
    /// `%%`): `self == self.div_floor(rhs) * rhs + self.rem_floor(rhs)`.
    #[must_use]
    #[track_caller]
    pub const fn rem_floor(self, rhs: i16) -> i16 { self %% rhs }
    /// Quotient rounded so that `rem_euclid` is never negative.
    #[must_use]
    pub const fn div_euclid(self, rhs: i16) -> i16 {
        let q = self / rhs;
        if self % rhs < 0 {
            return if rhs > 0 { q - 1 } else { q + 1 };
        }
        q
    }
    /// The remainder in `0..rhs.abs()`.
    #[must_use]
    pub const fn rem_euclid(self, rhs: i16) -> i16 {
        let r = self % rhs;
        if r < 0 {
            return if rhs < 0 { r.wrapping_sub(rhs) } else { r + rhs };
        }
        r
    }
    /// Integer square root; panics on a negative number.
    #[track_caller]
    #[must_use]
    pub const fn isqrt(self) -> i16 {
        if self < 0 { panic("i16::isqrt: the number is negative; use `checked_isqrt` to get `none` instead"); }
        (self as u16).isqrt() as i16
    }
    /// The integer square root, or `none` for a negative number.
    #[must_use]
    pub const fn checked_isqrt(self) -> i16 | none {
        if self < 0 { return none; }
        (self as u16).isqrt() as i16
    }
    /// `floor(log2(self))`; panics unless `self > 0`.
    #[track_caller]
    #[must_use]
    pub const fn ilog2(self) -> u32 { self.checked_ilog2() ?? panic("i16::ilog2: the number is not positive; use `checked_ilog2` to get `none` instead") }
    /// `floor(log10(self))`; panics unless `self > 0`.
    #[track_caller]
    #[must_use]
    pub const fn ilog10(self) -> u32 { self.checked_ilog10() ?? panic("i16::ilog10: the number is not positive; use `checked_ilog10` to get `none` instead") }
    /// `floor(log(self, base))`; panics unless `self > 0` and `base >= 2`.
    #[track_caller]
    #[must_use]
    pub const fn ilog(self, base: i16) -> u32 {
        self.checked_ilog(base) ?? panic("i16::ilog: the number is not positive or the base is below 2; use `checked_ilog` to get `none` instead")
    }
    /// `floor(log2(self))`, or `none` unless `self > 0`.
    #[must_use]
    pub const fn checked_ilog2(self) -> u32 | none {
        if self <= 0 { return none; }
        15 - self.leading_zeros()
    }
    /// `floor(log10(self))`, or `none` unless `self > 0`.
    #[must_use]
    pub const fn checked_ilog10(self) -> u32 | none { self.checked_ilog(10) }
    /// `floor(log(self, base))`, or `none` unless `self > 0` and `base >= 2`.
    #[must_use]
    pub const fn checked_ilog(self, base: i16) -> u32 | none {
        if self <= 0 || base < 2 { return none; }
        let n: u32 = 0;
        let x = self;
        while x >= base {
            x = x / base;
            n += 1;
        }
        n
    }
}

// i32

impl i32 {
    /// The smallest value.
    pub const MIN: i32 = -2147483647 - 1;
    /// The largest value.
    pub const MAX: i32 = 2147483647;
    /// The width in bits.
    pub const BITS: u32 = 32;

    /// `self + rhs`, wrapping around at the bounds.
    #[intrinsic("nabi.wrapping_add.i32")]
    #[must_use]
    pub const fn wrapping_add(self, rhs: i32) -> i32 { self.wrapping_add(rhs) }
    /// `self - rhs`, wrapping around at the bounds.
    #[intrinsic("nabi.wrapping_sub.i32")]
    #[must_use]
    pub const fn wrapping_sub(self, rhs: i32) -> i32 { self.wrapping_sub(rhs) }
    /// `self * rhs`, wrapping around at the bounds.
    #[intrinsic("nabi.wrapping_mul.i32")]
    #[must_use]
    pub const fn wrapping_mul(self, rhs: i32) -> i32 { self.wrapping_mul(rhs) }
    #[intrinsic("nabi.ctpop.i32")]
    const fn ctpop(self) -> i32 { self.ctpop() }
    #[intrinsic("nabi.ctlz.i32")]
    const fn ctlz(self) -> i32 { self.ctlz() }
    #[intrinsic("nabi.cttz.i32")]
    const fn cttz(self) -> i32 { self.cttz() }

    /// The number of one bits.
    #[must_use]
    pub const fn count_ones(self) -> u32 { self.ctpop() as u32 }
    /// The number of zero bits.
    #[must_use]
    pub const fn count_zeros(self) -> u32 { (~self).ctpop() as u32 }
    /// The number of zero bits above the highest one bit.
    #[must_use]
    pub const fn leading_zeros(self) -> u32 { self.ctlz() as u32 }
    /// The number of zero bits below the lowest one bit.
    #[must_use]
    pub const fn trailing_zeros(self) -> u32 { self.cttz() as u32 }
    /// The number of one bits above the highest zero bit.
    #[must_use]
    pub const fn leading_ones(self) -> u32 { (~self).ctlz() as u32 }
    /// The number of one bits below the lowest zero bit.
    #[must_use]
    pub const fn trailing_ones(self) -> u32 { (~self).cttz() as u32 }

    /// The bits shifted left by `n`, those shifted out coming back on the right.
    #[must_use]
    pub const fn rotate_left(self, n: u32) -> i32 { (self as u32).rotate_left(n) as i32 }
    /// The bits shifted right by `n`, those shifted out coming back on the left.
    #[must_use]
    pub const fn rotate_right(self, n: u32) -> i32 { (self as u32).rotate_right(n) as i32 }
    /// The bytes in reverse order.
    #[must_use]
    pub const fn swap_bytes(self) -> i32 { (self as u32).swap_bytes() as i32 }

    /// `self` in big-endian byte order (unchanged on a big-endian target).
    #[must_use]
    pub const fn to_be(self) -> i32 { if BIG_ENDIAN { self } else { self.swap_bytes() } }
    /// `self` in little-endian byte order (unchanged on a little-endian target).
    #[must_use]
    pub const fn to_le(self) -> i32 { if BIG_ENDIAN { self.swap_bytes() } else { self } }
    /// The number whose big-endian bytes are `x`.
    #[must_use]
    pub const fn from_be(x: i32) -> i32 { x.to_be() }
    /// The number whose little-endian bytes are `x`.
    #[must_use]
    pub const fn from_le(x: i32) -> i32 { x.to_le() }
    /// The bytes, least significant first.
    #[must_use]
    pub const fn to_le_bytes(self) -> [u8; 4] { [self as u8, (self >> 8) as u8, (self >> 16) as u8, (self >> 24) as u8] }
    /// The bytes, most significant first.
    #[must_use]
    pub const fn to_be_bytes(self) -> [u8; 4] { [(self >> 24) as u8, (self >> 16) as u8, (self >> 8) as u8, self as u8] }
    /// The bytes in the target's byte order.
    #[must_use]
    pub const fn to_ne_bytes(self) -> [u8; 4] { if BIG_ENDIAN { self.to_be_bytes() } else { self.to_le_bytes() } }
    /// The number of `bytes`, least significant first.
    #[must_use]
    pub const fn from_le_bytes(bytes: [u8; 4]) -> i32 {
        let x: u32 = 0;
        for i in 0..4 { x = x | (bytes[i] as u32) << (8 * i as u32); }
        x as i32
    }
    /// The number of `bytes`, most significant first.
    #[must_use]
    pub const fn from_be_bytes(bytes: [u8; 4]) -> i32 {
        let x: u32 = 0;
        for i in 0..4 { x = x << 8 | bytes[i] as u32; }
        x as i32
    }
    /// The number of `bytes`, in the target's byte order.
    #[must_use]
    pub const fn from_ne_bytes(bytes: [u8; 4]) -> i32 { if BIG_ENDIAN { i32::from_be_bytes(bytes) } else { i32::from_le_bytes(bytes) } }

    /// `self + rhs`, or `none` on overflow.
    #[must_use]
    pub const fn checked_add(self, rhs: i32) -> i32 | none {
        let r = self.wrapping_add(rhs);
        if (self ^ r) & (rhs ^ r) < 0 { return none; }
        r
    }
    /// `self - rhs`, or `none` on overflow.
    #[must_use]
    pub const fn checked_sub(self, rhs: i32) -> i32 | none {
        let r = self.wrapping_sub(rhs);
        if (self ^ rhs) & (self ^ r) < 0 { return none; }
        r
    }
    /// `self * rhs`, or `none` on overflow.
    #[must_use]
    pub const fn checked_mul(self, rhs: i32) -> i32 | none {
        if self == -1 { return rhs.checked_neg(); }
        let r = self.wrapping_mul(rhs);
        if self != 0 && r / self != rhs { return none; }
        r
    }
    /// `self / rhs`, or `none` when `rhs` is 0 or the quotient overflows (`MIN / -1`).
    #[must_use]
    pub const fn checked_div(self, rhs: i32) -> i32 | none {
        if rhs == 0 || self == i32::MIN && rhs == -1 { return none; }
        self / rhs
    }
    /// `self % rhs`, or `none` when `rhs` is 0 or the division overflows (`MIN % -1`).
    #[must_use]
    pub const fn checked_rem(self, rhs: i32) -> i32 | none {
        if rhs == 0 || self == i32::MIN && rhs == -1 { return none; }
        self % rhs
    }
    /// `-self`, or `none` for `MIN`.
    #[must_use]
    pub const fn checked_neg(self) -> i32 | none {
        if self == i32::MIN { return none; }
        -self
    }
    /// `self << n`, or `none` when `n` is at least `BITS`.
    #[must_use]
    pub const fn checked_shl(self, n: u32) -> i32 | none {
        if n >= 32 { return none; }
        self << (n as i32)
    }
    /// `self >> n`, or `none` when `n` is at least `BITS`.
    #[must_use]
    pub const fn checked_shr(self, n: u32) -> i32 | none {
        if n >= 32 { return none; }
        self >> (n as i32)
    }
    /// `self` to the `exp`, or `none` on overflow.
    #[must_use]
    pub const fn checked_pow(self, exp: u32) -> i32 | none {
        if exp == 0 { return 1; }
        let base = self;
        let acc: i32 = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc.checked_mul(base)?; }
            e = e >> 1;
            base = base.checked_mul(base)?;
        }
        acc.checked_mul(base)
    }

    /// `self / rhs`; `MIN / -1` wraps to `MIN`. Panics when `rhs` is 0.
    #[must_use]
    pub const fn wrapping_div(self, rhs: i32) -> i32 {
        if self == i32::MIN && rhs == -1 { return self; }
        self / rhs
    }
    /// `self % rhs`; `MIN % -1` is 0. Panics when `rhs` is 0.
    #[must_use]
    pub const fn wrapping_rem(self, rhs: i32) -> i32 {
        if rhs == -1 { return 0; }
        self % rhs
    }
    /// `-self`, wrapping around: `MIN` stays `MIN`.
    #[must_use]
    pub const fn wrapping_neg(self) -> i32 { i32::wrapping_sub(0, self) }
    /// `self << (n % BITS)`.
    #[must_use]
    pub const fn wrapping_shl(self, n: u32) -> i32 { self << ((n % 32) as i32) }
    /// `self >> (n % BITS)`.
    #[must_use]
    pub const fn wrapping_shr(self, n: u32) -> i32 { self >> ((n % 32) as i32) }
    /// `self` to the `exp`, wrapping around at the bounds.
    #[must_use]
    pub const fn wrapping_pow(self, exp: u32) -> i32 {
        let base = self;
        let acc: i32 = 1;
        let e = exp;
        while e > 0 {
            if e & 1 == 1 { acc = acc.wrapping_mul(base); }
            e = e >> 1;
            base = base.wrapping_mul(base);
        }
        acc
    }

    /// `self + rhs`, clamped to `MIN..=MAX`.
    #[must_use]
    pub const fn saturating_add(self, rhs: i32) -> i32 {
        self.checked_add(rhs) ?? (if rhs > 0 { i32::MAX } else { i32::MIN })
    }
    /// `self - rhs`, clamped to `MIN..=MAX`.
    #[must_use]
    pub const fn saturating_sub(self, rhs: i32) -> i32 {
        self.checked_sub(rhs) ?? (if rhs < 0 { i32::MAX } else { i32::MIN })
    }
    /// `self * rhs`, clamped to `MIN..=MAX`.
    #[must_use]
    pub const fn saturating_mul(self, rhs: i32) -> i32 {
        self.checked_mul(rhs) ?? (if (self < 0) != (rhs < 0) { i32::MIN } else { i32::MAX })
    }
    /// `-self`, clamped: `MIN` gives `MAX`.
    #[must_use]
    pub const fn saturating_neg(self) -> i32 { self.checked_neg() ?? i32::MAX }
    /// `self` to the `exp`, clamped to `MIN..=MAX`.
    #[must_use]
    pub const fn saturating_pow(self, exp: u32) -> i32 {
        self.checked_pow(exp) ?? (if self < 0 && exp % 2 == 1 { i32::MIN } else { i32::MAX })
    }

    /// `self + rhs` wrapped, and whether it overflowed.
    #[must_use]
    pub const fn overflowing_add(self, rhs: i32) -> (i32, bool) {
        (self.wrapping_add(rhs), self.checked_add(rhs) is none)
    }
    /// `self - rhs` wrapped, and whether it overflowed.
    #[must_use]
    pub const fn overflowing_sub(self, rhs: i32) -> (i32, bool) {
        (self.wrapping_sub(rhs), self.checked_sub(rhs) is none)
    }
    /// `self * rhs` wrapped, and whether it overflowed.
    #[must_use]
    pub const fn overflowing_mul(self, rhs: i32) -> (i32, bool) {
        (self.wrapping_mul(rhs), self.checked_mul(rhs) is none)
    }
    /// `self / rhs` wrapped, and whether it overflowed (`MIN / -1`). Panics when `rhs` is 0.
    #[must_use]
    pub const fn overflowing_div(self, rhs: i32) -> (i32, bool) {
        (self.wrapping_div(rhs), self == i32::MIN && rhs == -1)
    }
    /// `self % rhs` wrapped, and whether it overflowed (`MIN % -1`). Panics when `rhs` is 0.
    #[must_use]
    pub const fn overflowing_rem(self, rhs: i32) -> (i32, bool) {
        (self.wrapping_rem(rhs), self == i32::MIN && rhs == -1)
    }
    /// `-self` wrapped, and whether it overflowed (`MIN`).
    #[must_use]
    pub const fn overflowing_neg(self) -> (i32, bool) { (self.wrapping_neg(), self == i32::MIN) }
    /// `self << (n % BITS)`, and whether `n` was at least `BITS`.
    #[must_use]
    pub const fn overflowing_shl(self, n: u32) -> (i32, bool) { (self.wrapping_shl(n), n >= 32) }
    /// `self >> (n % BITS)`, and whether `n` was at least `BITS`.
    #[must_use]
    pub const fn overflowing_shr(self, n: u32) -> (i32, bool) { (self.wrapping_shr(n), n >= 32) }
    /// `self` to the `exp` wrapped, and whether it overflowed.
    #[must_use]
    pub const fn overflowing_pow(self, exp: u32) -> (i32, bool) {
        (self.wrapping_pow(exp), self.checked_pow(exp) is none)
    }

    /// `self` to the `exp`; overflow is the arithmetic's (a panic;
    /// a wrap with overflow checks off).
    #[must_use]
    pub const fn pow(self, exp: u32) -> i32 {
        if exp == 0 { return 1; }
        let base = self;
        let acc: i32 = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc * base; }
            e = e >> 1;
            base = base * base;
        }
        acc * base
    }
    /// The absolute value; `MIN.abs()` overflows (panics; wraps with overflow checks off).
    #[must_use]
    pub const fn abs(self) -> i32 { if self < 0 { -self } else { self } }
    /// The absolute value, or `none` for `MIN`.
    #[must_use]
    pub const fn checked_abs(self) -> i32 | none { if self < 0 { self.checked_neg() } else { self } }
    /// The absolute value, wrapping around: `MIN` stays `MIN`.
    #[must_use]
    pub const fn wrapping_abs(self) -> i32 { if self < 0 { self.wrapping_neg() } else { self } }
    /// The absolute value, clamped: `MIN` gives `MAX`.
    #[must_use]
    pub const fn saturating_abs(self) -> i32 { if self < 0 { self.saturating_neg() } else { self } }
    /// The absolute value as the unsigned type of the same width; never overflows.
    #[must_use]
    pub const fn unsigned_abs(self) -> u32 { self.wrapping_abs() as u32 }
    /// `|self - rhs|`, as the unsigned type of the same width; never overflows.
    #[must_use]
    pub const fn abs_diff(self, rhs: i32) -> u32 {
        if self < rhs {
            (rhs as u32).wrapping_sub(self as u32)
        } else {
            (self as u32).wrapping_sub(rhs as u32)
        }
    }
    /// `-1`, `0` or `1`.
    #[must_use]
    pub const fn signum(self) -> i32 {
        if self > 0 { return 1; }
        if self < 0 { return -1; }
        0
    }
    /// `true` when `self > 0`.
    #[must_use]
    pub const fn is_positive(self) -> bool { self > 0 }
    /// `true` when `self < 0`.
    #[must_use]
    pub const fn is_negative(self) -> bool { self < 0 }
    /// Quotient rounded toward negative infinity (Python's `//`);
    /// `rem_floor` is the matching remainder.
    #[must_use]
    #[track_caller]
    pub const fn div_floor(self, rhs: i32) -> i32 {
        let q = self / rhs;
        if self % rhs != 0 && ((self < 0) != (rhs < 0)) {
            return q - 1;
        }
        q
    }
    /// The remainder with the divisor's sign (Python's `%`, Nabi's
    /// `%%`): `self == self.div_floor(rhs) * rhs + self.rem_floor(rhs)`.
    #[must_use]
    #[track_caller]
    pub const fn rem_floor(self, rhs: i32) -> i32 { self %% rhs }
    /// Quotient rounded so that `rem_euclid` is never negative.
    #[must_use]
    pub const fn div_euclid(self, rhs: i32) -> i32 {
        let q = self / rhs;
        if self % rhs < 0 {
            return if rhs > 0 { q - 1 } else { q + 1 };
        }
        q
    }
    /// The remainder in `0..rhs.abs()`.
    #[must_use]
    pub const fn rem_euclid(self, rhs: i32) -> i32 {
        let r = self % rhs;
        if r < 0 {
            return if rhs < 0 { r.wrapping_sub(rhs) } else { r + rhs };
        }
        r
    }
    /// Integer square root; panics on a negative number.
    #[track_caller]
    #[must_use]
    pub const fn isqrt(self) -> i32 {
        if self < 0 { panic("i32::isqrt: the number is negative; use `checked_isqrt` to get `none` instead"); }
        (self as u32).isqrt() as i32
    }
    /// The integer square root, or `none` for a negative number.
    #[must_use]
    pub const fn checked_isqrt(self) -> i32 | none {
        if self < 0 { return none; }
        (self as u32).isqrt() as i32
    }
    /// `floor(log2(self))`; panics unless `self > 0`.
    #[track_caller]
    #[must_use]
    pub const fn ilog2(self) -> u32 { self.checked_ilog2() ?? panic("i32::ilog2: the number is not positive; use `checked_ilog2` to get `none` instead") }
    /// `floor(log10(self))`; panics unless `self > 0`.
    #[track_caller]
    #[must_use]
    pub const fn ilog10(self) -> u32 { self.checked_ilog10() ?? panic("i32::ilog10: the number is not positive; use `checked_ilog10` to get `none` instead") }
    /// `floor(log(self, base))`; panics unless `self > 0` and `base >= 2`.
    #[track_caller]
    #[must_use]
    pub const fn ilog(self, base: i32) -> u32 {
        self.checked_ilog(base) ?? panic("i32::ilog: the number is not positive or the base is below 2; use `checked_ilog` to get `none` instead")
    }
    /// `floor(log2(self))`, or `none` unless `self > 0`.
    #[must_use]
    pub const fn checked_ilog2(self) -> u32 | none {
        if self <= 0 { return none; }
        31 - self.leading_zeros()
    }
    /// `floor(log10(self))`, or `none` unless `self > 0`.
    #[must_use]
    pub const fn checked_ilog10(self) -> u32 | none { self.checked_ilog(10) }
    /// `floor(log(self, base))`, or `none` unless `self > 0` and `base >= 2`.
    #[must_use]
    pub const fn checked_ilog(self, base: i32) -> u32 | none {
        if self <= 0 || base < 2 { return none; }
        let n: u32 = 0;
        let x = self;
        while x >= base {
            x = x / base;
            n += 1;
        }
        n
    }
}

// i64

impl i64 {
    /// The smallest value.
    pub const MIN: i64 = -9223372036854775807 - 1;
    /// The largest value.
    pub const MAX: i64 = 9223372036854775807;
    /// The width in bits.
    pub const BITS: u32 = 64;

    /// `self + rhs`, wrapping around at the bounds.
    #[intrinsic("nabi.wrapping_add.i64")]
    #[must_use]
    pub const fn wrapping_add(self, rhs: i64) -> i64 { self.wrapping_add(rhs) }
    /// `self - rhs`, wrapping around at the bounds.
    #[intrinsic("nabi.wrapping_sub.i64")]
    #[must_use]
    pub const fn wrapping_sub(self, rhs: i64) -> i64 { self.wrapping_sub(rhs) }
    /// `self * rhs`, wrapping around at the bounds.
    #[intrinsic("nabi.wrapping_mul.i64")]
    #[must_use]
    pub const fn wrapping_mul(self, rhs: i64) -> i64 { self.wrapping_mul(rhs) }
    #[intrinsic("nabi.ctpop.i64")]
    const fn ctpop(self) -> i64 { self.ctpop() }
    #[intrinsic("nabi.ctlz.i64")]
    const fn ctlz(self) -> i64 { self.ctlz() }
    #[intrinsic("nabi.cttz.i64")]
    const fn cttz(self) -> i64 { self.cttz() }

    /// The number of one bits.
    #[must_use]
    pub const fn count_ones(self) -> u32 { self.ctpop() as u32 }
    /// The number of zero bits.
    #[must_use]
    pub const fn count_zeros(self) -> u32 { (~self).ctpop() as u32 }
    /// The number of zero bits above the highest one bit.
    #[must_use]
    pub const fn leading_zeros(self) -> u32 { self.ctlz() as u32 }
    /// The number of zero bits below the lowest one bit.
    #[must_use]
    pub const fn trailing_zeros(self) -> u32 { self.cttz() as u32 }
    /// The number of one bits above the highest zero bit.
    #[must_use]
    pub const fn leading_ones(self) -> u32 { (~self).ctlz() as u32 }
    /// The number of one bits below the lowest zero bit.
    #[must_use]
    pub const fn trailing_ones(self) -> u32 { (~self).cttz() as u32 }

    /// The bits shifted left by `n`, those shifted out coming back on the right.
    #[must_use]
    pub const fn rotate_left(self, n: u32) -> i64 { (self as u64).rotate_left(n) as i64 }
    /// The bits shifted right by `n`, those shifted out coming back on the left.
    #[must_use]
    pub const fn rotate_right(self, n: u32) -> i64 { (self as u64).rotate_right(n) as i64 }
    /// The bytes in reverse order.
    #[must_use]
    pub const fn swap_bytes(self) -> i64 { (self as u64).swap_bytes() as i64 }

    /// `self` in big-endian byte order (unchanged on a big-endian target).
    #[must_use]
    pub const fn to_be(self) -> i64 { if BIG_ENDIAN { self } else { self.swap_bytes() } }
    /// `self` in little-endian byte order (unchanged on a little-endian target).
    #[must_use]
    pub const fn to_le(self) -> i64 { if BIG_ENDIAN { self.swap_bytes() } else { self } }
    /// The number whose big-endian bytes are `x`.
    #[must_use]
    pub const fn from_be(x: i64) -> i64 { x.to_be() }
    /// The number whose little-endian bytes are `x`.
    #[must_use]
    pub const fn from_le(x: i64) -> i64 { x.to_le() }
    /// The bytes, least significant first.
    #[must_use]
    pub const fn to_le_bytes(self) -> [u8; 8] { [self as u8, (self >> 8) as u8, (self >> 16) as u8, (self >> 24) as u8, (self >> 32) as u8, (self >> 40) as u8, (self >> 48) as u8, (self >> 56) as u8] }
    /// The bytes, most significant first.
    #[must_use]
    pub const fn to_be_bytes(self) -> [u8; 8] { [(self >> 56) as u8, (self >> 48) as u8, (self >> 40) as u8, (self >> 32) as u8, (self >> 24) as u8, (self >> 16) as u8, (self >> 8) as u8, self as u8] }
    /// The bytes in the target's byte order.
    #[must_use]
    pub const fn to_ne_bytes(self) -> [u8; 8] { if BIG_ENDIAN { self.to_be_bytes() } else { self.to_le_bytes() } }
    /// The number of `bytes`, least significant first.
    #[must_use]
    pub const fn from_le_bytes(bytes: [u8; 8]) -> i64 {
        let x: u64 = 0;
        for i in 0..8 { x = x | (bytes[i] as u64) << (8 * i as u64); }
        x as i64
    }
    /// The number of `bytes`, most significant first.
    #[must_use]
    pub const fn from_be_bytes(bytes: [u8; 8]) -> i64 {
        let x: u64 = 0;
        for i in 0..8 { x = x << 8 | bytes[i] as u64; }
        x as i64
    }
    /// The number of `bytes`, in the target's byte order.
    #[must_use]
    pub const fn from_ne_bytes(bytes: [u8; 8]) -> i64 { if BIG_ENDIAN { i64::from_be_bytes(bytes) } else { i64::from_le_bytes(bytes) } }

    /// `self + rhs`, or `none` on overflow.
    #[must_use]
    pub const fn checked_add(self, rhs: i64) -> i64 | none {
        let r = self.wrapping_add(rhs);
        if (self ^ r) & (rhs ^ r) < 0 { return none; }
        r
    }
    /// `self - rhs`, or `none` on overflow.
    #[must_use]
    pub const fn checked_sub(self, rhs: i64) -> i64 | none {
        let r = self.wrapping_sub(rhs);
        if (self ^ rhs) & (self ^ r) < 0 { return none; }
        r
    }
    /// `self * rhs`, or `none` on overflow.
    #[must_use]
    pub const fn checked_mul(self, rhs: i64) -> i64 | none {
        if self == -1 { return rhs.checked_neg(); }
        let r = self.wrapping_mul(rhs);
        if self != 0 && r / self != rhs { return none; }
        r
    }
    /// `self / rhs`, or `none` when `rhs` is 0 or the quotient overflows (`MIN / -1`).
    #[must_use]
    pub const fn checked_div(self, rhs: i64) -> i64 | none {
        if rhs == 0 || self == i64::MIN && rhs == -1 { return none; }
        self / rhs
    }
    /// `self % rhs`, or `none` when `rhs` is 0 or the division overflows (`MIN % -1`).
    #[must_use]
    pub const fn checked_rem(self, rhs: i64) -> i64 | none {
        if rhs == 0 || self == i64::MIN && rhs == -1 { return none; }
        self % rhs
    }
    /// `-self`, or `none` for `MIN`.
    #[must_use]
    pub const fn checked_neg(self) -> i64 | none {
        if self == i64::MIN { return none; }
        -self
    }
    /// `self << n`, or `none` when `n` is at least `BITS`.
    #[must_use]
    pub const fn checked_shl(self, n: u32) -> i64 | none {
        if n >= 64 { return none; }
        self << (n as i64)
    }
    /// `self >> n`, or `none` when `n` is at least `BITS`.
    #[must_use]
    pub const fn checked_shr(self, n: u32) -> i64 | none {
        if n >= 64 { return none; }
        self >> (n as i64)
    }
    /// `self` to the `exp`, or `none` on overflow.
    #[must_use]
    pub const fn checked_pow(self, exp: u32) -> i64 | none {
        if exp == 0 { return 1; }
        let base = self;
        let acc: i64 = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc.checked_mul(base)?; }
            e = e >> 1;
            base = base.checked_mul(base)?;
        }
        acc.checked_mul(base)
    }

    /// `self / rhs`; `MIN / -1` wraps to `MIN`. Panics when `rhs` is 0.
    #[must_use]
    pub const fn wrapping_div(self, rhs: i64) -> i64 {
        if self == i64::MIN && rhs == -1 { return self; }
        self / rhs
    }
    /// `self % rhs`; `MIN % -1` is 0. Panics when `rhs` is 0.
    #[must_use]
    pub const fn wrapping_rem(self, rhs: i64) -> i64 {
        if rhs == -1 { return 0; }
        self % rhs
    }
    /// `-self`, wrapping around: `MIN` stays `MIN`.
    #[must_use]
    pub const fn wrapping_neg(self) -> i64 { i64::wrapping_sub(0, self) }
    /// `self << (n % BITS)`.
    #[must_use]
    pub const fn wrapping_shl(self, n: u32) -> i64 { self << ((n % 64) as i64) }
    /// `self >> (n % BITS)`.
    #[must_use]
    pub const fn wrapping_shr(self, n: u32) -> i64 { self >> ((n % 64) as i64) }
    /// `self` to the `exp`, wrapping around at the bounds.
    #[must_use]
    pub const fn wrapping_pow(self, exp: u32) -> i64 {
        let base = self;
        let acc: i64 = 1;
        let e = exp;
        while e > 0 {
            if e & 1 == 1 { acc = acc.wrapping_mul(base); }
            e = e >> 1;
            base = base.wrapping_mul(base);
        }
        acc
    }

    /// `self + rhs`, clamped to `MIN..=MAX`.
    #[must_use]
    pub const fn saturating_add(self, rhs: i64) -> i64 {
        self.checked_add(rhs) ?? (if rhs > 0 { i64::MAX } else { i64::MIN })
    }
    /// `self - rhs`, clamped to `MIN..=MAX`.
    #[must_use]
    pub const fn saturating_sub(self, rhs: i64) -> i64 {
        self.checked_sub(rhs) ?? (if rhs < 0 { i64::MAX } else { i64::MIN })
    }
    /// `self * rhs`, clamped to `MIN..=MAX`.
    #[must_use]
    pub const fn saturating_mul(self, rhs: i64) -> i64 {
        self.checked_mul(rhs) ?? (if (self < 0) != (rhs < 0) { i64::MIN } else { i64::MAX })
    }
    /// `-self`, clamped: `MIN` gives `MAX`.
    #[must_use]
    pub const fn saturating_neg(self) -> i64 { self.checked_neg() ?? i64::MAX }
    /// `self` to the `exp`, clamped to `MIN..=MAX`.
    #[must_use]
    pub const fn saturating_pow(self, exp: u32) -> i64 {
        self.checked_pow(exp) ?? (if self < 0 && exp % 2 == 1 { i64::MIN } else { i64::MAX })
    }

    /// `self + rhs` wrapped, and whether it overflowed.
    #[must_use]
    pub const fn overflowing_add(self, rhs: i64) -> (i64, bool) {
        (self.wrapping_add(rhs), self.checked_add(rhs) is none)
    }
    /// `self - rhs` wrapped, and whether it overflowed.
    #[must_use]
    pub const fn overflowing_sub(self, rhs: i64) -> (i64, bool) {
        (self.wrapping_sub(rhs), self.checked_sub(rhs) is none)
    }
    /// `self * rhs` wrapped, and whether it overflowed.
    #[must_use]
    pub const fn overflowing_mul(self, rhs: i64) -> (i64, bool) {
        (self.wrapping_mul(rhs), self.checked_mul(rhs) is none)
    }
    /// `self / rhs` wrapped, and whether it overflowed (`MIN / -1`). Panics when `rhs` is 0.
    #[must_use]
    pub const fn overflowing_div(self, rhs: i64) -> (i64, bool) {
        (self.wrapping_div(rhs), self == i64::MIN && rhs == -1)
    }
    /// `self % rhs` wrapped, and whether it overflowed (`MIN % -1`). Panics when `rhs` is 0.
    #[must_use]
    pub const fn overflowing_rem(self, rhs: i64) -> (i64, bool) {
        (self.wrapping_rem(rhs), self == i64::MIN && rhs == -1)
    }
    /// `-self` wrapped, and whether it overflowed (`MIN`).
    #[must_use]
    pub const fn overflowing_neg(self) -> (i64, bool) { (self.wrapping_neg(), self == i64::MIN) }
    /// `self << (n % BITS)`, and whether `n` was at least `BITS`.
    #[must_use]
    pub const fn overflowing_shl(self, n: u32) -> (i64, bool) { (self.wrapping_shl(n), n >= 64) }
    /// `self >> (n % BITS)`, and whether `n` was at least `BITS`.
    #[must_use]
    pub const fn overflowing_shr(self, n: u32) -> (i64, bool) { (self.wrapping_shr(n), n >= 64) }
    /// `self` to the `exp` wrapped, and whether it overflowed.
    #[must_use]
    pub const fn overflowing_pow(self, exp: u32) -> (i64, bool) {
        (self.wrapping_pow(exp), self.checked_pow(exp) is none)
    }

    /// `self` to the `exp`; overflow is the arithmetic's (a panic;
    /// a wrap with overflow checks off).
    #[must_use]
    pub const fn pow(self, exp: u32) -> i64 {
        if exp == 0 { return 1; }
        let base = self;
        let acc: i64 = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc * base; }
            e = e >> 1;
            base = base * base;
        }
        acc * base
    }
    /// The absolute value; `MIN.abs()` overflows (panics; wraps with overflow checks off).
    #[must_use]
    pub const fn abs(self) -> i64 { if self < 0 { -self } else { self } }
    /// The absolute value, or `none` for `MIN`.
    #[must_use]
    pub const fn checked_abs(self) -> i64 | none { if self < 0 { self.checked_neg() } else { self } }
    /// The absolute value, wrapping around: `MIN` stays `MIN`.
    #[must_use]
    pub const fn wrapping_abs(self) -> i64 { if self < 0 { self.wrapping_neg() } else { self } }
    /// The absolute value, clamped: `MIN` gives `MAX`.
    #[must_use]
    pub const fn saturating_abs(self) -> i64 { if self < 0 { self.saturating_neg() } else { self } }
    /// The absolute value as the unsigned type of the same width; never overflows.
    #[must_use]
    pub const fn unsigned_abs(self) -> u64 { self.wrapping_abs() as u64 }
    /// `|self - rhs|`, as the unsigned type of the same width; never overflows.
    #[must_use]
    pub const fn abs_diff(self, rhs: i64) -> u64 {
        if self < rhs {
            (rhs as u64).wrapping_sub(self as u64)
        } else {
            (self as u64).wrapping_sub(rhs as u64)
        }
    }
    /// `-1`, `0` or `1`.
    #[must_use]
    pub const fn signum(self) -> i64 {
        if self > 0 { return 1; }
        if self < 0 { return -1; }
        0
    }
    /// `true` when `self > 0`.
    #[must_use]
    pub const fn is_positive(self) -> bool { self > 0 }
    /// `true` when `self < 0`.
    #[must_use]
    pub const fn is_negative(self) -> bool { self < 0 }
    /// Quotient rounded toward negative infinity (Python's `//`);
    /// `rem_floor` is the matching remainder.
    #[must_use]
    #[track_caller]
    pub const fn div_floor(self, rhs: i64) -> i64 {
        let q = self / rhs;
        if self % rhs != 0 && ((self < 0) != (rhs < 0)) {
            return q - 1;
        }
        q
    }
    /// The remainder with the divisor's sign (Python's `%`, Nabi's
    /// `%%`): `self == self.div_floor(rhs) * rhs + self.rem_floor(rhs)`.
    #[must_use]
    #[track_caller]
    pub const fn rem_floor(self, rhs: i64) -> i64 { self %% rhs }
    /// Quotient rounded so that `rem_euclid` is never negative.
    #[must_use]
    pub const fn div_euclid(self, rhs: i64) -> i64 {
        let q = self / rhs;
        if self % rhs < 0 {
            return if rhs > 0 { q - 1 } else { q + 1 };
        }
        q
    }
    /// The remainder in `0..rhs.abs()`.
    #[must_use]
    pub const fn rem_euclid(self, rhs: i64) -> i64 {
        let r = self % rhs;
        if r < 0 {
            return if rhs < 0 { r.wrapping_sub(rhs) } else { r + rhs };
        }
        r
    }
    /// Integer square root; panics on a negative number.
    #[track_caller]
    #[must_use]
    pub const fn isqrt(self) -> i64 {
        if self < 0 { panic("i64::isqrt: the number is negative; use `checked_isqrt` to get `none` instead"); }
        (self as u64).isqrt() as i64
    }
    /// The integer square root, or `none` for a negative number.
    #[must_use]
    pub const fn checked_isqrt(self) -> i64 | none {
        if self < 0 { return none; }
        (self as u64).isqrt() as i64
    }
    /// `floor(log2(self))`; panics unless `self > 0`.
    #[track_caller]
    #[must_use]
    pub const fn ilog2(self) -> u32 { self.checked_ilog2() ?? panic("i64::ilog2: the number is not positive; use `checked_ilog2` to get `none` instead") }
    /// `floor(log10(self))`; panics unless `self > 0`.
    #[track_caller]
    #[must_use]
    pub const fn ilog10(self) -> u32 { self.checked_ilog10() ?? panic("i64::ilog10: the number is not positive; use `checked_ilog10` to get `none` instead") }
    /// `floor(log(self, base))`; panics unless `self > 0` and `base >= 2`.
    #[track_caller]
    #[must_use]
    pub const fn ilog(self, base: i64) -> u32 {
        self.checked_ilog(base) ?? panic("i64::ilog: the number is not positive or the base is below 2; use `checked_ilog` to get `none` instead")
    }
    /// `floor(log2(self))`, or `none` unless `self > 0`.
    #[must_use]
    pub const fn checked_ilog2(self) -> u32 | none {
        if self <= 0 { return none; }
        63 - self.leading_zeros()
    }
    /// `floor(log10(self))`, or `none` unless `self > 0`.
    #[must_use]
    pub const fn checked_ilog10(self) -> u32 | none { self.checked_ilog(10) }
    /// `floor(log(self, base))`, or `none` unless `self > 0` and `base >= 2`.
    #[must_use]
    pub const fn checked_ilog(self, base: i64) -> u32 | none {
        if self <= 0 || base < 2 { return none; }
        let n: u32 = 0;
        let x = self;
        while x >= base {
            x = x / base;
            n += 1;
        }
        n
    }
}
