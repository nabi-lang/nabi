//! core::collections::dict - `Dict<K, V, S>`, a hash map
//! hashing with `S` (the process-keyed `RandomState` by
//! default), compact: entries are appended to dense key / value / hash
//! arrays, and a power-of-two index of linear-probed slots maps a hash to
//! its entry. A table of at most `SMALL` entries has no index: lookup
//! scans the hashes. `remove` leaves a hole; holes are squeezed out when
//! the entries are full. One object holds the counts and the current
//! arrays, swapped on growth. Iteration follows the entries, so it is in
//! insertion order: a present key re-inserted
//! keeps its place, a removed one re-inserted goes last.

use core::hash::{BuildHasher, RandomState};
use core::marker::{Memo, Transfer, buf_is_null, copy_buf};

/// The dict's object. `keys` / `vals` have one more slot that stays
/// zero: a hole's key and value are overwritten with it, so a removed
/// entry keeps nothing alive. `meta` holds `cap` entry hashes (0: a
/// hole), then `slots` index slots (0: empty, else entry + 1). An index
/// slot of a removed entry stays, pointing at the hole: a tombstone,
/// passed over because no lookup hash is 0. Index slots in use never
/// exceed `cap`, at most 2/3 of `slots`, so probing always ends.
pub struct DictHead<K, V, S> {
    len: usize;
    n: usize;
    cap: usize;
    slots: usize;
    keys: GcBuf<K>;
    vals: GcBuf<V>;
    meta: GcBuf<u64>;
    state: S;
    /// The hashes were made at compile time, with the reserved key: the
    /// first operation at run time rehashes.
    stale: bool;
}

/// Entries a table holds without an index.
const SMALL: usize = 16;

/// `find`'s answer for an absent key.
const ABSENT: usize = usize::MAX;

/// Compile-time evaluation: the process key reads as all zero there.
const fn compile_time() -> bool {
    RandomState::new().is_reserved()
}

/// `k`'s hash with a hasher of `state`'s; never 0, which marks a hole.
/// `RandomState` hashes a `str` or an integer key in one call, with
/// the hash its hasher would give.
#[inline]
const fn hash_with<K: Hash, S: BuildHasher>(state: S, k: K) -> u64 {
    let x = 0u64;
    if S is RandomState && K is str {
        x = state.hash_str(k);
    } else if S is RandomState && K is i64 {
        x = state.hash_int(k as u64, 8);
    } else if S is RandomState && K is u64 {
        x = state.hash_int(k, 8);
    } else if S is RandomState && K is usize {
        x = state.hash_int(k as u64, 8);
    } else if S is RandomState && K is isize {
        x = state.hash_int(k as i64 as u64, 8);
    } else if S is RandomState && K is i32 {
        x = state.hash_int(k as u32 as u64, 4);
    } else if S is RandomState && K is u32 {
        x = state.hash_int(k as u64, 4);
    } else {
        let h = state.build_hasher();
        k.hash(ref h);
        x = h.finish();
    }
    if x == 0u64 { 1u64 } else { x }
}

/// Point a free index slot of hash `h` at entry `at`: `meta` holds
/// `cap` hashes, then `slots` (a power of two, not 0) index slots.
#[inline]
const unsafe fn place(meta: GcBuf<u64>, cap: usize, slots: usize, h: u64, at: usize) {
    let mask = slots - 1;
    let i = (h as usize) & mask;
    while meta[cap + i] != 0u64 {
        i = (i + 1) & mask;
    }
    meta[cap + i] = (at + 1) as u64;
}

/// Index slots for `cap` entries: none up to `SMALL`, else a power of
/// two of at least 3/2 `cap`.
#[track_caller]
const fn index_slots(cap: usize) -> usize {
    if cap <= SMALL {
        return 0;
    }
    let want = cap_add(cap, cap / 2);
    let s = 32usize;
    while s < want {
        s = cap_mul(s, 2);
    }
    s
}

/// A table of no entries in `h[0]`, a fresh (zeroed) head: its arrays
/// stay the zero handle, never read, until the first insert allocates
/// them. Run time only: constant evaluation has no zeroed value to
/// start from, and allocates the arrays.
const fn set_empty<K, V, S>(h: GcBuf<DictHead<K, V, S>>, state: S) {
    unsafe {
        let t = h[0];
        t.state = state;
        h[0] = t;
    }
}

/// A table of no entries that allocates only its head; run time only.
const fn empty_table<K, V, S>(state: S) -> DictHead<K, V, S> {
    unsafe {
        let z: GcBuf<DictHead<K, V, S>> = buf_new(1);
        set_empty(z, state);
        z[0]
    }
}

/// An empty table of `cap` entries.
#[track_caller]
const fn new_table<K, V, S>(cap: usize, state: S, stale: bool) -> DictHead<K, V, S> {
    unsafe {
        let n = cap_add(cap, 1);
        let slots = index_slots(cap);
        DictHead {
            len: 0,
            n: 0,
            cap,
            slots,
            keys: buf_new(buf_len(n, size_of::<K>())),
            vals: buf_new(buf_len(n, size_of::<V>())),
            meta: buf_new(buf_len(cap_add(cap, slots), 8)),
            state,
            stale,
        }
    }
}

/// `S` builds the hashers (`RandomState`: the process key).
pub struct Dict<K, V, S = RandomState> {
    h: GcBuf<DictHead<K, V, S>>;
}

// Shares its buffer like `List`.
impl<K, V, S> !Sync for Dict<K, V, S> {}

impl<K: Hash + Send + Sync, V: Send + Sync, S: BuildHasher + Send + Sync> Dict<K, V, S> {
    /// The dict as a `FrozenDict`, which threads share without a lock
    /// or a copy. O(1) (O(n) once for a dict built at compile time):
    /// the frozen dict takes the entries over, and using `self` after is
    /// a compile error (`to_dict()` gives a dict to change again; freeze
    /// a `clone()` to keep this one).
    pub fn freeze(self) -> FrozenDict<K, V, S> {
        FrozenDict { d: self.move_out() }
    }
}

/// `pairs.collect::<Dict<K, V>>()`; a later pair's value wins.
impl<K: Hash, V, S: BuildHasher + Default> FromIterator<(K, V)> for Dict<K, V, S> {
    const fn from_iter<I: IntoIterator<Item = (K, V)>>(it: I) -> Dict<K, V, S> {
        let out: Dict<K, V, S> = Dict::with_hasher(S::default());
        for (k, v) in it {
            out.insert(k, v);
        }
        out
    }
}

impl<K: Hash, V> Dict<K, V> {
    /// An empty dict; its storage is allocated at the first insert.
    pub const fn new() -> Dict<K, V> {
        Dict::with_capacity(0)
    }

    /// Room for `cap` entries before the first growth.
    #[track_caller]
    pub const fn with_capacity(cap: usize) -> Dict<K, V> {
        let state = RandomState::new();
        Dict::make(cap, state, state.is_reserved())
    }
}

impl<K: Hash, V, S: BuildHasher> Dict<K, V, S> {
    /// An empty dict hashing with `state`'s hashers; its storage is
    /// allocated at the first insert.
    pub const fn with_hasher(state: S) -> Dict<K, V, S> {
        Dict::with_capacity_and_hasher(0, state)
    }

    /// Room for `cap` entries, hashing with `state`'s hashers.
    #[track_caller]
    pub const fn with_capacity_and_hasher(cap: usize, state: S) -> Dict<K, V, S> {
        Dict::make(cap, state, compile_time())
    }

    #[track_caller]
    const fn make(cap: usize, state: S, stale: bool) -> Dict<K, V, S> {
        unsafe {
            let h: GcBuf<DictHead<K, V, S>> = buf_new(1);
            // `stale`: built during constant evaluation.
            // `stale`: built during constant evaluation. The zeroed head
            // holds a table of no entries (as `set_empty`).
            if cap == 0 && !stale {
                let t = h[0];
                t.state = state;
                h[0] = t;
            } else {
                h[0] = new_table(cap, state, stale);
            }
            Dict { h }
        }
    }

    /// What builds the dict's hashers.
    pub const fn hasher(self) -> S {
        unsafe {
            self.h[0].state
        }
    }

    /// The number of entries.
    pub const fn len(self) -> usize {
        unsafe {
            self.h[0].len
        }
    }

    /// `true` when the dict has no entry.
    pub const fn is_empty(self) -> bool {
        self.len() == 0
    }

    /// The dict's entries moved into a new dict, hashed for the run
    /// time, `self` left empty: `freeze` keeps what no handle reaches.
    pub(pkg) fn move_out(self) -> Dict<K, V, S> {
        unsafe {
            if self.h[0].stale {
                self.rehash();
            }
            let h: GcBuf<DictHead<K, V, S>> = buf_new(1);
            let s = self.h[0];
            h[0] = s;
            self.h[0] = empty_table(s.state);
            Dict { h }
        }
    }

    /// `k`'s hash.
    #[inline]
    const fn hash_of(self, k: K) -> u64 {
        unsafe {
            if self.h[0].stale {
                self.rehash();
            }
            hash_with(self.h[0].state, k)
        }
    }

    /// Hash every entry again, with the run time's key: a table built
    /// at compile time, on its first use. O(n), once.
    const fn rehash(self) {
        if compile_time() {
            return;
        }
        unsafe {
            let old = self.h[0];
            self.h[0] = new_table(old.cap, old.state, false);
            for i in 0..old.n {
                if old.meta[i] != 0u64 {
                    self.append(old.keys[i], old.vals[i], hash_with(old.state, old.keys[i]));
                }
            }
        }
    }

    /// The entry holding `k` (hash `h`), or `ABSENT`.
    #[must_use]
    const fn find(self, k: K, h: u64) -> usize {
        unsafe {
            // The fields used, read once (not the whole head).
            let slots = self.h[0].slots;
            let n = self.h[0].n;
            let cap = self.h[0].cap;
            let meta = self.h[0].meta;
            let keys = self.h[0].keys;
            if slots == 0 {
                for i in 0..n {
                    if meta[i] == h && keys[i] == k {
                        return i;
                    }
                }
                return ABSENT;
            }
            let mask = slots - 1;
            let i = (h as usize) & mask;
            loop {
                let e = meta[cap + i];
                if e == 0u64 {
                    return ABSENT;
                }
                let at = (e - 1u64) as usize;
                if meta[at] == h && keys[at] == k {
                    return at;
                }
                i = (i + 1) & mask;
            }
        }
    }

    /// Append `k` (absent, hash `h`) and `v`; the entries have
    /// room.
    const fn append(self, k: K, v: V, h: u64) {
        unsafe {
            let s = self.h[0];
            let at = s.n;
            s.keys[at] = k;
            s.vals[at] = v;
            s.meta[at] = h;
            if s.slots != 0 {
                place(s.meta, s.cap, s.slots, h, at);
            }
            // One store of the head: a field store copies all of it.
            s.n = at + 1;
            s.len += 1;
            self.h[0] = s;
        }
    }

    /// The first entry of a table of no entries: its arrays allocated
    /// with it, the head stored once.
    #[track_caller]
    const fn first(self, k: K, v: V, h: u64) {
        unsafe {
            let t: DictHead<K, V, S> = new_table(4, self.h[0].state, self.h[0].stale);
            t.keys[0] = k;
            t.vals[0] = v;
            t.meta[0] = h;
            t.n = 1;
            t.len = 1;
            self.h[0] = t;
        }
    }

    /// Make room for one more entry: squeeze out the holes when they
    /// are more than half the entries, else grow (doubling while the
    /// table has no index, then by half). The entries are copied in
    /// order and the index rebuilt from the stored hashes: nothing is
    /// hashed again.
    #[track_caller]
    const fn grow(self) {
        unsafe {
            let old = self.h[0];
            let cap = old.cap;
            if cap == 0 {
                // The first insert into an empty dict.
                self.h[0] = new_table(4, old.state, old.stale);
                return;
            }
            if old.len * 2 >= cap {
                cap = if cap < SMALL { cap_mul(cap, 2).max(4) } else { cap_add(cap, cap / 2) };
            }
            let t: DictHead<K, V, S> = new_table(cap, old.state, old.stale);
            let j = 0usize;
            for i in 0..old.n {
                let h = old.meta[i];
                if h != 0u64 {
                    t.keys[j] = old.keys[i];
                    t.vals[j] = old.vals[i];
                    t.meta[j] = h;
                    j += 1;
                }
            }
            if t.slots != 0 {
                for i in 0..j {
                    place(t.meta, t.cap, t.slots, t.meta[i], i);
                }
            }
            t.n = j;
            t.len = j;
            self.h[0] = t;
        }
    }

    /// Insert or replace; the old value, or `none`.
    #[discardable]
    pub const fn insert(self, k: K, v: V) -> V | none {
        unsafe {
            let h = self.hash_of(k);
            let at = self.find(k, h);
            if at != ABSENT {
                let vals = self.h[0].vals;
                let old = vals[at];
                vals[at] = v;
                return old;
            }
            if self.h[0].n == self.h[0].cap {
                if self.h[0].cap == 0 {
                    self.first(k, v, h);
                    return none;
                }
                self.grow();
            }
            self.append(k, v, h);
            none
        }
    }

    /// The value under `k`; `none` when `k` is absent.
    pub const fn get(self, k: K) -> V | none {
        unsafe {
            let at = self.find(k, self.hash_of(k));
            if at == ABSENT {
                return none;
            }
            self.h[0].vals[at]
        }
    }

    /// The value under `k`; `default` when `k` is absent. The dict is
    /// not changed. Python: `d.get(k, default)`.
    pub const fn get_or(self, k: K, default: V) -> V {
        self.get(k) ?? default
    }

    /// The value under `k`, first inserting `default` when `k` is
    /// absent. `d[k, default: v]` as an assignment target uses it.
    #[discardable]
    pub const fn get_or_insert(self, k: K, default: V) -> V {
        if let v: V = self.get(k) {
            return v;
        }
        self.insert(k, default);
        default
    }

    /// `true` when `k` has an entry.
    pub const fn contains_key(self, k: K) -> bool {
        self.find(k, self.hash_of(k)) != ABSENT
    }

    /// Remove `k`'s entry and return its value; `none` when `k` is absent.
    #[discardable]
    pub const fn remove(self, k: K) -> V | none {
        unsafe {
            let at = self.find(k, self.hash_of(k));
            if at == ABSENT {
                return none;
            }
            let v = self.h[0].vals[at];
            self.hole(at);
            v
        }
    }

    /// Remove `k`; the stored key and its value, or `none` when absent.
    #[discardable]
    pub const fn remove_entry(self, k: K) -> (K, V) | none {
        unsafe {
            let at = self.find(k, self.hash_of(k));
            if at == ABSENT {
                return none;
            }
            let s = self.h[0];
            let out = (s.keys[at], s.vals[at]);
            self.hole(at);
            out
        }
    }

    /// Remove and return the entry inserted last, or `none` when the
    /// dict is empty. Python: `d.popitem()`.
    ///
    /// ```nabi
    /// let d = {"a": 1, "b": 2, "c": 3};
    /// let (k, v) = d.pop_last() ?? ("", 0);
    /// assert(k == "c" && v == 3);
    /// let (k1, _) = d.pop_first() ?? ("", 0);
    /// let (k2, _) = d.remove_entry("b") ?? ("", 0);
    /// assert(k1 == "a" && k2 == "b" && d.is_empty() && d.pop_last() is none);
    /// ```
    #[discardable]
    pub const fn pop_last(self) -> (K, V) | none {
        unsafe {
            if self.h[0].len == 0 {
                return none;
            }
            let s = self.h[0];
            let i = s.n;
            while i > 0 {
                i -= 1;
                if s.meta[i] != 0u64 {
                    break;
                }
            }
            let out = (s.keys[i], s.vals[i]);
            self.hole(i);
            self.tidy();
            out
        }
    }

    /// Remove and return the entry inserted first, or `none` when the
    /// dict is empty.
    #[discardable]
    pub const fn pop_first(self) -> (K, V) | none {
        unsafe {
            if self.h[0].len == 0 {
                return none;
            }
            let i = self.next_full(0);
            let s = self.h[0];
            let out = (s.keys[i], s.vals[i]);
            self.hole(i);
            self.tidy();
            out
        }
    }

    /// Remove every entry and return them, in insertion order.
    ///
    /// ```nabi
    /// let d = {"x": 1, "y": 2};
    /// assert(d.drain() == [("x", 1), ("y", 2)] && d.is_empty());
    /// ```
    pub const fn drain(self) -> List<(K, V)> {
        let out: List<(K, V)> = List::with_capacity(self.len());
        for kv in self {
            out.push(kv);
        }
        self.clear();
        out
    }

    /// Squeeze out the holes once they outnumber the entries, so popping
    /// one end stays O(1) on average.
    const fn tidy(self) {
        unsafe {
            let s = self.h[0];
            if s.n > SMALL && s.len * 2 < s.n {
                self.grow();
            }
        }
    }

    /// Turn live entry `at` into a hole.
    const unsafe fn hole(self, at: usize) {
        let s = self.h[0];
        s.keys[at] = s.keys[s.cap];
        s.vals[at] = s.vals[s.cap];
        s.meta[at] = 0u64;
        self.h[0].len -= 1;
    }

    /// Keep only the entries `keep` accepts, in place; O(n).
    pub const fn retain(self, keep: fn(K, V) -> bool) {
        unsafe {
            let i: usize = 0;
            while i < self.h[0].n {
                let s = self.h[0];
                // Re-read after `keep`: it may have changed the dict
                // (unspecified, as for the iterators), not memory or `len`.
                if s.meta[i] != 0u64 && !keep(s.keys[i], s.vals[i]) && i < self.h[0].n && self.h[0].meta[i] != 0u64 {
                    self.hole(i);
                }
                i += 1;
            }
        }
    }

    /// Insert every `(key, value)` pair of `pairs`, in order; a later
    /// pair's value wins.
    pub const fn extend<I: IntoIterator<Item = (K, V)>>(self, pairs: I) {
        for (k, v) in pairs {
            self.insert(k, v);
        }
    }

    /// Drop every entry (a fresh empty table, allocated at the next
    /// insert).
    pub const fn clear(self) {
        unsafe {
            let s = self.h[0];
            self.h[0] = if s.stale { new_table(4, s.state, true) } else { empty_table(s.state) };
        }
    }

    /// The first live entry at or after `from`, or `n`.
    const fn next_full(self, from: usize) -> usize {
        unsafe {
            let s = self.h[0];
            let i = from;
            while i < s.n && s.meta[i] == 0u64 {
                i += 1;
            }
            i
        }
    }

    /// The keys, lazily, in insertion order.
    pub const fn keys(self) -> Keys<K, V, S> {
        Keys { d: self, at: 0 }
    }

    /// The values, lazily.
    pub const fn values(self) -> Values<K, V, S> {
        Values { d: self, at: 0 }
    }

    /// `(key, value)` pairs, lazily (insertion order).
    pub const fn iter(self) -> DictIter<K, V, S> {
        DictIter { d: self, at: 0 }
    }

    /// `k`'s place in the dict, present or not.
    pub const fn entry(self, k: K) -> Entry<K, V, S> {
        Entry { d: self, key: k }
    }
}

impl<K: Hash, S: BuildHasher> Dict<K, usize, S> {
    /// The `n` largest counts (all when `n` is `none`) as `(key,
    /// count)`, largest first; equal counts keep first-seen order.
    /// Python: `Counter.most_common(n)`; build the counts with
    /// `xs.counts()`.
    pub const fn most_common(self, n: usize | none = none) -> List<(K, usize)> {
        let out = self.iter().sorted_by_key(|p: (K, usize)| p.1, reverse: true);
        if let k: usize = n {
            out.truncate(k);
        }
        out
    }
}

/// `d.entry(k)`: read or fill one key's slot. Each call looks the key
/// up again.
pub struct Entry<K, V, S = RandomState> {
    d: Dict<K, V, S>;
    key: K;
}

impl<K, V, S> Debug for Entry<K, V, S> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Entry") }
}

impl<K: Hash, V, S: BuildHasher> Entry<K, V, S> {
    /// The entry's key.
    pub fn key(self) -> K {
        self.key
    }

    /// The value, after inserting `v` if the key is absent.
    pub const fn or_insert(self, v: V) -> V {
        if !self.d.contains_key(self.key) {
            self.d.insert(self.key, v);
        }
        self.d[self.key]
    }

    /// The value, after inserting `f()` if the key is absent.
    pub const fn or_insert_with(self, f: fn() -> V) -> V {
        if !self.d.contains_key(self.key) {
            self.d.insert(self.key, f());
        }
        self.d[self.key]
    }

    /// A present value replaced by `f(value)`; an absent key is left alone.
    pub const fn and_modify(self, f: fn(V) -> V) -> Entry<K, V, S> {
        if self.d.contains_key(self.key) {
            self.d.insert(self.key, f(self.d[self.key]));
        }
        self
    }
}

impl<K: Hash, V: Default, S: BuildHasher> Entry<K, V, S> {
    /// The value, after inserting `V::default()` if the key is absent.
    pub const fn or_default(self) -> V {
        if !self.d.contains_key(self.key) {
            self.d.insert(self.key, V::default());
        }
        self.d[self.key]
    }
}

// The iterators walk the live table; a dict changed while iterated
// gives unspecified (but memory-safe) results.

/// What `d.keys()` returns: the keys, in insertion order. Changing the
/// dict while iterating gives unspecified (memory-safe) results.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct Keys<K, V, S = RandomState> {
    d: Dict<K, V, S>;
    at: usize;
}

impl<K, V, S> Debug for Keys<K, V, S> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Keys") }
}

impl<K: Hash, V, S: BuildHasher> Iterator for Keys<K, V, S> {
    type Item = K;
    const fn next(ref self) -> K | none {
        unsafe {
            let i = self.d.next_full(self.at);
            if i >= self.d.h[0].n {
                return none;
            }
            self.at = i + 1;
            let s = self.d.h[0];
            s.keys[i]
        }
    }
}

/// What `d.values()` returns: the values, in insertion order. Changing
/// the dict while iterating gives unspecified (memory-safe) results.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct Values<K, V, S = RandomState> {
    d: Dict<K, V, S>;
    at: usize;
}

impl<K, V, S> Debug for Values<K, V, S> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Values") }
}

impl<K: Hash, V, S: BuildHasher> Iterator for Values<K, V, S> {
    type Item = V;
    const fn next(ref self) -> V | none {
        unsafe {
            let i = self.d.next_full(self.at);
            if i >= self.d.h[0].n {
                return none;
            }
            self.at = i + 1;
            let s = self.d.h[0];
            s.vals[i]
        }
    }
}

/// What `d.iter()` returns: `(key, value)` pairs, in insertion order.
/// Changing the dict while iterating gives unspecified (memory-safe)
/// results.
#[must_use("iterator is lazy and does nothing unless consumed: walk it with `for`, or call `{}.collect()`")]
pub struct DictIter<K, V, S = RandomState> {
    d: Dict<K, V, S>;
    at: usize;
}

impl<K, V, S> Debug for DictIter<K, V, S> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("DictIter") }
}

impl<K: Hash, V, S: BuildHasher> Iterator for DictIter<K, V, S> {
    type Item = (K, V);
    const fn next(ref self) -> (K, V) | none {
        unsafe {
            let i = self.d.next_full(self.at);
            if i >= self.d.h[0].n {
                return none;
            }
            self.at = i + 1;
            let s = self.d.h[0];
            (s.keys[i], s.vals[i])
        }
    }
}

impl<K: Hash, V, S: BuildHasher + Default> Default for Dict<K, V, S> {
    fn default() -> Dict<K, V, S> { Dict::with_hasher(S::default()) }
}

/// A new dict with every key and value cloned.
impl<K: Hash + Clone, V: Clone, S: BuildHasher> Clone for Dict<K, V, S> {
    const fn clone(self) -> Dict<K, V, S> {
        let r: Dict<K, V, S> = Dict::with_hasher(self.hasher());
        for (k, v) in self {
            r.insert(k.clone(), v.clone());
        }
        r
    }
}

/// The pairs of a list; a later pair's value wins.
impl<K: Hash, V, S: BuildHasher + Default> From<List<(K, V)>> for Dict<K, V, S> {
    const fn from(pairs: List<(K, V)>) -> Dict<K, V, S> {
        let d: Dict<K, V, S> = Dict::with_capacity_and_hasher(pairs.len(), S::default());
        for (k, v) in pairs {
            d.insert(k, v);
        }
        d
    }
}

/// `d += e`: merge `e` in place; its values win.
impl<K: Hash, V, S: BuildHasher> AddAssign<Dict<K, V, S>> for Dict<K, V, S> {
    const fn add_assign(ref self, rhs: Dict<K, V, S>) {
        for (k, v) in rhs {
            self.insert(k, v);
        }
    }
}

/// `for (k, v) in d`.
impl<K: Hash, V, S: BuildHasher> IntoIterator for Dict<K, V, S> {
    type IntoIter = DictIter<K, V, S>;
    type Item = (K, V);
    const fn into_iter(self) -> DictIter<K, V, S> {
        self.iter()
    }
}

/// `d[k]`; panics when the key is absent.
impl<K: Hash, V, S: BuildHasher> Index<K> for Dict<K, V, S> {
    type Output = V;
    #[track_caller]
    const fn index(self, k: K) -> V {
        unsafe {
            let at = self.find(k, self.hash_of(k));
            if at == ABSENT {
                return key_missing::<K, V>(k);
            }
            self.h[0].vals[at]
        }
    }
}

/// Panics: `key {k:?} not found`, `<K>` for a key without `Debug`. Out
/// of line, as `index_oob`.
#[track_caller]
const fn key_missing<K, V>(k: K) -> ! {
    panic(f"key {core::fmt::shown::<K>(k)} not found; use `d.get(k)` to get `{V::type_name()} | none`")
}

/// `d[k] = v` inserts or replaces.
impl<K: Hash, V, S: BuildHasher> IndexSet<K, V> for Dict<K, V, S> {
    const fn index_set(self, k: K, v: V) {
        self.insert(k, v);
    }
}

/// Same keys, equal values (insertion order does not matter).
impl<K: Hash, V: PartialEq, S: BuildHasher> PartialEq for Dict<K, V, S> {
    const fn eq(self, rhs: Dict<K, V, S>) -> bool {
        if self.len() != rhs.len() { return false; }
        for (k, v) in self {
            if !rhs.contains_key(k) { return false; }
            if rhs[k] != v { return false; }
        }
        true
    }
    fn ne(self, rhs: Dict<K, V, S>) -> bool { !self.eq(rhs) }
}

impl<K: Hash, V: Eq, S: BuildHasher> Eq for Dict<K, V, S> {}

/// Order-independent, as `==`: each entry hashed alone with the
/// process key (the same for every `S`), the results summed; then the
/// length and the sum.
impl<K: Hash, V: Hash, S: BuildHasher> Hash for Dict<K, V, S> {
    const fn hash<H: Hasher>(self, ref h: H) {
        let st = RandomState::new();
        let sum = 0u64;
        for (k, v) in self {
            let e = st.build_hasher();
            k.hash(ref e);
            v.hash(ref e);
            sum = sum.wrapping_add(e.finish());
        }
        h.write_length_prefix(self.len());
        h.write_u64(sum);
    }
}

/// `{k: v, ..}` with each key's and value's `Debug`, in iteration order.
impl<K: Hash + Debug, V: Debug, S: BuildHasher> Debug for Dict<K, V, S> {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str("{");
        let first = true;
        for (k, v) in self {
            try f.debug_pair(k, v, first);
            first = false;
        }
        try f.debug_close("}", first, false)
    }
}

/// `{k: v, ..}`.
#[literal("{" {expr ":" expr} % "," * "}")]
pub(pkg) const fn dict_literal<K: Hash, V>(pairs: ...(K, V)) -> Dict<K, V> {
    let d: Dict<K, V> = Dict::new();
    for (k, v) in pairs {
        d.insert(k, v);
    }
    return d;
}

/// A hand-off's copy: the same table; keys and values go
/// through `transfer` from the memo's queue (holes stay zero).
impl<K, V, S> Transfer for Dict<K, V, S> {
    const fn transfer_copy(self, m: Memo) -> Dict<K, V, S> {
        if buf_is_null(self.h) {
            return self;
        }
        if let got: GcBuf<DictHead<K, V, S>> = m.find(self.h) {
            return Dict { h: got };
        }
        unsafe {
            let s = self.h[0];
            let h: GcBuf<DictHead<K, V, S>> = buf_new(1);
            m.note(self.h, h);
            if s.cap == 0 {
                set_empty(h, s.state);
                return Dict { h };
            }
            let n = cap_add(s.cap, 1);
            let index = cap_add(s.cap, s.slots);
            h[0] = DictHead {
                len: s.len,
                n: s.n,
                cap: s.cap,
                slots: s.slots,
                keys: copy_buf(s.keys, 0, s.n, 1, n, m),
                vals: copy_buf(s.vals, 0, s.n, 1, n, m),
                meta: copy_buf(s.meta, 0, index, 1, index, m),
                state: s.state,
                stale: s.stale,
            };
            Dict { h }
        }
    }

    const fn transfer_keep(self, m: Memo) -> Dict<K, V, S> {
        if !buf_is_null(self.h) {
            m.keep(self.h);
        }
        self
    }

    const fn transfer_visit(self, m: Memo) -> Dict<K, V, S> {
        if !buf_is_null(self.h) && m.visit(self.h) {
            unsafe {
                let s = self.h[0];
                if s.cap != 0 {
                    m.later_visit(s.keys, s.n);
                    m.later_visit(s.vals, s.n);
                }
            }
        }
        self
    }
}
