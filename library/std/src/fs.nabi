/// `fs::rename` on the blocking lane: the task waits, its thread does not.
pub async fn rename_async<P: AsPath, Q: AsPath>(from: P, to: Q) throws (IoError) {
    let a = from.as_path();
    let b = to.as_path();
    try await off(|| try rename(a, b));
}
