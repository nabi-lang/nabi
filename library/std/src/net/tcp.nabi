// std::net::tcp: TCP: `TcpStream`, its split halves, and
// `TcpListener`.

use bare::mem::{GcBuf, buf_new, buf_same};
use core::convert::AsBytes;
use core::io::{AsyncClose, AsyncRead, AsyncWrite, Close, IoError, IoErrorKind, Read, Write};
use core::time::Duration;
use std::net::Incoming;
use std::net::addr::{SocketAddr, ToSocketAddrs, each_addr, words_of};
use std::net::socket::{Shutdown, Sock, Socket, flag, new_sock, sock_of, timed_out};
use std::net::tls;
use std::sys::{clear_bits, set_bits, take_handle, word_at};

/// A TCP connection. It has one owner (`let b = a` moves it); close it
/// with `try s.close()` or `using`.
pub struct TcpStream {
    pub(pkg) sock: Sock;
}

impl Debug for TcpStream {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TcpStream") }
}

/// A listening TCP socket.
pub struct TcpListener {
    pub(pkg) sock: Sock;
}

impl Debug for TcpListener {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("TcpListener") }
}

/// Start connecting `addr`: the socket and whether it is still pending.
fn connect_start(addr: SocketAddr) throws (IoError) -> (Sock, bool) {
    let s = try new_sock(addr.family(), 1, 0);
    let r = unsafe { nabi_net_connect(try s.live(), words_of(addr)) };
    if r < 0 {
        s.discard();
        throw IoError::from_os_code(-r, f"connect {addr}");
    }
    (s, r == 1)
}

fn connect_finish(s: Sock, addr: SocketAddr) throws (IoError) -> TcpStream {
    let e = unsafe { nabi_net_sock_error(try s.live()) };
    if e < 0 {
        s.discard();
        throw IoError::from_os_code(-e, f"connect {addr}");
    }
    TcpStream { sock: s }
}

fn connect_wait(addr: SocketAddr, limit: i64) throws (IoError) -> TcpStream {
    let (s, pending) = try connect_start(addr);
    if pending {
        let r = unsafe { nabi_net_wait(try s.live(), 1, limit) };
        if r <= 0 {
            s.discard();
            if r == 0 { throw timed_out(f"connect {addr}"); }
            throw IoError::from_os_code(-r, f"connect {addr}");
        }
    }
    try connect_finish(s, addr)
}

async fn connect_one_async(addr: SocketAddr) throws (IoError) -> TcpStream {
    let (s, pending) = try connect_start(addr);
    if pending {
        await task::writable(try s.live());
        // A spurious wake: wait until the connect resolved.
        while unsafe { nabi_net_wait(try s.live(), 1, 0i64) } == 0 {
            await task::writable(try s.live());
        }
    }
    try connect_finish(s, addr)
}

impl TcpStream {
    /// Connect to the first address of `addr` that accepts, blocking
    /// until the handshake is done.
    pub fn connect<A: ToSocketAddrs>(addr: A) throws (IoError) -> TcpStream {
        try each_addr(addr, |a| try connect_wait(a, -1i64))
    }

    /// Connect to `addr`, giving up after `dur`.
    pub fn connect_timeout(addr: SocketAddr, dur: Duration) throws (IoError) -> TcpStream {
        try connect_wait(addr, dur.as_ns())
    }

    /// `connect` that suspends the task during each handshake.
    pub async fn connect_async<A: ToSocketAddrs>(addr: A) throws (IoError) -> TcpStream {
        let last = IoError::new(IoErrorKind::InvalidInput, "no address to use");
        for a in try addr.to_socket_addrs() {
            let s = try await connect_one_async(a) catch e {
                last = e;
                continue;
            };
            return s;
        }
        throw last;
    }

    /// The remote end's address.
    pub fn peer_addr(self) throws (IoError) -> SocketAddr { try self.sock.addr(1) }
    /// This end's address.
    pub fn local_addr(self) throws (IoError) -> SocketAddr { try self.sock.addr(0) }

    /// Shut down the read half, the write half or both; the peer reads end
    /// of stream after `Write`.
    pub fn shutdown(self, how: Shutdown) throws (IoError) { try self.sock.shutdown(how); }

    /// As `shutdown`, which never waits.
    pub async fn shutdown_async(ref self, how: Shutdown) throws (IoError) { try self.sock.shutdown(how); }

    /// Turn Nagle's algorithm off (`TCP_NODELAY`) or back on.
    pub fn set_nodelay(self, nodelay: bool) throws (IoError) { try self.sock.setopt(1, flag(nodelay)); }
    /// `TCP_NODELAY`.
    pub fn nodelay(self) throws (IoError) -> bool { (try self.sock.getopt(1)) != 0i64 }

    /// Keepalive probes after `alive` idle (whole seconds); `none` = off.
    pub fn set_keepalive(self, alive: Duration | none) throws (IoError) {
        match alive {
            d: Duration => try self.sock.setopt(2, d.as_secs()),
            none => try self.sock.setopt(2, -1i64),
        }
    }

    /// Set `IP_TTL`.
    pub fn set_ttl(self, ttl: u32) throws (IoError) { try self.sock.setopt(11, ttl as i64); }
    /// `IP_TTL`.
    pub fn ttl(self) throws (IoError) -> u32 { (try self.sock.getopt(11)) as u32 }

    /// Make a blocking read throw `TimedOut` after `dur`; `none` waits forever.
    pub const fn set_read_timeout(self, dur: Duration | none) { self.sock.set_timeout(0, dur); }
    /// Make a blocking write throw `TimedOut` after `dur`; `none` waits forever.
    pub const fn set_write_timeout(self, dur: Duration | none) { self.sock.set_timeout(1, dur); }
    /// The read timeout; `none` when reads wait forever.
    pub const fn read_timeout(self) -> Duration | none { self.sock.timeout(0) }
    /// The write timeout; `none` when writes wait forever.
    pub const fn write_timeout(self) -> Duration | none { self.sock.timeout(1) }

    /// Make the blocking calls throw `WouldBlock` instead of waiting.
    pub const fn set_nonblocking(self, nb: bool) { self.sock.set_nonblocking(nb); }

    /// A second descriptor on the same socket (`dup`), with this one's
    /// timeouts and blocking mode.
    pub fn try_clone(self) throws (IoError) -> TcpStream {
        TcpStream { sock: try self.sock.try_clone() }
    }

    /// Split into a read half and a write half that two tasks or
    /// threads can use at once. Each half owns its direction and must
    /// be closed; `ReadHalf::unsplit` joins them again.
    pub fn split(self) -> (ReadHalf<TcpStream>, WriteHalf<TcpStream>) {
        let d = Duplex::of(self.sock.moved(), none);
        // Already moved: closes nothing, and marks `self` taken.
        try self.close() catch _ {};
        (ReadHalf { d }, WriteHalf { d })
    }

    /// Close now, throwing the OS's error; later calls fail with
    /// `InvalidInput`.
    pub fn close(self) throws (IoError) { try self.sock.close(); }

    /// The socket under a TLS connection, for its halves.
    pub(pkg) const fn raw_sock(self) -> Sock { self.sock }
}

impl From<Socket> for TcpStream {
    /// A connected stream socket.
    fn from(s: Socket) -> TcpStream {
        let sock = s.sock.moved();
        // Already moved: closes nothing, and marks `s` taken.
        try s.close() catch _ {};
        TcpStream { sock }
    }
}

impl From<TcpStream> for Socket {
    fn from(s: TcpStream) -> Socket {
        let sock = s.sock.moved();
        // Already moved: closes nothing, and marks `s` taken.
        try s.close() catch _ {};
        Socket { sock }
    }
}

impl Read for TcpStream {
    fn read(ref self, buf: SliceMut<u8>) throws (IoError) -> usize { try self.sock.read(buf) }
    #[internal]
    const fn copy_handle(self) -> i32 { self.sock.copy_fd() }
    fn read_to_end(ref self) throws (IoError) -> List<u8> { try self.sock.read_to_end() }
}

impl Write for TcpStream {
    fn write<B: AsBytes>(ref self, buf: B) throws (IoError) -> usize { try self.sock.write(buf.byte_slice()) }
    /// Nothing to flush: writes go straight to the socket.
    const fn flush(ref self) throws (IoError) {}
    #[internal]
    const fn copy_handle(self) -> i32 { self.sock.copy_fd() }
    fn write_all<B: AsBytes>(ref self, buf: B) throws (IoError) { try self.sock.write_all(buf.byte_slice()); }
}

/// Cancel-safe: a cancelled read or write moved no bytes.
impl AsyncRead for TcpStream {
    async fn read_async(ref self, buf: SliceMut<u8>) throws (IoError) -> usize { try await self.sock.read_async(buf) }
    async fn read_to_end_async(ref self) throws (IoError) -> List<u8> { try await self.sock.read_to_end_async() }
}

impl AsyncWrite for TcpStream {
    async fn write_async<B: AsBytes>(ref self, buf: B) throws (IoError) -> usize {
        try await self.sock.write_async(buf.byte_slice())
    }
    async fn flush_async(ref self) throws (IoError) {}
    async fn write_all_async<B: AsBytes>(ref self, buf: B) throws (IoError) {
        try await self.sock.write_all_async(buf.byte_slice());
    }
}

impl Close for TcpStream {
    fn close(self) throws (IoError) { try self.sock.close(); }
}

impl AsyncClose for TcpStream {
    async fn close_async(self) throws (IoError) { try await self.sock.close_async(); }
}

impl Drop for TcpStream {
    fn drop(ref self) { self.sock.discard(); }
}

const HALF_READ: i32 = 1;

const HALF_WRITE: i32 = 2;

/// Writing was shut down (`shutdown(Write | Both)`).
const WRITES_SHUT: i32 = 4;

/// What both halves of a split connection name: the socket, the TLS
/// state of a TLS connection, and which halves are open.
pub(pkg) struct Duplex {
    sock: Sock;
    tls: tls::Shared | none;
    /// `HALF_READ | HALF_WRITE` while both are open.
    open: GcBuf<i32>;
}

// The socket cell and `open` change only atomically, and the TLS state
// only under its locks; a frame never hides in one.
unsafe impl Send for Duplex {}

unsafe impl Sync for Duplex {}

impl Duplex {
    pub(pkg) const fn of(sock: Sock, tls: tls::Shared | none) -> Duplex {
        unsafe {
            let open: GcBuf<i32> = buf_new(1);
            open[0] = HALF_READ | HALF_WRITE;
            Duplex { sock, tls, open }
        }
    }

    fn read(self, buf: SliceMut<u8>) throws (IoError) -> usize {
        if let s: tls::Shared = self.tls { return try s.read(buf); }
        try self.sock.read(buf)
    }

    async fn read_async(self, buf: SliceMut<u8>) throws (IoError) -> usize {
        if let s: tls::Shared = self.tls { return try await s.read_async(buf); }
        try await self.sock.read_async(buf)
    }

    fn read_to_end(self) throws (IoError) -> List<u8> {
        if let s: tls::Shared = self.tls { return try s.read_to_end(); }
        try self.sock.read_to_end()
    }

    async fn read_to_end_async(self) throws (IoError) -> List<u8> {
        if let s: tls::Shared = self.tls { return try await s.read_to_end_async(); }
        try await self.sock.read_to_end_async()
    }

    fn write(self, data: Slice<u8>) throws (IoError) -> usize {
        if let s: tls::Shared = self.tls {
            try s.write(data);
            return data.len();
        }
        try self.sock.write(data)
    }

    async fn write_async(self, data: Slice<u8>) throws (IoError) -> usize {
        if let s: tls::Shared = self.tls {
            try await s.write_async(data);
            return data.len();
        }
        try await self.sock.write_async(data)
    }

    fn write_all(self, data: Slice<u8>) throws (IoError) {
        if let s: tls::Shared = self.tls {
            try s.write(data);
            return;
        }
        try self.sock.write_all(data);
    }

    async fn write_all_async(self, data: Slice<u8>) throws (IoError) {
        if let s: tls::Shared = self.tls {
            try await s.write_async(data);
            return;
        }
        try await self.sock.write_all_async(data);
    }

    /// Whether neither half is closed yet.
    fn both_open(self) -> bool { (word_at(self.open, 0) & (HALF_READ | HALF_WRITE)) == (HALF_READ | HALF_WRITE) }

    /// The peer reads end of stream (TLS: close_notify first); reading
    /// goes on.
    fn end_writes(self) throws (IoError) {
        if (word_at(self.open, 0) & WRITES_SHUT) != 0 { return; }
        try self.shutdown(Shutdown::Write);
    }

    async fn end_writes_async(self) throws (IoError) {
        if (word_at(self.open, 0) & WRITES_SHUT) != 0 { return; }
        try await self.shutdown_async(Shutdown::Write);
    }

    /// `shutdown(2)` of the socket both halves name; a task or thread
    /// blocked in the shut direction wakes. Writing shut down sends
    /// close_notify first on TLS.
    fn shutdown(self, how: Shutdown) throws (IoError) {
        let first: IoError | none = none;
        if how != Shutdown::Read {
            if let s: tls::Shared = self.tls { try s.close_notify() catch e { first = e; }; }
            _ = set_bits(self.open, 0, WRITES_SHUT);
        }
        try self.sock.shutdown(how) catch e { first = first ?? e; };
        if let e: IoError = first { throw e; }
    }

    async fn shutdown_async(self, how: Shutdown) throws (IoError) {
        let first: IoError | none = none;
        if how != Shutdown::Read {
            if let s: tls::Shared = self.tls { try await s.close_notify_async() catch e { first = e; }; }
            _ = set_bits(self.open, 0, WRITES_SHUT);
        }
        try self.sock.shutdown(how) catch e { first = first ?? e; };
        if let e: IoError = first { throw e; }
    }

    fn close_all(self) throws (IoError) {
        if let s: tls::Shared = self.tls {
            try s.close();
            return;
        }
        try self.sock.close();
    }

    async fn close_all_async(self) throws (IoError) {
        if let s: tls::Shared = self.tls {
            try await s.close_async();
            return;
        }
        try await self.sock.close_async();
    }

    /// Mark half `bit` closed: `true` when it was the last open one,
    /// and the caller closes the connection. Each half finishes its own
    /// work before this, so the last one closes after both are done.
    fn leave(self, bit: i32) -> bool {
        let was = clear_bits(self.open, 0, bit);
        (was & bit) != 0 && (was & ((HALF_READ | HALF_WRITE) - bit)) == 0
    }

    /// Close half `bit`. The write half ends the stream for the peer
    /// (`shutdown(Write)`) when the read half is still open; the read
    /// half alone sends nothing. The last to close closes the socket.
    fn close_half(self, bit: i32) throws (IoError) {
        if (word_at(self.open, 0) & bit) == 0 { return; }
        let first: IoError | none = none;
        if bit == HALF_WRITE && self.both_open() {
            try self.end_writes() catch e { first = e; };
        }
        if self.leave(bit) {
            try self.close_all() catch e { first = first ?? e; };
        }
        if let e: IoError = first { throw e; }
    }

    async fn close_half_async(self, bit: i32) throws (IoError) {
        if (word_at(self.open, 0) & bit) == 0 { return; }
        let first: IoError | none = none;
        if bit == HALF_WRITE && self.both_open() {
            try await self.end_writes_async() catch e { first = e; };
        }
        if self.leave(bit) {
            try await self.close_all_async() catch e { first = first ?? e; };
        }
        if let e: IoError = first { throw e; }
    }

    pub(pkg) const fn sock(self) -> Sock { self.sock }
    pub(pkg) const fn shared(self) -> tls::Shared | none { self.tls }
}

/// The read half of a split connection (`TcpStream::split`,
/// `UnixStream::split`, `tls::Client::split`, `tls::Server::split`):
/// it owns the reading direction. Send it to another task or thread
/// while the `WriteHalf` writes; close it, or rejoin the two with
/// `unsplit`. The socket closes when both halves are closed.
pub struct ReadHalf<T> {
    pub(pkg) d: Duplex;
}

/// The write half of a split connection: it owns the writing
/// direction. Closing it ends the stream for the peer (`shutdown(Write)`,
/// after close_notify on TLS) while the read half reads on.
pub struct WriteHalf<T> {
    pub(pkg) d: Duplex;
}

// Each half owns its direction alone; what they share is `Duplex`.
unsafe impl<T> Send for ReadHalf<T> {}

unsafe impl<T> Send for WriteHalf<T> {}

impl<T> Debug for ReadHalf<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("ReadHalf") }
}

impl<T> Debug for WriteHalf<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("WriteHalf") }
}

impl<T> ReadHalf<T> {
    /// Close the read half; the socket closes once the write half is
    /// closed too. Throws the OS's error of that close.
    pub fn close(self) throws (IoError) { try self.d.close_half(HALF_READ); }

    /// Shut down reading, writing or both of the socket the halves
    /// share (TLS: close_notify first for writing). `Both` wakes a
    /// write blocked on the other half too.
    pub fn shutdown(self, how: Shutdown) throws (IoError) { try self.d.shutdown(how); }

    /// `shutdown`, awaiting close_notify on TLS instead of blocking.
    pub async fn shutdown_async(ref self, how: Shutdown) throws (IoError) { try await self.d.shutdown_async(how); }
}

impl<T> WriteHalf<T> {
    /// End the stream for the peer, or close the socket when the read
    /// half is closed already. Throws the OS's error.
    pub fn close(self) throws (IoError) { try self.d.close_half(HALF_WRITE); }

    /// Shut down reading, writing or both of the socket the halves
    /// share (TLS: close_notify first for writing). `Both` wakes a read
    /// blocked on the other half, as `shutdown(SHUT_RDWR)` does.
    pub fn shutdown(self, how: Shutdown) throws (IoError) { try self.d.shutdown(how); }

    /// `shutdown`, awaiting close_notify on TLS instead of blocking.
    pub async fn shutdown_async(ref self, how: Shutdown) throws (IoError) { try await self.d.shutdown_async(how); }
}

impl<T> Read for ReadHalf<T> {
    fn read(ref self, buf: SliceMut<u8>) throws (IoError) -> usize { try self.d.read(buf) }
    fn read_to_end(ref self) throws (IoError) -> List<u8> { try self.d.read_to_end() }
}

impl<T> AsyncRead for ReadHalf<T> {
    async fn read_async(ref self, buf: SliceMut<u8>) throws (IoError) -> usize { try await self.d.read_async(buf) }
    async fn read_to_end_async(ref self) throws (IoError) -> List<u8> { try await self.d.read_to_end_async() }
}

impl<T> Write for WriteHalf<T> {
    fn write<B: AsBytes>(ref self, buf: B) throws (IoError) -> usize { try self.d.write(buf.byte_slice()) }
    /// Nothing to flush: writes go straight to the socket.
    const fn flush(ref self) throws (IoError) {}
    fn write_all<B: AsBytes>(ref self, buf: B) throws (IoError) { try self.d.write_all(buf.byte_slice()); }
}

impl<T> AsyncWrite for WriteHalf<T> {
    async fn write_async<B: AsBytes>(ref self, buf: B) throws (IoError) -> usize {
        try await self.d.write_async(buf.byte_slice())
    }
    async fn flush_async(ref self) throws (IoError) {}
    async fn write_all_async<B: AsBytes>(ref self, buf: B) throws (IoError) {
        try await self.d.write_all_async(buf.byte_slice());
    }
}

impl<T> Close for ReadHalf<T> {
    fn close(self) throws (IoError) { try self.d.close_half(HALF_READ); }
}

impl<T> Close for WriteHalf<T> {
    fn close(self) throws (IoError) { try self.d.close_half(HALF_WRITE); }
}

impl<T> AsyncClose for ReadHalf<T> {
    async fn close_async(self) throws (IoError) { try await self.d.close_half_async(HALF_READ); }
}

impl<T> AsyncClose for WriteHalf<T> {
    async fn close_async(self) throws (IoError) { try await self.d.close_half_async(HALF_WRITE); }
}

impl<T> Drop for ReadHalf<T> {
    fn drop(ref self) { try self.d.close_half(HALF_READ) catch _ {}; }
}

impl<T> Drop for WriteHalf<T> {
    fn drop(ref self) { try self.d.close_half(HALF_WRITE) catch _ {}; }
}

/// The parts of two halves of one connection, given back unclosed; the
/// halves are spent.
#[track_caller]
pub(pkg) fn rejoin<T>(r: ReadHalf<T>, w: WriteHalf<T>) -> Duplex {
    if !buf_same(r.d.open, w.d.open) {
        panic("unsplit: this WriteHalf is from another connection; pass the WriteHalf that `split` gave with this ReadHalf");
    }
    take_handle(r.d.open, 0, 0);
    // Rejoined: these close nothing, and mark the halves taken.
    try r.close() catch _ {};
    try w.close() catch _ {};
    r.d
}

impl ReadHalf<TcpStream> {
    /// The connection again, from this half and the `WriteHalf` that
    /// `split` gave with it. Panics on a write half of another
    /// connection.
    #[track_caller]
    pub fn unsplit(self, w: WriteHalf<TcpStream>) -> TcpStream {
        TcpStream { sock: rejoin(self, w).sock }
    }
}

/// A listening TCP socket on `addr`: `SO_REUSEADDR` (not on Windows,
/// where it would let another socket take the port), backlog 128.
fn listen_on(addr: SocketAddr) throws (IoError) -> TcpListener {
    let s = try new_sock(addr.family(), 1, 0);
    if !cfg!(target_os = "windows") {
        try s.setopt(7, 1i64) catch e {
            s.discard();
            throw e;
        };
    }
    try s.bind_listen(addr, 128);
    TcpListener { sock: s }
}

impl TcpListener {
    /// Bind and listen on the first address of `addr` that works
    /// (`SO_REUSEADDR` off Windows, backlog 128). Port 0 picks one: see
    /// `local_addr`.
    pub fn bind<A: ToSocketAddrs>(addr: A) throws (IoError) -> TcpListener {
        try each_addr(addr, |a| try listen_on(a))
    }

    /// The listening sockets the host handed this program, in order:
    /// WASI's pre-opened sockets (wasmtime `-S tcplisten=ADDR`, preview 1:
    /// `wasm32-wasip1-threads`), systemd socket activation (`LISTEN_FDS`) on
    /// Unix; none on Windows. Where a program cannot bind sockets
    /// itself, these are how it serves.
    pub fn inherited() -> List<TcpListener> {
        unsafe {
            let fds: GcBuf<i32> = buf_new(64);
            let n = nabi_net_listeners(fds, 64);
            let out: List<TcpListener> = List::new();
            for i in 0..n as usize {
                out.push(TcpListener { sock: sock_of(fds[i]) });
            }
            out
        }
    }

    /// The next connection and its peer, blocking until one arrives.
    pub fn accept(self) throws (IoError) -> (TcpStream, SocketAddr) {
        let (s, a) = try self.sock.accept();
        (TcpStream { sock: s }, a)
    }

    /// `accept` that suspends the task until a connection arrives.
    pub async fn accept_async(ref self) throws (IoError) -> (TcpStream, SocketAddr) {
        let (s, a) = try await self.sock.accept_async();
        (TcpStream { sock: s }, a)
    }

    /// The bound address (the port picked when bound to port 0).
    pub fn local_addr(self) throws (IoError) -> SocketAddr { try self.sock.addr(0) }

    /// Set `IP_TTL`.
    pub fn set_ttl(self, ttl: u32) throws (IoError) { try self.sock.setopt(11, ttl as i64); }
    /// `IP_TTL`.
    pub fn ttl(self) throws (IoError) -> u32 { (try self.sock.getopt(11)) as u32 }

    /// A second descriptor on the same socket (`dup`).
    pub fn try_clone(self) throws (IoError) -> TcpListener {
        TcpListener { sock: try self.sock.try_clone() }
    }

    /// Make the blocking calls throw `WouldBlock` instead of waiting.
    pub const fn set_nonblocking(self, nb: bool) { self.sock.set_nonblocking(nb); }

    /// `try for s in l.incoming() { .. }`: connections forever; a failed
    /// `accept` ends the loop with its error. A view of the listener: it
    /// stays in the listener's scope, and its owner still closes it.
    pub const fn incoming(ref self) -> Incoming {
        let l = core::marker::view(self);
        Incoming { l: l }
    }

    /// `incoming` owning the listener: it may leave the scope or move to
    /// a task, and closes the listener with itself.
    pub const fn into_incoming(self) -> io::Owned<Incoming, TcpListener> {
        let v = self.incoming();
        io::Owned::of(v, self)
    }

    /// Close now, throwing the OS's error.
    pub fn close(self) throws (IoError) { try self.sock.close(); }
}

impl From<Socket> for TcpListener {
    /// A bound, listening stream socket.
    fn from(s: Socket) -> TcpListener {
        let sock = s.sock.moved();
        // Already moved: closes nothing, and marks `s` taken.
        try s.close() catch _ {};
        TcpListener { sock }
    }
}

impl From<TcpListener> for Socket {
    fn from(s: TcpListener) -> Socket {
        let sock = s.sock.moved();
        // Already moved: closes nothing, and marks `s` taken.
        try s.close() catch _ {};
        Socket { sock }
    }
}

impl Close for TcpListener {
    /// Stop listening now; later calls fail with `InvalidInput`.
    fn close(self) throws (IoError) { try self.sock.close(); }
}

impl AsyncClose for TcpListener {
    async fn close_async(self) throws (IoError) { try await self.sock.close_async(); }
}

impl Drop for TcpListener {
    fn drop(ref self) { self.sock.discard(); }
}
