// expect-exit: 0
// expect-stdout:
// 1 4
// 1 2 4
// 1 3 4
// any
// one
// 5 x
// big 9

// `..` and `..name` in a tuple pattern work in `match`, `if let` and
// guards, as in `let` (spec 3.11); an empty rest is `()`.
fn main() {
    let t = (1, 2, 3, 4);
    match t {
        (a, .., z) => println(f"{a} {z}"),
    }
    match t {
        (h, ..rest) if rest.0 == 2 => println(f"{h} {rest.0} {rest.2}"),
        _ => println("no"),
    }
    if let (..init, last) = t {
        println(f"{init.0} {init.2} {last}");
    }
    match t {
        (..) => println("any"),
    }
    match t {
        (1, ..) => println("one"),
        (_, ..) => println("other"),
    }
    let p = (5, "x");
    if let (n, ..mid, s) = p {
        let _unit: () = mid;
        println(f"{n} {s}");
    }
    let q: (i32, str) | none = (9, "big");
    match q {
        (n, ..rest) => println(f"{rest.0} {n}"),
        none => println("none"),
    }
}
