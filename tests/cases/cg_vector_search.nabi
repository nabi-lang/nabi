// 0,1,5,6,7,8,9,12,13,19,24,30,31,36,38,41,52,57,59,61,62,63,71,72,75,77,81,82,96,97,99,105,110,111,117,125,129,130,131,138,142,152,154,156,157,160,161,162,166,167,172,179,180,184,191,192,196,199,204,208,209,212,216,226,227,228,235,236,237,238,245,247,250,251,254,257,266,268,271,276,279,283,284,285,286,300
// 63 1000 10
// 35 -1
// 6807728563541777655
// 3017219016151523820
// 7234765990149928434
// 10636515868764704857
// 10810018840320553038
// 15755389022563585077
// 2713042887628674464
// 14695981039346656037
// 37 263 147 765857

fn find(xs: List<u8>, c: u8, a: usize) -> usize {
    for i in a..xs.len() {
        if xs[i] == c {
            return i;
        }
    }
    xs.len()
}

fn find_space(xs: List<u8>, a: usize) -> usize {
    let n = xs.len();
    for i in a..n {
        let b = xs[i];
        if b == 32u8 || b == 10u8 || b == 9u8 {
            return i;
        }
    }
    n
}

fn find_word(xs: List<u8>, a: usize) -> usize {
    for i in a..xs.len() {
        let b = xs[i];
        if b >= 97u8 && b <= 122u8 {
            return i;
        }
    }
    1000
}

fn first_neg(xs: List<f64>) -> i64 {
    for i in 0..xs.len() {
        if xs[i] < 0.0 {
            return i as i64;
        }
    }
    -1
}

fn count(xs: List<u8>, c: u8, a: usize, n: usize) -> i64 {
    let k: i64 = 0;
    for i in a..n {
        if xs[i] == c {
            k += 1;
        }
    }
    k
}

fn count_cast(xs: List<u8>, c: u8, n: usize) -> u32 {
    let k: u32 = 0;
    for i in 0..n {
        k += (xs[i] != c) as u32;
    }
    k
}

fn count_range(xs: List<i16>, n: usize) -> usize {
    let k: usize = 0;
    for i in 0..n {
        if xs[i] > 3 && xs[i] < 900 || xs[i] == -7 {
            k += 1;
        }
    }
    k
}

fn sum_pos(xs: List<i32>, n: usize) -> i32 {
    let s: i32 = 0;
    for i in 0..n {
        if xs[i] > 0 {
            s += xs[i];
        }
    }
    s
}

fn wsum_odd(xs: List<u16>, n: usize) -> u16 {
    let s: u16 = 1;
    for i in 0..n {
        let x = xs[i];
        if x & 1u16 == 1u16 {
            s = s.wrapping_add(x);
        } else {
            s = s.wrapping_sub(3u16);
        }
    }
    s
}

fn and_mask(xs: List<u32>, n: usize) -> u32 {
    let m: u32 = 4294967295u32;
    for i in 0..n {
        if xs[i] != 0u32 {
            m &= xs[i];
        }
    }
    m
}

fn pick(xs: List<i32>, n: usize) -> i32 {
    let s: i32 = 0;
    for i in 0..n {
        let t = if xs[i] > 5 { xs[i] - 5 } else { 0 };
        s = s.wrapping_add(t);
    }
    s
}

fn lcg(n: usize, seed: u64) -> List<u64> {
    let out: List<u64> = [];
    let x = seed;
    for _ in 0..n {
        x = x.wrapping_mul(6364136223846793005u64).wrapping_add(1442695040888963407u64);
        out.push(x >> 11);
    }
    out
}

fn h(acc: u64, x: u64) -> u64 {
    (acc ^ x).wrapping_mul(1099511628211u64)
}

fn main() -> i32 {
    // Every position of the one match, every length.
    let line: List<str> = [];
    for n in 0..36 {
        let xs: List<u8> = List::filled(n, 1u8);
        let hits: List<str> = [];
        for p in 0..n {
            xs[p] = 7u8;
            hits.push(f"{find(xs, 7u8, 0)}{find(xs, 7u8, p / 2)}");
            xs[p] = 1u8;
        }
        line.push(f"{find(xs, 7u8, 0)}:{hits.join(",")}");
    }
    println(line.join(" "));
    let r = lcg(300, 7);
    let text: List<u8> = r.iter().map(|x| [97u8, 98u8, 32u8, 10u8, 9u8, 65u8, 99u8, 120u8, 122u8, 46u8][(x % 10) as usize]).collect();
    let spaces: List<str> = [];
    let at = 0;
    while at < text.len() {
        let e = find_space(text, at);
        spaces.push(f"{e}");
        at = e + 1;
    }
    println(spaces.join(","));
    let caps: List<u8> = List::filled(100, 65u8);
    caps[63] = 98u8;
    println(f"{find_word(caps, 0)} {find_word(caps, 64)} {find_word(text, 5)}");
    let f: List<f64> = List::filled(40, 1.0);
    let nan = 0.0 / 0.0;
    f[3] = nan;
    f[20] = -nan;
    f[31] = -0.0;
    f[35] = -1.0;
    println(f"{first_neg(f)} {first_neg(List::filled(0, 1.0))}");
    let hs: List<u64> = List::filled(8, 14695981039346656037u64);
    let i16s: List<i16> = r.iter().map(|x| (x % 2000) as i16 - 1000).collect();
    let i32s: List<i32> = r.iter().map(|x| (x % 20001) as i32 - 10000).collect();
    let u16s: List<u16> = r.iter().map(|x| (x % 65536) as u16).collect();
    let u32s: List<u32> = r.iter().map(|x| if x % 4 == 0 { 0u32 } else { (x | 1u64 << 40) as u32 | 3u32 << 30 }).collect();
    for n in 0..70 {
        for a in 0..3 {
            if a <= n {
                hs[0] = h(hs[0], count(text, 32u8, a, n) as u64);
            }
        }
        hs[1] = h(hs[1], count_cast(text, 97u8, n) as u64);
        hs[2] = h(hs[2], count_range(i16s, n) as u64);
        hs[3] = h(hs[3], sum_pos(i32s, n) as u64);
        hs[4] = h(hs[4], wsum_odd(u16s, n) as u64);
        hs[5] = h(hs[5], and_mask(u32s, n) as u64);
        hs[6] = h(hs[6], pick(i32s, n) as u64);
    }
    for x in hs {
        println(f"{x}");
    }
    println(f"{count(text, 97u8, 0, 300)} {count_cast(text, 97u8, 300)} {count_range(i16s, 300)} {sum_pos(i32s, 300)}");
    return 0;
}
