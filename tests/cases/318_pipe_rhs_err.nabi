// expect-error: the right side of `|>` is not a function or a call
// expect-error: help: `|>` binds loosest, so its right side is all of `.. + ..`; write `(x |> f) + ..`
// expect-error: help: pass a function or a call (`x |> f`, `x |> f(a)` for `f(x, a)`); for another expression, a closure in parentheses: `x |> (|v| v + 1)`
// expect-error: `|>` is the language's pipe, not an operator token

// The right side of `|>` is a function or a call; `|>` is not registrable.
fn inc(x: i64) -> i64 { x + 1 }

trait Pipe {
    #[infix("|>", like = "|")]
    fn pipe(self, f: fn(i64) -> i64) -> i64;
}

fn main() {
    let a = 1 |> inc + 1;
    let b = 1 |> 2;
}
