// expect-exit: 101
// expect-stderr: thread 'main' panicked at *:
// expect-stderr: cannot grow a list while it is pinned (C may hold its address): call `xs.reserve(n)` before `gc::pin(xs)`
// expect-stdout:
// 2 5 8

// A pinned list's buffer is what C holds: it cannot be replaced by a
// grown one while the pin lasts. `reserve` before pinning leaves room.
// `Slice` and `StrBuf` pin too.
use bare::gc::pin;

extern "C" {
    fn strlen(p: bare::ptr::Ptr<u8>) -> c_size_t;
}

fn main() {
    let xs: List<i64> = [1, 2, 3, 4];
    let s = pin(xs[1:3]);
    let b = StrBuf::with_capacity(16);
    b.push_str("hello");
    b.push('\u{0}');
    let pb = pin(b);
    let ys: List<i64> = [1];
    ys.reserve(7);
    let py = pin(ys);
    for i in 0..7 {
        ys.push(i);
    }
    println(f"{unsafe { s.as_data_ptr().read() }} {unsafe { strlen(pb.as_bytes_ptr()) }} {py.obj().len()}");
    ys.push(9);
}
