// Vectorized loops (`-O2`): maps, reductions and tests over list
// elements of every width, for every length 0..33 and start 0..3, give
// what the scalar loop gives.
// expect-exit: 0
// expect-stdout:
// 3716002833079929869
// 14958566897458453908
// 791445407378685614
// 3825189659711493108
// 16592644189948569894
// 8891322290267175402
// 3458542303790259498
// 13652970917915776057
// 15944160728440935722
// 11785283703969838941
// 5027326419605788035
// 10442430235632338089
// 2394674982818510128
// 17009244325784978080
// 1591388504200803357
// 12213497247152225781

fn h(acc: u64, x: u64) -> u64 {
    (acc ^ x).wrapping_mul(1099511628211u64)
}

fn sum_i64(xs: List<i64>, a: usize, n: usize) -> i64 {
    let s: i64 = 0;
    for i in a..n {
        s += xs[i];
    }
    s
}

fn wsum_i8(xs: List<i8>, a: usize, n: usize) -> i8 {
    let s: i8 = 0;
    for i in a..n {
        s = s.wrapping_add(xs[i]);
    }
    s
}

fn wsub_i16(xs: List<i16>, a: usize, n: usize) -> i16 {
    let s: i16 = 7;
    for i in a..n {
        s = s.wrapping_sub(xs[i]);
    }
    s
}

fn sum_u32(xs: List<u32>, a: usize, n: usize) -> u32 {
    let s: u32 = 0;
    for i in a..n {
        s += xs[i];
    }
    s
}

fn sub_i32(xs: List<i32>, a: usize, n: usize) -> i32 {
    let s: i32 = 1000;
    for i in a..n {
        s -= xs[i];
    }
    s
}

fn sub_u64(xs: List<u64>, a: usize, n: usize) -> u64 {
    let s: u64 = 1000000;
    for i in a..n {
        s -= xs[i];
    }
    s
}

fn bits_u16(xs: List<u16>, a: usize, n: usize) -> u64 {
    let x: u16 = 0;
    let o: u16 = 0;
    let d: u16 = 65535;
    for i in a..n {
        x ^= xs[i];
        o |= xs[i];
        d &= xs[i];
    }
    (x as u64) << 32 | (o as u64) << 16 | d as u64
}

fn map_i64(ys: List<i64>, xs: List<i64>, a: usize, n: usize) {
    for i in a..n {
        ys[i] = xs[i] * 3 - 1;
    }
}

fn map_u8(ys: List<u8>, xs: List<u8>, a: usize, n: usize) {
    for i in a..n {
        ys[i] = (xs[i] ^ 0x5au8).wrapping_add(xs[i] >> 3);
    }
}

fn map_i16(ys: List<i16>, xs: List<i16>, a: usize, n: usize) {
    for i in a..n {
        ys[i] = xs[i].wrapping_mul(5) >> 1;
    }
}

fn axpy(k: f64, ys: List<f64>, xs: List<f64>, a: usize, n: usize) {
    for i in a..n {
        ys[i] = k * xs[i] + ys[i];
    }
}

fn map_f32(ys: List<f32>, xs: List<f32>, a: usize, n: usize) {
    for i in a..n {
        ys[i] = (xs[i] * xs[i] + 1.5f32).sqrt() / 2.0f32 - xs[i];
    }
}

fn neg_f64(ys: List<f64>, xs: List<f64>, a: usize, n: usize) {
    for i in a..n {
        ys[i] = -xs[i];
    }
}

fn less_f64(bs: List<bool>, xs: List<f64>, ys: List<f64>, a: usize, n: usize) {
    for i in a..n {
        bs[i] = xs[i] < ys[i];
    }
}

fn cmp_u8(bs: List<bool>, xs: List<u8>, a: usize, n: usize) {
    for i in a..n {
        bs[i] = xs[i] > 200u8 || xs[i] == 7u8 || !(xs[i] >= 100u8);
    }
}

fn cmp_i32(bs: List<i32>, xs: List<i32>, a: usize, n: usize) {
    for i in a..n {
        bs[i] = (xs[i] < -5) as i32 + (xs[i] <= 3) as i32 + (xs[i] != 0) as i32;
    }
}

fn not_bool(bs: List<bool>, cs: List<bool>, a: usize, n: usize) {
    for i in a..n {
        bs[i] = !cs[i] && bs[i] || cs[i] != bs[i];
    }
}

fn diff(ys: List<i64>, xs: List<i64>, a: usize, n: usize) {
    for i in a..n {
        ys[i] = xs[i + 1] - xs[i];
    }
}

fn lcg(n: usize, seed: u64) -> List<u64> {
    let out: List<u64> = [];
    let x = seed;
    for _ in 0..n {
        x = x.wrapping_mul(6364136223846793005u64).wrapping_add(1442695040888963407u64);
        out.push(x >> 11);
    }
    out
}

fn main() -> i32 {
    let r = lcg(40, 1);
    let i64s: List<i64> = r.iter().map(|x| (x % 2001) as i64 - 1000).collect();
    let i8s: List<i8> = r.iter().map(|x| (x % 256) as i8).collect();
    let i16s: List<i16> = r.iter().map(|x| (x % 65536) as i16).collect();
    let u32s: List<u32> = r.iter().map(|x| (x % 100000) as u32).collect();
    let i32s: List<i32> = r.iter().map(|x| (x % 41) as i32 - 20).collect();
    let u64s: List<u64> = r.iter().map(|x| x % 1000).collect();
    let u16s: List<u16> = r.iter().map(|x| (x % 65536) as u16).collect();
    let u8s: List<u8> = r.iter().map(|x| (x % 256) as u8).collect();
    let f64s: List<f64> = r.iter().map(|x| (x % 1000) as f64 / 7.0 - 50.0).collect();
    let f32s: List<f32> = r.iter().map(|x| (x % 1000) as f32 / 9.0f32 - 40.0f32).collect();
    f64s[5] = 0.0 / 0.0;
    f64s[17] = -(0.0 / 0.0);
    let hs: List<u64> = List::filled(16, 14695981039346656037u64);
    for a in 0..4 {
        for n in a..34 {
            hs[0] = h(hs[0], sum_i64(i64s, a, n) as u64);
            hs[1] = h(hs[1], wsum_i8(i8s, a, n) as u64);
            hs[2] = h(hs[2], wsub_i16(i16s, a, n) as u64);
            hs[3] = h(hs[3], sum_u32(u32s, a, n) as u64);
            hs[4] = h(hs[4], sub_i32(i32s, a, n) as u64);
            hs[5] = h(hs[5], sub_u64(u64s, a, n));
            hs[6] = h(hs[6], bits_u16(u16s, a, n));
            let y: List<i64> = List::filled(40, 9);
            map_i64(y, i64s, a, n);
            for v in y { hs[7] = h(hs[7], v as u64); }
            let y8: List<u8> = List::filled(40, 3u8);
            map_u8(y8, u8s, a, n);
            for v in y8 { hs[8] = h(hs[8], v as u64); }
            let y16: List<i16> = List::filled(40, 3i16);
            map_i16(y16, i16s, a, n);
            for v in y16 { hs[9] = h(hs[9], v as u64); }
            let yf: List<f64> = List::filled(40, 0.25);
            axpy(1.5, yf, f64s, a, n);
            neg_f64(yf, yf, a, n / 2);
            for v in yf { hs[10] = h(hs[10], v.to_bits()); }
            let y32: List<f32> = List::filled(40, 1.0f32);
            map_f32(y32, f32s, a, n);
            for v in y32 { hs[11] = h(hs[11], v.to_bits() as u64); }
            let bs: List<bool> = List::filled(40, true);
            less_f64(bs, f64s, yf, a, n);
            for v in bs { hs[12] = h(hs[12], v as u64); }
            cmp_u8(bs, u8s, a, n);
            for v in bs { hs[13] = h(hs[13], v as u64); }
            let cs: List<bool> = List::filled(40, false);
            cmp_u8(cs, i8s.iter().map(|x| x as u8).collect(), 0, 40);
            not_bool(bs, cs, a, n);
            for v in bs { hs[13] = h(hs[13], v as u64); }
            let ci: List<i32> = List::filled(40, 0);
            cmp_i32(ci, i32s, a, n);
            for v in ci { hs[14] = h(hs[14], v as u64); }
            let d: List<i64> = List::filled(40, 0);
            if n < 33 {
                diff(d, i64s, a, n);
            }
            // In place: each element reads its successor before it is
            // stored.
            let e = i64s.clone();
            if n < 33 {
                diff(e, e, a, n);
            }
            for v in d { hs[15] = h(hs[15], v as u64); }
            for v in e { hs[15] = h(hs[15], v as u64); }
        }
    }
    for x in hs {
        println(f"{x}");
    }
    return 0;
}
