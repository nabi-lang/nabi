// Vectorized loops (`-O2`) over long lists: strips of the loop, runs
// past a strip, the ends, every reduction and test.
// expect-exit: 0
// gc-stress: 50
// expect-stdout:
// 13852959993349066249
// 15889434338799648439
// 10827142902755319766
// 368537488057441300
// 5746918524665980389
// 8493313206387455852
// 94429072772241387
// 54 2147483647

fn h(acc: u64, x: u64) -> u64 {
    (acc ^ x).wrapping_mul(1099511628211u64)
}

fn sum_i32(xs: List<i32>, a: usize, n: usize) -> i32 {
    let s: i32 = 0;
    for i in a..n {
        s += xs[i];
    }
    s
}

fn wsum_u8(xs: List<u8>, n: usize) -> u8 {
    let s: u8 = 0;
    for i in 0..n {
        s = s.wrapping_add(xs[i]);
    }
    s
}

fn count(xs: List<u8>, c: u8, a: usize, n: usize) -> i64 {
    let k: i64 = 0;
    for i in a..n {
        if xs[i] == c {
            k += 1;
        }
    }
    k
}

fn find(xs: List<u8>, c: u8, a: usize) -> usize {
    for i in a..xs.len() {
        if xs[i] == c {
            return i;
        }
    }
    xs.len()
}

fn axpy(k: f64, ys: List<f64>, xs: List<f64>, n: usize) {
    for i in 0..n {
        ys[i] = k * xs[i] + ys[i];
    }
}

fn sub_i16(xs: List<i16>, n: usize, start: i16) -> i16 {
    let s = start;
    for i in 0..n {
        s -= xs[i];
    }
    s
}

fn main() -> i32 {
    let sizes: List<usize> = [0, 1, 15, 16, 17, 63, 64, 65, 127, 128, 129, 1000, 1023, 1024, 1025, 1088, 1100, 2047, 2048, 2049, 3000, 4100];
    let big: usize = 4200;
    let xs: List<i32> = List::filled(big, 0);
    let bs: List<u8> = List::filled(big, 0u8);
    let fs: List<f64> = List::filled(big, 0.0);
    let ws: List<i16> = List::filled(big, 0i16);
    let x: u64 = 3;
    for i in 0..big {
        x = x.wrapping_mul(6364136223846793005u64).wrapping_add(1442695040888963407u64);
        xs[i] = ((x >> 33) % 2000001u64) as i32 - 1000000;
        bs[i] = (x >> 40) as u8 % 64u8;
        fs[i] = ((x >> 33) % 1000u64) as f64 / 8.0;
        ws[i] = ((x >> 40) % 15u64) as i16 - 7;
    }
    let hs: List<u64> = List::filled(7, 14695981039346656037u64);
    for n in sizes {
        for a in [0usize, 1, 3, 17] {
            if a <= n {
                hs[0] = h(hs[0], sum_i32(xs, a, n) as u64);
                hs[1] = h(hs[1], count(bs, 5u8, a, n) as u64);
            }
        }
        hs[2] = h(hs[2], wsum_u8(bs, n) as u64);
        hs[3] = h(hs[3], sub_i16(ws, n, 0) as u64);
        let ys: List<f64> = List::filled(big, 0.5);
        axpy(1.25, ys, fs, n);
        for v in ys {
            hs[4] = h(hs[4], v.to_bits());
        }
    }
    // A search finds every match in turn, across strips.
    let at: usize = 0;
    let k: i64 = 0;
    while at < big {
        let e = find(bs, 63u8, at);
        hs[5] = h(hs[5], e as u64);
        k += 1;
        at = e + 1;
    }
    // A sum close to the top: lanes past it, elements in order not.
    let ps: List<i32> = List::filled(3000, 0);
    ps[0] = 2147483000;
    for i in 1..3000 {
        ps[i] = if i % 2 == 0 { 1 } else { -1 };
    }
    ps[2999] = 647;
    hs[6] = h(hs[6], sum_i32(ps, 0, 3000) as u64);
    hs[6] = h(hs[6], sum_i32(ps, 1, 3000) as u64);
    for v in hs {
        println(f"{v}");
    }
    println(f"{k} {sum_i32(ps, 0, 3000)}");
    return 0;
}
