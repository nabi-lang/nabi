// expect-exit: 0
// expect-stdout:
// 5
// 1.4142135623730951
// 2.718281828459

// User-declared `extern "C"` calls into libc math. Demonstrates the
// FFI path beyond the auto-injected runtime hooks.
extern "C" {
    fn sqrt(x: f64) -> f64;
    fn exp(x: f64) -> f64;
}

fn main() -> i32 {
    println(f"{unsafe { sqrt(25.0f64) }}");    // 5
    println(f"{unsafe { sqrt(2.0f64) }}");     // 1.4142135623730951
    // To 12 places: libms round the last bit differently (FreeBSD's
    // gives 2.7182818284590455).
    println(f"{unsafe { exp(1.0f64) }:.12}");  // 2.718281828459
    return 0;
}
