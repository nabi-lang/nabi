// expect-error: 8:10: unresolved import: `std::io` does not exist
// expect-error: 9:10: unresolved import: `std::io::Stdin` does not exist
// expect-error: 10:5: unresolved import: `inner::Hidden` does not exist

// A bare path root is a name the module sees: a child, an
// import, a tier, or one of `core`'s. `std` has no `io` (it is `core::io`),
// and a sibling module's child is not visible without `sup::`.
use std::io;
use std::io::Stdin;
use inner::Hidden;
use Ordering::*;
use task::spawn;

mod a { pub mod inner { pub struct Hidden {} } }
mod b { use sup::a::inner::Hidden; }

fn main() -> i32 { return 0; }
