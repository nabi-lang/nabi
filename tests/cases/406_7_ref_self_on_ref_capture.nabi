// expect-exit: 0
// expect-stdout:
// [1, 2, 3] 3
// [1, 1] 3

// `[ref c]` shares the variable, so each `ref self` call advances it; a
// local copy inside the closure changes only that copy.
struct Counter { n: i32; }
impl Counter { fn bump(ref self) -> i32 { self.n += 1; self.n } }

fn main() {
    let c = Counter { n: 0 };
    let xs = List::from_fn(3, [ref c] |_| c.bump());
    println(f"{xs:?} {c.n}");
    let ys = List::from_fn(2, |_| { let v = c; v.n = 0; v.bump() });
    println(f"{ys:?} {c.n}");
}
