// expect-exit: 0
// expect-stdout:
// V3<f64> V3<f64> V3 V3
// U8Only<u8>

// `V3::X` written without its defaulted argument reads the instance the
// expected type names, else the one impl defining it, else the default.

use core::ops::{Add, AddAssign, Mul};
use core::num::Num;

struct V3<T = f32> { x: T; y: T; z: T; }

impl<T: Num> V3<T> {
    fn new(x: T, y: T, z: T) -> V3<T> { V3 { x: x, y: y, z: z } }
}

impl<T: Num> Add for V3<T> {
    type Output = V3<T>;
    fn add(self, o: V3<T>) -> V3<T> { V3 { x: self.x + o.x, y: self.y + o.y, z: self.z + o.z } }
}

impl<T: Num> AddAssign for V3<T> {
    fn add_assign(ref self, o: V3<T>) {
        self.x = self.x + o.x;
        self.y = self.y + o.y;
        self.z = self.z + o.z;
    }
}

impl<T: Num> Mul<T> for V3<T> {
    type Output = V3<T>;
    fn mul(self, k: T) -> V3<T> { V3 { x: self.x * k, y: self.y * k, z: self.z * k } }
}

impl V3<f32> { const X: V3<f32> = V3 { x: 1.0, y: 0.0, z: 0.0 }; }
impl V3<f64> { const X: V3<f64> = V3 { x: 1.0, y: 0.0, z: 0.0 }; }

struct D<T = f64> { v: T; }

impl<T: Num> D<T> { fn new(v: T) -> D<T> { D { v: v } } }

fn name<T>(x: T) -> str { x.type_name_of_val() }

struct U8Only<T = i32> { v: T; }

impl U8Only<u8> { const ONE: U8Only<u8> = U8Only { v: 1 }; }

fn main() {
    let d: V3<f64> = V3::X;
    let e = V3::<f64>::new(1.0, 2.0, 3.0) + V3::X;
    let f = V3::X;
    let g: V3 = V3::X;
    println(f"{name(d)} {name(e)} {name(f)} {name(g)}");
    println(name(U8Only::ONE));
}
