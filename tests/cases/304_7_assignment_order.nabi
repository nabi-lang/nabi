// expect-exit: 0
// expect-stdout:
// plain: value place [5, 0, 0]
// field: value place 8
// nested: value outer inner [[0, 0], [4, 0]]
// grid: value target index [0, 7]
// sink: value index [9, 0]
// moved: [0, 1, 0]
// compound: value place [3, 0, 0]
// add_assign: place value 3
// tuple: value value place place [1, 2, 0]
// broadcast: value place [[0, 0], [3, 3]]
// broadcast op: place value [[2, 2], [3, 3]]
// default: value key {"k": 11}

// Every assignment evaluates its value before its place; a compound
// assignment that is a call on the place (`add_assign`) evaluates the
// place first, as Rust does.
struct P { a: i32; }
struct Acc { t: i32; }
struct Grid { cells: List<i32>; }
struct Sink { cells: List<i32>; }

impl ops::AddAssign<i32> for Acc {
    fn add_assign(ref self, rhs: i32) { self.t += rhs; }
}
impl index::Index<i32> for Grid {
    type Output = i32;
    fn index(self, i: i32) -> i32 { self.cells[i] }
}
impl index::IndexSet<i32, i32> for Grid {
    fn index_set(ref self, i: i32, v: i32) { self.cells[i] = v; }
}
// Write-only: no `Index`.
impl index::IndexSet<i32, i32> for Sink {
    fn index_set(ref self, i: i32, v: i32) { self.cells[i] = v; }
}

fn main() {
    let log: List<str> = [];
    let at = [ref log] |s: str, v: i64| -> i64 { log.push(s); return v; };
    let at32 = [ref log] |s: str, v: i32| -> i32 { log.push(s); return v; };
    let show = [ref log] |what: str| -> str {
        let s = f"{what}: {log.join(" ")}";
        log.clear();
        return s;
    };

    let xs = [0, 0, 0];
    xs[at("place", 0) as usize] = at("value", 5);
    println(f"{show("plain")} {xs:?}");

    let ps = [P { a: 0 }];
    ps[at("place", 0) as usize].a = at32("value", 8);
    println(f"{show("field")} {ps[0].a}");

    let ys = [[0, 0], [0, 0]];
    ys[at("outer", 1) as usize][at("inner", 0) as usize] = at("value", 4);
    println(f"{show("nested")} {ys:?}");

    let g = Grid { cells: [0, 0] };
    let grid = [ref log, g] || -> Grid { log.push("target"); return g; };
    grid()[at32("index", 1)] = at32("value", 7);
    println(f"{show("grid")} {g.cells:?}");

    let sink = Sink { cells: [0, 0] };
    sink[at32("index", 0)] = at32("value", 9);
    println(f"{show("sink")} {sink.cells:?}");

    // The value moves the index the place then reads.
    let i = 0;
    let bump = [ref i] || -> i64 { i += 1; return 1; };
    let zs = [0, 0, 0];
    zs[i] = bump();
    println(f"moved: {zs:?}");

    let cs = [0, 0, 0];
    cs[at("place", 0) as usize] += at("value", 3);
    println(f"{show("compound")} {cs:?}");

    let accs = [Acc { t: 0 }];
    accs[at("place", 0) as usize] += at32("value", 3);
    println(f"{show("add_assign")} {accs[0].t}");

    let ts = [0, 0, 0];
    (ts[at("place", 0) as usize], ts[at("place", 1) as usize]) = (at("value", 1), at("value", 2));
    println(f"{show("tuple")} {ts:?}");

    let grid2: List<List<i64>> = [[0, 0], [0, 0]];
    grid2[at("place", 1) as usize] .= at("value", 3);
    println(f"{show("broadcast")} {grid2:?}");
    grid2[at("place", 0) as usize] .+= at("value", 2);
    println(f"{show("broadcast op")} {grid2:?}");

    let d: Dict<str, i64> = Dict::new();
    let key = [ref log] |k: str| -> str { log.push("key"); return k; };
    d[key("k"), default: 1] += at("value", 10);
    println(f"{show("default")} {d:?}");
}
