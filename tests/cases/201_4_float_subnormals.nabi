// expect-exit: 0
//
// Subnormal results and inputs are kept on every target (no flush to
// zero), scalar and in vector loops; `min` / `max` order `-0.0` below
// `+0.0` and skip a NaN, the same at run and compile time.
// expect-stdout:
// 8000000000000 1 2 400000 1
// 64 64
// true true
// 8000000000000000 0 80000000 0
// 8000000000000000 0
// 1 2 true

use core::hint::black_box;

const MIN_ZERO: f64 = (0.0).min(-0.0);

fn main() {
    let tiny = black_box(f64::MIN_POSITIVE);
    let least = black_box(f64::from_bits(1u64));
    let tiny32 = black_box(f32::MIN_POSITIVE);
    let least32 = black_box(f32::from_bits(1u32));
    println(f"{(tiny / 2.0).to_bits():x} {least.to_bits()} {(least * 2.0).to_bits()} {(tiny32 / 2.0f32).to_bits():x} {(least32 * 1.0f32).to_bits()}");
    let xs = [0.0; 64];
    let ys = [0.0f32; 64];
    for i in 0..64 {
        xs[i] = least * black_box(1.0);
        ys[i] = least32 * black_box(1.0f32);
    }
    let n = 0;
    let m = 0;
    for i in 0..64 {
        if xs[i] != 0.0 { n += 1; }
        if ys[i] != 0.0f32 { m += 1; }
    }
    println(f"{n} {m}");
    println(f"{least > 0.0} {least32 > 0.0f32}");
    let z = black_box(0.0);
    let nz = black_box(-0.0);
    let z32 = black_box(0.0f32);
    let nz32 = black_box(-0.0f32);
    println(f"{z.min(nz).to_bits():x} {nz.max(z).to_bits():x} {z32.min(nz32).to_bits():x} {nz32.max(z32).to_bits():x}");
    println(f"{MIN_ZERO.to_bits():x} {(-0.0).max(0.0).to_bits()}");
    let nan = black_box(0.0) / black_box(0.0);
    println(f"{nan.min(1.0)} {(2.0).max(nan)} {nan.max(nan).is_nan()}");
}
