// forbid-warning: unused import
// expect-exit: 0
// expect-stdout:
// 2 1
// 3 4

// Impls whose trait arguments differ only through generic aliases
// (`Matrix<T>` is `Array<T, 2>`, `Vector<T>` is `Array<T, 1>`) are
// disjoint; a type named only in an impl's trait arguments counts as a
// use of its import.
use core::array::{Array, Matrix, Vector};

trait Mul2<Rhs> {
    fn mul2(self, rhs: Rhs) -> usize;
}

impl<T> Mul2<Matrix<T>> for Matrix<T> {
    fn mul2(self, rhs: Matrix<T>) -> usize { 2 }
}

impl<T> Mul2<Vector<T>> for Matrix<T> {
    fn mul2(self, rhs: Vector<T>) -> usize { 1 }
}

trait Pick<Rhs> {
    fn pick(self, rhs: Rhs) -> usize;
}

impl<T> Pick<Array<T, 2>> for Vector<T> {
    fn pick(self, rhs: Matrix<T>) -> usize { 3 }
}

impl<T> Pick<List<Vector<T>>> for Vector<T> {
    fn pick(self, rhs: List<Array<T, 1>>) -> usize { 4 }
}

fn id(m: Matrix<f64>) -> Matrix<f64> { m }

fn main() {
    let a: Matrix<f64> = [[1, 2], [3, 4]];
    let v: Vector<f64> = [1, 2];
    println(f"{id(a).mul2(a)} {a.mul2(v)}");
    println(f"{v.pick(a)} {v.pick([v])}");
}
