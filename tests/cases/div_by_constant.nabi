        if x / 11 != x / opq_u32(11) || x % 11 != x % opq_u32(11) { bad += 1; println(f"u32 {x} 11"); }
        if x / 12 != x / opq_u32(12) || x % 12 != x % opq_u32(12) { bad += 1; println(f"u32 {x} 12"); }
        if x / 13 != x / opq_u32(13) || x % 13 != x % opq_u32(13) { bad += 1; println(f"u32 {x} 13"); }
        if x / 25 != x / opq_u32(25) || x % 25 != x % opq_u32(25) { bad += 1; println(f"u32 {x} 25"); }
        if x / 100 != x / opq_u32(100) || x % 100 != x % opq_u32(100) { bad += 1; println(f"u32 {x} 100"); }
        if x / 641 != x / opq_u32(641) || x % 641 != x % opq_u32(641) { bad += 1; println(f"u32 {x} 641"); }
        if x / 1000 != x / opq_u32(1000) || x % 1000 != x % opq_u32(1000) { bad += 1; println(f"u32 {x} 1000"); }
        if x / 1023 != x / opq_u32(1023) || x % 1023 != x % opq_u32(1023) { bad += 1; println(f"u32 {x} 1023"); }
        if x / 1025 != x / opq_u32(1025) || x % 1025 != x % opq_u32(1025) { bad += 1; println(f"u32 {x} 1025"); }
        if x / 10007 != x / opq_u32(10007) || x % 10007 != x % opq_u32(10007) { bad += 1; println(f"u32 {x} 10007"); }
        if x / 65535 != x / opq_u32(65535) || x % 65535 != x % opq_u32(65535) { bad += 1; println(f"u32 {x} 65535"); }
        if x / 65537 != x / opq_u32(65537) || x % 65537 != x % opq_u32(65537) { bad += 1; println(f"u32 {x} 65537"); }
        if x / 1000000007 != x / opq_u32(1000000007) || x % 1000000007 != x % opq_u32(1000000007) { bad += 1; println(f"u32 {x} 1000000007"); }
        if x / 2147483647 != x / opq_u32(2147483647) || x % 2147483647 != x % opq_u32(2147483647) { bad += 1; println(f"u32 {x} 2147483647"); }
        if x / 2147483649 != x / opq_u32(2147483649) || x % 2147483649 != x % opq_u32(2147483649) { bad += 1; println(f"u32 {x} 2147483649"); }
        if x / 4294967295 != x / opq_u32(4294967295) || x % 4294967295 != x % opq_u32(4294967295) { bad += 1; println(f"u32 {x} 4294967295"); }
