// expect-exit: 0
// expect-stdout:
// 0 0 0 0 0 0

// Division and remainder by constants (above -O0 a multiply by the
// reciprocal) agree with division by the same values at run time.
#[inline(never)]
fn opq_u32(x: u32) -> u32 { x }
#[inline(never)]
fn opq_i32(x: i32) -> i32 { x }
#[inline(never)]
fn opq_u64(x: u64) -> u64 { x }
#[inline(never)]
fn opq_i64(x: i64) -> i64 { x }
#[inline(never)]
fn opq_u8(x: u8) -> u8 { x }
#[inline(never)]
fn opq_i16(x: i16) -> i16 { x }

fn t_u32() -> i64 {
    let bad: i64 = 0;
    let xs: List<u32> = [0, 1, 2, 6, 7, 100, 2147483647, 2147483648, 4294967295, 4294967294, 123456789, 3000000000];
    for x in xs {
        if x / 3 != x / opq_u32(3) || x % 3 != x % opq_u32(3) { bad += 1; println(f"u32 {x} 3"); }
        if x / 5 != x / opq_u32(5) || x % 5 != x % opq_u32(5) { bad += 1; println(f"u32 {x} 5"); }
        if x / 6 != x / opq_u32(6) || x % 6 != x % opq_u32(6) { bad += 1; println(f"u32 {x} 6"); }
