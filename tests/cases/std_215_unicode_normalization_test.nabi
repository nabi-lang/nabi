// A sample of UCD 18.0.0 NormalizationTest.txt (all of Part 0, every
// few lines of the others): for each `c1;c2;c3;c4;c5`, NFC is c2 for
// c1..c3 and c4 for c4, c5; NFD c3 / c5; NFKC c4; NFKD c5.
use core::str::unicode::NormalForm;

fn check(src: str, form: NormalForm, want: str) -> i32 {
    let bad = 0;
    if src.normalize(form) != want {
        println(f"{form:?} of {src:?}: {src.normalize(form):?}, want {want:?}");
        bad += 1;
    }
    if src.is_normalized(form) != (src == want) {
        println(f"is_normalized {form:?} of {src:?}");
        bad += 1;
    }
    bad
}

