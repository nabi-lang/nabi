        ["\u{200D}", "\u{915}"],
        ["\u{1F1E6}", "\u{D}"],
        ["\u{1F1E6}\u{300}"],
        ["\u{1F1E6}", "\u{6DD}"],
        ["\u{1F1E6}", "\u{11A8}"],
        ["\u{1F1E6}", "\u{915}"],
        ["\u{6DD}", "\u{D}"],
        ["\u{6DD}\u{300}"],
        ["\u{6DD}\u{6DD}"],
        ["\u{6DD}\u{11A8}"],
        ["\u{6DD}\u{915}"],
