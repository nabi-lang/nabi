        ["\u{AC01}", "\u{915}"],
        ["\u{1CF5}", "\u{D}"],
        ["\u{1CF5}\u{300}"],
        ["\u{1CF5}", "\u{6DD}"],
        ["\u{1CF5}", "\u{11A8}"],
        ["\u{1CF5}\u{915}"],
        ["\u{915}", "\u{D}"],
