        ["\u{1100}", "\u{6DD}"],
        ["\u{1100}", "\u{11A8}"],
        ["\u{1100}", "\u{915}"],
        ["\u{1160}", "\u{D}"],
        ["\u{1160}\u{300}"],
        ["\u{1160}", "\u{6DD}"],
        ["\u{1160}\u{11A8}"],
