        ["\u{D}\u{A}", "a", "\u{A}", "\u{308}"],
        ["\u{1F1E6}\u{1F1E7}", "\u{1F1E8}", "b"],
        ["a", "\u{1F1E6}\u{1F1E7}", "\u{1F1E8}", "b"],
        ["a", "\u{1F1E6}\u{1F1E7}\u{200D}", "\u{1F1E8}", "b"],
        ["a", "\u{1F1E6}\u{200D}", "\u{1F1E7}\u{1F1E8}", "b"],
        ["a", "\u{1F1E6}\u{1F1E7}", "\u{1F1E8}\u{1F1E9}", "b"],
        ["\u{1F476}\u{1F3FF}", "\u{1F476}"],
        ["a\u{1F3FF}", "\u{1F476}\u{200D}\u{1F6D1}"],
        ["\u{1F476}\u{1F3FF}\u{308}\u{200D}\u{1F476}\u{1F3FF}"],
        ["\u{915}", "\u{924}"],
        ["\u{915}\u{94D}\u{94D}\u{924}"],
        ["\u{915}\u{94D}\u{200D}\u{924}"],
        ["\u{915}\u{93C}\u{200D}\u{94D}\u{924}"],
        ["\u{915}\u{93C}\u{94D}\u{200D}\u{924}"],
        ["\u{915}\u{94D}\u{924}\u{94D}\u{92F}"],
        ["a\u{94D}\u{924}"],
        ["\u{915}\u{94D}\u{94D}\u{924}"],
        ["\u{AB8}\u{AFB}\u{ACD}\u{AB8}\u{AFB}"],
        ["\u{1019}\u{1039}\u{1018}", "\u{102C}\u{1037}"],
        ["\u{1004}\u{103A}\u{1039}\u{1011}\u{1039}\u{1011}"],
        ["\u{1B12}\u{1B01}", "\u{1B32}\u{1B44}\u{1B2F}", "\u{1B32}\u{1B44}\u{1B22}\u{1B44}\u{1B2C}", "\u{1B32}\u{1B44}\u{1B22}\u{1B38}"],
        ["\u{179F}\u{17D2}\u{178F}\u{17D2}\u{179A}\u{17B8}"],
        ["\u{1B26}", "\u{1B17}\u{1B44}\u{1B13}"],
        ["\u{1B27}", "\u{1B13}\u{1B44}\u{1B0B}", "\u{1B0B}\u{1B04}"],
        ["\u{1795}\u{17D2}\u{17AF}", "\u{1798}"],
        ["\u{17A0}\u{17D2}\u{17AB}", "\u{1791}\u{17D0}", "\u{1799}"],
        ["\u{1B05}\u{1B44}\u{1B33}\u{1B03}"],
        ["\u{1CF5}\u{995}"],
    ];
    let bad = 0;
    for want in rows {
        let text: str = want.iter().collect();
        let got: List<str> = text.graphemes().collect();
        if got != want {
            println(f"{text:?}: {got:?}, want {want:?}");
            bad += 1;
        }
        let back: List<str> = text.graphemes().rev().collect();
        if back != want.iter().rev().collect::<List<str>>() {
            println(f"{text:?}: from the back {back:?}, want {want:?}");
            bad += 1;
        }
        if text.grapheme_count() != want.len() {
            println(f"{text:?}: grapheme_count {text.grapheme_count()}");
            bad += 1;
        }
    }
    println(f"{rows.len()} lines, {bad} failures");
}
