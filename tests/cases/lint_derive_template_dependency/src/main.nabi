// nabic-arg: --extern tdep=tests/cases/lint_derive_template_dependency/tdep
// expect-exit: 0
// expect-lint: 29:4 function `unused` is never used
// forbid-warning: `helper` is never used
// forbid-warning: snake case
// expect-stdout:
// 10 S::Line

// A helper only a derive template calls is used. Code another package's
// template wrote (std's `Nabion`, binding payloads as generated names) is
// linted there, not here. A dead function's caret covers its name.
use std::nabion::ToNabion;
use tdep::Ten;

#[derive(Ten)]
struct T {}

#[derive(Nabion)]
enum S { Dot, Line(i64) }

fn main() {
    let v = S::Line(3).to_nabion();
    match v {
        std::nabion::Value::Variant { path, .. } => println(f"{T {}.ten()} {path}"),
        _ => println("other"),
    }
}

fn unused() {}
