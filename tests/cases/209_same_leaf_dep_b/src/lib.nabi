//! A copy of `209_same_leaf_dep_a`: types of the same names.
pub mod captures;
mod iter;
pub use iter::Iter;
pub use captures::Match;

pub struct Regex { pat: str; }

impl Regex {
    pub fn new(p: str) -> Regex { Regex { pat: p } }
    pub fn find_iter(self, h: str) -> Iter { Iter { at: 0, n: h.len(), w: self.pat.len() } }
}
