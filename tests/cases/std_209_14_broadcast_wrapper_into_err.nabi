// expect-error: mismatched types: `.=` writes a `Q<Array<f64, 1>, 1>` into a `Q<Array<f64, 1>, -1>`

// An in-place dot expression over a type-changing wrapper must give
// the target's type.
use core::array::Array;
use core::ops::{Broadcastable, Materialize};

#[derive(Debug)]
struct Q<V, const L: i32> { v: V; }

impl<const R: usize, const L: i32> Broadcastable<R> for Q<Array<f64, R>, L> {
    type Elem = f64;
    fn broadcast_view(self) -> Array<f64, R> { self.v }
}
impl<const R: usize, const L: i32> Materialize<f64, R> for Q<Array<f64, R>, L> {
    type Output = Q<Array<f64, R>, L>;
    fn materialize(out: Array<f64, R>) -> Q<Array<f64, R>, L> { Q { v: out } }
}
impl<const R: usize, const L: i32, const L2: i32> ops::DotDiv<Q<Array<f64, R>, L2>> for Q<Array<f64, R>, L> {
    type Output = Q<Array<f64, R>, { L - L2 }>;
    fn dot_div(self, rhs: Q<Array<f64, R>, L2>) -> Q<Array<f64, R>, { L - L2 }> { Q { v: self.v ./ rhs.v } }
}
impl<const R: usize, const L: i32> ops::DotAdd for Q<Array<f64, R>, L> {
    type Output = Q<Array<f64, R>, L>;
    fn dot_add(self, rhs: Q<Array<f64, R>, L>) -> Q<Array<f64, R>, L> { Q { v: self.v .+ rhs.v } }
}

fn main() {
    let d: Q<Array<f64, 1>, 1> = Q { v: [2.0, 4.0] };
    let t: Q<Array<f64, 1>, 2> = Q { v: [1.0, 2.0] };
    let s: Q<Array<f64, 1>, -1> = d ./ t;
    s .= d .+ d;
}
