// expect-exit: 0
// expect-stdout:
// [-1.0, -2.0] [[1.0, 10.0], [1.0, 10.0]] [2.0, 4.0] [[1.0, 2.0, 4.0]] []

// A local bound to an unsuffixed float literal is the element type
// where it meets one: as a broadcast scalar (`.=`, `.*=`), stored with
// `a[i, j] = v`. Branches that differ only in how a const argument was
// found are one type.
use core::array::{Array, Matrix, Vector};

fn vander(deg: usize, xs: List<f64>) -> Matrix<f64> {
    let v: Matrix<f64> = Array::zeros([xs.len(), deg + 1]);
    for i in 0..xs.len() {
        let p = 1.0;
        for j in 0..deg + 1 {
            v[i, j] = p;
            p *= 2.0;
        }
    }
    v
}

fn main() {
    let n: usize = 2;
    let x: Vector<f64> = [1.0, 2.0];
    let y: Vector<f64> = Array::zeros([2]);
    let s = if n > 1 { -1.0 } else { 1.0 };
    y .= s .* x;
    let a: Matrix<f64> = Array::ones([2, 2]);
    let w = 10.0;
    a[:, 1] .*= w;
    let xs: List<f32> = [1.0, 2.0];
    let k = 2.0;
    xs .*= k;
    let m: usize = 0;
    let e = if m == 0 { Array::zeros([0]) } else { x .* 2.0 };
    println(f"{y:?} {a:?} {xs:?} {vander(2, [1.0]):?} {e:?}");
}
