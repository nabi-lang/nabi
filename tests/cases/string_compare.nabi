// expect-exit: 12
// expect-stdout:
// true false true false

extern "C" {
    fn strcmp(a: str, b: str) -> i32;
}

fn equal(a: str, b: str) -> bool {
    return unsafe { strcmp(a, b) } == 0;
}

fn main() -> i32 {
    println(f"{equal("hello", "hello")} {equal("foo", "bar")} {equal("nabi", "nabi")} {equal("nabi", "ro")}");
    let total = 0;
    if equal("hello", "hello") {
        total += 5;
    }
    if equal("foo", "bar") {
        total += 100;
    }
    if equal("nabi", "nabi") {
        total += 7;
    }
    return total;
}

