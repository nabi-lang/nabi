// expect-exit: 0
// expect-stdout:
// [104, 105] hi
// [104, 233, 8364] hé€
// [55357, 56832, 97] 😀a
// 0 true
// slice: é€ array: 😀

// `encode_utf16` gives the UTF-16 units (no NUL), `str::from_utf16`
// takes them back from a `List<u16>`, a `Slice<u16>` or an array: ASCII,
// the BMP and an astral char (a surrogate pair).
fn main() {
    for s in ["hi", "h\u{E9}\u{20AC}", "\u{1F600}a"] {
        let u = s.encode_utf16();
        let back = try! str::from_utf16(u);
        assert_eq(back, s);
        println(f"{u:?} {back}");
    }
    let empty = "".encode_utf16();
    println(f"{empty.len()} {(try! str::from_utf16(empty)).is_empty()}");
    let u = "h\u{E9}\u{20AC}".encode_utf16();
    println(f"slice: {try! str::from_utf16(u[1:3])} array: {try! str::from_utf16([0xD83Du16, 0xDE00u16])}");
}
