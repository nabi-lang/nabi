// expect-exit: 0
// expect-stdout:
// leap false true true false true true false
// feb 28 29 0
// epoch 1970-01-01 Thursday 0
// one 0001-01-01 Monday -719162
// range -999999-01-01 +999999-12-31 -365961662 364522971 -999999 999999
// bc 0000-12-31 -000044-03-15 -000001-12-31
// big +010000-01-01 +010000-01-01
// checked none none none
// days 1096
// ordinal 366 365 2024-02-29 2023-03-01
// iso 2021-01-03 Sunday 2020-W53 2021-01-03
// iso 2021-01-04 Monday 2021-W01 2021-01-04
// iso 2024-12-30 Monday 2025-W01 2024-12-30
// iso 2020-12-31 Thursday 2020-W53 2020-12-31
// iso 2026-01-01 Thursday 2026-W01 2026-01-01
// iso 2015-12-31 Thursday 2015-W53 2015-12-31
// weekday Monday Sunday none 7
// months 2024-02-29 2025-02-28 2023-11-30 2024-03-29 2024-03-31
// years 2025-02-28 2028-02-29 2023-02-28 0000-02-29
// month ends 2024-02-01 2024-02-29 2023-02-28 2024-02-01
// sizes 29 366 365
// until 2024-01-31 2024-02-29 P1M true 29
// until 2024-01-31 2024-03-01 P1M1D true 30
// until 2024-03-31 2024-02-28 P-1M-1D true -32
// until 2020-02-29 2024-02-28 P3Y11M30D true 1460
// until 2020-02-29 2024-02-29 P4Y true 1461
// until 2024-05-15 2024-05-15 P0D true 0
// until -000001-12-31 0001-01-01 P1Y1D true 367
// period P1Y12M 24 P-1Y-12M P0D true 2025-01-31 2023-12-31
// error: day 29 is out of range for 2023-02 (1..=28)
// error: month 13 is out of range (1..=12)
// error: month 0 is out of range (1..=12)
// error: day 31 is out of range for 2024-04 (1..=30)
// error: year 1000000 is out of range (-999999..=999999)
// error: day 0 is out of range for 2024-01 (1..=31)
// error: day of year 366 is out of range for 2023 (1..=365)
// error: week 53 is out of range for 2024 (1..=52)
// order true true true

// `Date` over its whole range: leap years, year and month boundaries,
// negative years (0 is 1 BC), ISO weeks, clamping month arithmetic,
// `until` round trips, and the errors that name the bad field.
use std::time::{Date, MAX_YEAR, MIN_YEAR, Period, Weekday, days_in_month, is_leap_year};

fn show(r: str) { println(r); }

fn main() throws {
    println(f"leap {is_leap_year(1900)} {is_leap_year(2000)} {is_leap_year(2024)} {is_leap_year(2023)} {is_leap_year(0)} {is_leap_year(-4)} {is_leap_year(-100)}");
    println(f"feb {days_in_month(1900, 2)} {days_in_month(2000, 2)} {days_in_month(2023, 13)}");
    let epoch = Date::from_unix_days(0);
    println(f"epoch {epoch} {epoch.weekday()} {epoch.unix_days()}");
    println(f"one {try Date::new(1, 1, 1)} {(try Date::new(1, 1, 1)).weekday()} {(try Date::new(1, 1, 1)).unix_days()}");
    println(f"range {Date::MIN} {Date::MAX} {Date::MIN.unix_days()} {Date::MAX.unix_days()} {MIN_YEAR} {MAX_YEAR}");
    println(f"bc {try Date::new(0, 12, 31)} {try Date::new(-44, 3, 15)} {(try Date::new(0, 1, 1)).add_days(-1)}");
    println(f"big {try Date::new(10000, 1, 1)} {(try Date::new(9999, 12, 31)).add_days(1)}");
    println(f"checked {Date::MAX.checked_add_days(1):?} {Date::MIN.checked_add_days(-1):?} {Date::MAX.checked_add_months(1):?}");

    // Every day of 1999..=2001 steps by one, and round trips.
    let d = try Date::new(1999, 1, 1);
    let n = 0;
    while d.year() < 2002 {
        let next = d.add_days(1);
        if next.unix_days() != d.unix_days() + 1 || Date::from_unix_days(d.unix_days()) != d { println(f"step {d}"); }
        if next.weekday() != d.weekday().next() || d.weekday() != next.weekday().prev() { println(f"weekday {d}"); }
        if try d.to_str().parse::<Date>() != d { println(f"text {d}"); }
        n += 1;
        d = next;
    }
    println(f"days {n}");

    println(f"ordinal {(try Date::new(2024, 12, 31)).ordinal()} {(try Date::new(2023, 12, 31)).ordinal()} {try Date::from_ordinal(2024, 60)} {try Date::from_ordinal(2023, 60)}");
    for (y, m, dd) in [(2021, 1, 3), (2021, 1, 4), (2024, 12, 30), (2020, 12, 31), (2026, 1, 1), (2015, 12, 31)] {
        let x = try Date::new(y, m, dd);
        let (wy, wn) = x.iso_week();
        println(f"iso {x} {x.weekday().name()} {wy}-W{wn:02} {try Date::from_iso_week(wy, wn, x.weekday())}");
    }
    println(f"weekday {Weekday::from_number(1):?} {Weekday::from_number(7):?} {Weekday::from_number(8):?} {Weekday::Sunday.number()}");

    let jan31 = try Date::new(2024, 1, 31);
    println(f"months {jan31.add_months(1)} {jan31.add_months(13)} {jan31.add_months(-2)} {jan31.add_months(1).add_months(1)} {jan31.add_months(2)}");
    let feb29 = try Date::new(2024, 2, 29);
    println(f"years {feb29.add_years(1)} {feb29.add_years(4)} {feb29.add_years(-1)} {feb29.add_years(-2024)}");
    println(f"month ends {feb29.first_of_month()} {feb29.last_of_month()} {(try Date::new(2023, 2, 10)).last_of_month()} {try feb29.with_day(1)}");
    println(f"sizes {feb29.days_in_month()} {feb29.days_in_year()} {(try Date::new(2023, 6, 1)).days_in_year()}");

    let pairs = [
        (try Date::new(2024, 1, 31), try Date::new(2024, 2, 29)),
        (try Date::new(2024, 1, 31), try Date::new(2024, 3, 1)),
        (try Date::new(2024, 3, 31), try Date::new(2024, 2, 28)),
        (try Date::new(2020, 2, 29), try Date::new(2024, 2, 28)),
        (try Date::new(2020, 2, 29), try Date::new(2024, 2, 29)),
        (try Date::new(2024, 5, 15), try Date::new(2024, 5, 15)),
        (try Date::new(-1, 12, 31), try Date::new(1, 1, 1)),
    ];
    for (a, b) in pairs {
        let p = a.until(b);
        println(f"until {a} {b} {p} {a + p == b} {b.days_since(a)}");
    }
    let p = Period::new(1, 2, 3) + Period::of_months(10) - Period::of_days(3);
    println(f"period {p} {p.total_months()} {-p} {Period::ZERO} {Period::ZERO.is_zero()} {jan31 + Period::of_years(1)} {jan31 - Period::of_months(1)}");

    let bad = [(2023, 2, 29), (2024, 13, 1), (2024, 0, 10), (2024, 4, 31), (1000000, 1, 1), (2024, 1, 0)];
    for (y, m, dd) in bad {
        try { show(f"{try Date::new(y, m, dd)}"); } catch e { show(f"error: {e}"); }
    }
    try { show(f"{try Date::from_ordinal(2023, 366)}"); } catch e { show(f"error: {e}"); }
    try { show(f"{try Date::from_iso_week(2024, 53, Weekday::Monday)}"); } catch e { show(f"error: {e}"); }
    println(f"order {jan31 < feb29} {Date::MIN < Date::MAX} {try Date::new(-1, 1, 1) < try Date::new(0, 1, 1)}");
}
