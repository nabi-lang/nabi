// expect-error: only an `extern "C"` function
// expect-error: help: C calls it with the C ABI: declare it `extern "C" fn twice(..)`
// An `extern "C" fn(..)` value is a bare C code pointer: a
// nabi-ABI function has no C entry to point at.

fn twice(x: i32) -> i32 { x * 2 }

fn main() {
    let f: extern "C" fn(i32) -> i32 = twice;
    println(f"{f(2)}");
}
