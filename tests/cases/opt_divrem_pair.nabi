// 0,0 1,0 -1,0 6,0 -6,0 7,0 -7,0 0,10 0,-10 7,922337203685477580 -8,-922337203685477580 -7,-922337203685477580
// 0,0 1,0 -1,0 6,0 -6,0 7,0 -7,0 100,0 -100,0 807,9223372036854775 -808,-9223372036854775 -807,-9223372036854775
