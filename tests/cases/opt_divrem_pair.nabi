// `x % c` beside `x / c` (either order): the remainder made from the
// quotient keeps truncating division's sign rules at every width.

fn digsum(v: u64) -> str {
    let s: u64 = 0;
    let n: u64 = 0;
    while v >= 10u64 {
        s += v % 10u64;
        v = v / 10u64;
        n += 1u64;
    }
    f"{s + v}:{n + 1u64}"
}

fn rq(v: i64, d: i64) -> str {
    let r = v % d;
    let q = v / d;
    f"{r},{q}"
}

fn i64s(d: i64) -> str {
    let vals: List<i64> = [0, 1, -1, 6, -6, 7, -7, 100, -100, 9223372036854775807, -9223372036854775807 - 1, -9223372036854775807];
    let out = StrBuf::new();
    let first = true;
    for v in vals {
        if !first { out.push_str(" "); }
        first = false;
        if d == 7 {
            out.push_str(rq(v, 7));
        } else if d == -7 {
            out.push_str(rq(v, -7));
        } else if d == 10 {
            out.push_str(rq(v, 10));
        } else {
            out.push_str(rq(v, 1000));
        }
    }
    out.to_str()
}

fn i32s(d: i32) -> str {
    let vals: List<i32> = [0, -1, 2147483647, -2147483647 - 1, -123456789, 123456789];
    let out = StrBuf::new();
    let first = true;
    for v in vals {
        if !first { out.push_str(" "); }
        first = false;
        let (q, r) = if d == 3 { (v / 3, v % 3) } else if d == -3 { (v / -3, v % -3) } else { (v / 10, v % 10) };
        out.push_str(f"{q},{r}");
    }
    out.to_str()
}

fn main() {
    let xs: List<u64> = [0u64, 1u64, 9u64, 10u64, 11u64, 99u64, 100u64, 12345678901234567u64, 18446744073709551615u64, 18446744073709551606u64];
    let out = StrBuf::new();
    let first = true;
    for x in xs {
        if !first { out.push_str(" "); }
        first = false;
        out.push_str(digsum(x));
    }
    println(out.to_str());
    println(i64s(7));
    println(i64s(-7));
    println(i64s(10));
    println(i64s(1000));
    println(i32s(3));
    println(i32s(-3));
    println(i32s(10));
    let us: List<u8> = [0u8, 6u8, 7u8, 200u8, 255u8];
    let o = StrBuf::new();
    for k in 0..us.len() {
        let v = us[k];
        if k > 0 { o.push_str(" "); }
        o.push_str(f"{v / 7u8},{v % 7u8}");
    }
    println(o.to_str());
    let ss: List<i8> = [-128i8, -5i8, -4i8, 0i8, 4i8, 5i8, 127i8];
    let p = StrBuf::new();
    for k in 0..ss.len() {
        let v = ss[k];
        if k > 0 { p.push_str(" "); }
        let r = v % 5i8;
        p.push_str(f"{r},{v / 5i8}");
    }
    println(p.to_str());
}
