// expect-exit: 101
// expect-stderr: thread 'main' panicked at tests/cases/slicemut_stale_version_panics.nabi:34:5:
// expect-stderr: SliceMut used after its list was resized (push, insert, clear, ...): make the view again after the resize
// expect-stdout:
// [10, 2, 3]
// [10, 20, 3, 9] fresh
// [10, 5, 3, 9] stale write 5
// 3 3

// A resize the compiler cannot see (inside another function) bumps the
// list's version. A view made before it is stale: its element accesses
// reach the storage it was made of (here still the list's: the push had
// room), and its other methods panic.
fn grow(xs: List<i32>) {
    xs.push(9);
}

fn view(xs: List<i32>) -> SliceMut<i32> {
    xs
}

fn main() {
    let xs: List<i32> = [1, 2, 3];
    let s = view(xs);
    s[0] = 10;
    println(f"{xs:?}");
    grow(xs);
    let t = view(xs);
    t[1] = 20;
    println(f"{xs:?} fresh");
    s[1] = 5;
    println(f"{xs:?} stale write {s[1]}");
    println(f"{s.len()} {s.get(2) ?? 0}");
    s.fill(0);
    println("not reached");
}
