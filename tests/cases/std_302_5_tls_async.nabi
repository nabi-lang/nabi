// needs: net
// skip-wasm-runner: jco
// (preview2-shim 0.31.1, the latest, files an accepted socket's
// pollable under its input stream: closing the socket in wasi-libc's
// order, the stream before the socket's pollable, traps; fixed by
// targets/wasi/shim.patch)
// expect-exit: 0
// expect-stdout:
// handshake: alpn h2, sni localhost
// server got 300000 bytes, intact true
// client got 300000 bytes back, intact true
// wrong name: Certificate certificate is not valid for example.com
// server saw: PeerAlert peer sent alert 42

// TLS `*_async` methods. Both sides run on one worker, so a blocking call stalls.
use std::net::{TcpListener, TcpStream, SocketAddr};
use std::net;
use std::net::tls::{Client, Server, ClientConfig, ServerConfig, Certificate, PrivateKey};

const CA: str = "-----BEGIN CERTIFICATE-----
MIIBVTCCAQegAwIBAgIUHuDQmdyLUvVYGHs5rDw1vYU8bIIwBQYDK2VwMBcxFTAT
BgNVBAMMDG5hYmkgdGVzdCBDQTAgFw0yNjEwMTUwNzM2MDdaGA8yMTI2MDkyMTA3
MzYwN1owFzEVMBMGA1UEAwwMbmFiaSB0ZXN0IENBMCowBQYDK2VwAyEAB+sqwSMn
18aRYXVx9C0isj2rte+3tqndY+2zzNZjGb6jYzBhMB0GA1UdDgQWBBRQnL+ov9Go
zKIB+up0p4yTbN6CMzAfBgNVHSMEGDAWgBRQnL+ov9GozKIB+up0p4yTbN6CMzAP
BgNVHRMBAf8EBTADAQH/MA4GA1UdDwEB/wQEAwICBDAFBgMrZXADQQAaONBcyMPW
W6oGu6jBgPPGBjoMbsyzkki6bAFDUd4b2pmFFAPtu6an8KCxK3SS0GcW5n9g3LUw
nCHpi3ak0WUC
-----END CERTIFICATE-----
";

const CERT: str = "-----BEGIN CERTIFICATE-----
MIIBuzCCAW2gAwIBAgIUceOw315SUu5KnTBYX6EEY5MLRJUwBQYDK2VwMBcxFTAT
BgNVBAMMDG5hYmkgdGVzdCBDQTAgFw0yNjEwMTUwNzM2MDdaGA8yMTI2MDkyMTA3
MzYwN1owFDESMBAGA1UEAwwJbG9jYWxob3N0MFkwEwYHKoZIzj0CAQYIKoZIzj0D
AQcDQgAEpUU2sRqQuX5dmljhOAPeCEGDpS2mRBWhKav+lCHRC98Dytzo97/vewlk
X90rCHvF9P2aaFvqacjDDufEDkB8laOBnDCBmTAnBgNVHREEIDAegglsb2NhbGhv
c3SCCyoubmFiaS50ZXN0hwR/AAABMBMGA1UdJQQMMAoGCCsGAQUFBwMBMA4GA1Ud
DwEB/wQEAwIHgDAJBgNVHRMEAjAAMB0GA1UdDgQWBBT7b7pFb4lWIeDoqC8VrldS
NJCsDzAfBgNVHSMEGDAWgBRQnL+ov9GozKIB+up0p4yTbN6CMzAFBgMrZXADQQAk
YxqmrA4iRhI0c6e8zk2bV3j6lxnwYR8PX7cansnBmY0Tt7TRd2oG2/h6z9KQ0mX1
