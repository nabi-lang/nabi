        ["a", ",", ".", "1"],
        ["a_1", ",", ".", "a"],
        ["a_a", ",", ",", "1"],
    ];
    let bad = 0;
    for want in rows {
        let text: str = want.iter().collect();
        let got: List<str> = text.split_word_bounds().collect();
        if got != want {
            println(f"{text:?}: {got:?}, want {want:?}");
            bad += 1;
        }
    }
    println(f"{rows.len()} lines, {bad} failures");
}
