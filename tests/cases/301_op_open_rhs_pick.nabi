// expect-exit: 0
// expect-stdout: W<f32> 2

// A right operand whose literals are still open (a `let`) takes the one
// number type an impl of the operator accepts.

use core::ops::{Add, AddAssign, Mul};
use core::num::Num;

struct V3<T = f32> { x: T; y: T; z: T; }

impl<T: Num> V3<T> {
    fn new(x: T, y: T, z: T) -> V3<T> { V3 { x: x, y: y, z: z } }
}

impl<T: Num> Add for V3<T> {
    type Output = V3<T>;
    fn add(self, o: V3<T>) -> V3<T> { V3 { x: self.x + o.x, y: self.y + o.y, z: self.z + o.z } }
}

impl<T: Num> AddAssign for V3<T> {
    fn add_assign(ref self, o: V3<T>) {
        self.x = self.x + o.x;
        self.y = self.y + o.y;
        self.z = self.z + o.z;
    }
}

impl<T: Num> Mul<T> for V3<T> {
    type Output = V3<T>;
    fn mul(self, k: T) -> V3<T> { V3 { x: self.x * k, y: self.y * k, z: self.z * k } }
}

impl V3<f32> { const X: V3<f32> = V3 { x: 1.0, y: 0.0, z: 0.0 }; }
impl V3<f64> { const X: V3<f64> = V3 { x: 1.0, y: 0.0, z: 0.0 }; }

struct D<T = f64> { v: T; }

impl<T: Num> D<T> { fn new(v: T) -> D<T> { D { v: v } } }

fn name<T>(x: T) -> str { x.type_name_of_val() }

struct W<T> { x: T; }

impl<T> W<T> { fn new(x: T) -> W<T> { W { x: x } } }

struct M { k: f32; }

impl Mul<M> for M {
    type Output = M;
    fn mul(self, o: M) -> M { M { k: self.k * o.k } }
}

impl Mul<W<f32>> for M {
    type Output = W<f32>;
    fn mul(self, v: W<f32>) -> W<f32> { W { x: v.x * self.k } }
}

fn main() {
    let m = M { k: 2.0 };
    let v = W::new(1.0);
    let r = m * v;
    println(f"{name(r)} {r.x}");
}
