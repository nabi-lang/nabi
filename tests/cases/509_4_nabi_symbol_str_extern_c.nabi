// `nabi_*` names the runtime's functions, whose `str` is
// `(ptr, len)`; an `extern "C"` `str` is a NUL-terminated `char*`.
extern "C" { fn nabi_str_cstr(s: str) -> usize; }

println(f"{unsafe { nabi_str_cstr("x") }}");
