// expect-error: extern function `nabi_gc_register_type` is declared twice with different signatures: `fn(u32, usize) -> ()` here, `fn(u32, ConstPtr<u8>) -> ()` elsewhere; a `nabi_*` symbol is the runtime's: declare it with the runtime's signature
// `core::rt` declares the runtime symbols codegen calls on its own:
// a program's declaration of one must have the runtime's signature.
extern "C" {
    fn nabi_gc_register_type(type_id: u32, table: usize);
