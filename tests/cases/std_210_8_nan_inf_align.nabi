// expect-exit: 0
// expect-stdout: [   NaN] [   inf] [   NaN] [-inf  ] [   1.5] [  NaN] [   +inf]

// inf and NaN align as numbers (right by default) and take no `0` fill
// (spec 2.10.8).
fn main() {
    println(f"[{f64::NAN:6}] [{f64::INFINITY:6}] [{f64::NAN:06}] [{-f64::INFINITY:<6}] [{1.5:6}] [{f32::NAN:5}] [{f64::INFINITY:+07}]");
}
