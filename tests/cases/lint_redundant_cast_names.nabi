// expect-exit: 0
// expect-lint: 15:13 casting to the same type `P<f64>`
// expect-lint: 16:13 casting to the same type `(i64, bool)`
// expect-lint: 17:13 casting to the same type `[u8; 2]`
// expect-stdout: 1.5 true 2

// `redundant_cast` names the type as the source writes it: a struct
// instance with its type arguments, a tuple, an array.
struct P<T> { x: T }

fn main() {
    let p = P { x: 1.5 };
    let t = (1, true);
    let b: [u8; 2] = [1, 2];
    let q = p as P<f64>;
    let u = t as (i64, bool);
    let a = b as [u8; 2];
    println(q.x, u.1, a[1]);
}
