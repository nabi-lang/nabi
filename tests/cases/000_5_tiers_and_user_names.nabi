// expect-exit: 0
// expect-stdout:
// 1 7 8 9
// [1, 2] 3 8 true

// User modules `std` / `bare` / `core` and a local `nabi` are ordinary
// names: they shadow the library's tiers, and `::std` / `::core` /
// `::bare` still reach the library past them.
mod std { pub fn f() -> i32 { 7 } }
mod bare { pub fn g() -> i32 { 8 } }
mod core { pub fn h() -> i32 { 9 } }

fn main() {
    let nabi = 1;
    println(f"{nabi} {std::f()} {bare::g()} {core::h()}");
    let xs: List<i32> = [1, 2];
    let d: ::core::collections::dict::Dict<str, i32> = Dict::new();
    d["k"] = 3;
    let n = ::bare::mem::size_of::<i64>();
    let p = ::std::path::Path::empty();
    println(f"{xs:?} {d["k"]} {n} {p.is_relative()}");
}
