// expect-exit: 0
// expect-stdout:
// America/New_York 1883-11-18T00:00:00 -> 1883-11-18T00:00:00-04:56:02 LMT dst false unix -2717694238
// America/New_York 1918-03-31T02:30:00 -> 1918-03-31T03:30:00-04:00 EDT dst true unix -1633278600
// America/New_York 1918-10-27T01:30:00 -> 1918-10-27T01:30:00-04:00 EDT dst true unix -1615141800
// America/New_York 1945-08-14T12:00:00 -> 1945-08-14T12:00:00-04:00 EWT dst true unix -769420800
// America/New_York 1974-01-06T02:30:00 -> 1974-01-06T03:30:00-04:00 EDT dst true unix 126689400
// America/New_York 2006-04-02T02:30:00 -> 2006-04-02T03:30:00-04:00 EDT dst true unix 1143963000
// America/New_York 2007-03-11T02:30:00 -> 2007-03-11T03:30:00-04:00 EDT dst true unix 1173598200
