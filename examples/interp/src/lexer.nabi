//! Turns source text into tokens. `tokens` is a generator: the parser
//! pulls one token at a time and a bad character surfaces as a thrown
//! `LangError` at that step.

use pkg::error::{LangError, Span};

const KEYWORDS: [str; 11] = ["let", "fn", "if", "else", "while", "return", "true", "false", "nil", "and", "or"];

/// What a token is.
#[derive(Clone, PartialEq, Debug)]
pub enum Tok {
    Num(f64),
    Str(str),
    Ident(str),
    /// A reserved word (`let`, `while`, ..).
    Kw(str),
    /// Punctuation or an operator (`+`, `==`, `(`, ..).
    Sym(str),
    Eof,
}

/// A token and where it came from.
#[derive(Clone, Debug)]
pub struct Token {
    pub tok: Tok;
    pub span: Span;
}

impl Tok {
    /// The token as an error message names it.
    pub fn describe(self) -> str {
        match self {
            Tok::Num(n) => f"number {n}",
            Tok::Str(_) => "a string",
            Tok::Ident(s) => f"`{s}`",
            Tok::Kw(s) | Tok::Sym(s) => f"`{s}`",
            Tok::Eof => "the end of input",
        }
    }
}

/// Whether `c` can be part of a name.
fn is_ident(c: char) -> bool { c.is_ascii_alphanumeric() || c == '_' }

/// The tokens of `src`, ending with one `Eof`; `src` starts at line
/// `first` of the file.
pub yield fn tokens(src: str, first: usize = 1) throws (LangError) -> Token {
    let cs: List<char> = src.chars().collect();
    let i = 0usize;
    let line = first;
    let col = 1usize;
    loop {
        // Whitespace and `#` comments; only here can a line end.
        while i < cs.len() && (cs[i].is_whitespace() || cs[i] == '#') {
            if cs[i] == '#' {
                while i < cs.len() && cs[i] != '\n' { i += 1; }
                continue;
            }
            if cs[i] == '\n' {
                line += 1;
                col = 0;
            }
            i += 1;
            col += 1;
        }
        let at = Span { line, col, len: 1 };
        if i >= cs.len() {
            yield Token { tok: Tok::Eof, span: at };
            return;
        }
        let c = cs[i];
        let j = i + 1;
        let tok = if c.is_ascii_digit() {
            while j < cs.len() && cs[j].is_ascii_digit() { j += 1; }
            if j + 1 < cs.len() && cs[j] == '.' && cs[j + 1].is_ascii_digit() {
                j += 1;
                while j < cs.len() && cs[j].is_ascii_digit() { j += 1; }
            }
            Tok::Num(try text(cs, i, j).parse::<f64>() catch _ { throw LangError::new("malformed number", at); })
        } else if is_ident(c) {
            while j < cs.len() && is_ident(cs[j]) { j += 1; }
            let word = text(cs, i, j);
            if KEYWORDS.contains(word) { Tok::Kw(word) } else { Tok::Ident(word) }
        } else if c == '"' {
            let out = StrBuf::new();
            loop {
                if j >= cs.len() || cs[j] == '\n' { throw LangError::new("unterminated string", at); }
                let d = cs[j];
                j += 1;
                if d == '"' { break; }
                if d != '\\' {
                    out.push(d);
                    continue;
                }
                let e = if j < cs.len() { cs[j] } else { ' ' };
                let esc = Span { line, col: col + j - i - 1, len: 2 };
                out.push(match e {
                    'n' => '\n',
                    't' => '\t',
                    '"' => '"',
                    '\\' => '\\',
                    _ => throw LangError::new(f"unknown escape `\\{e}`", esc),
                });
                j += 1;
            }
            Tok::Str(out.to_str())
        } else {
            let two = if j < cs.len() { text(cs, i, j + 1) } else { "" };
            if two == "==" || two == "!=" || two == "<=" || two == ">=" {
                j += 1;
                Tok::Sym(two)
            } else if "+-*/%!=<>(){}[],;".contains(f"{c}") {
                Tok::Sym(text(cs, i, j))
            } else {
                throw LangError::new(f"unexpected character `{c}`", at);
            }
        };
        yield Token { tok: tok, span: Span { line, col, len: j - i } };
        col += j - i;
        i = j;
    }
}

/// `cs[from:to]` as a string.
fn text(cs: List<char>, from: usize, to: usize) -> str {
    let out = StrBuf::new();
    for k in from..to { out.push(cs[k]); }
    out.to_str()
}
