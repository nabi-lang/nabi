// Parser precedence, closures and error rendering.

use pkg::parser::parse;
use pkg::{Interp, LangError};

/// The S-expression of the single statement in `src`.
fn tree(src: str) -> str {
    let prog = try parse(src) catch e { panic(f"{e}"); };
    prog.kids[0].sexp()
}

/// What `src` prints, one line per `print`.
fn output(src: str) -> str {
    let out = StrBuf::new();
    let it = Interp::new(|line| out.push_str(line + "\n"));
    try it.run(src) catch e { panic(e.render(src, "test")); };
    out.to_str()
}

/// The rendered error `src` fails with.
fn failure(src: str) -> str {
    let it = Interp::new(|_: str| {});
    try it.run(src) catch e: LangError { return e.render(src, "t.lang"); };
    panic(f"expected {src:?} to fail")
}

#[test]
fn precedence() {
    assert_eq(tree("1 + 2 * 3 - 4"), "(Sub (Add 1 (Mul 2 3)) 4)");
    assert_eq(tree("-a[0] * 2"), "(Mul (Neg (Index a 0)) 2)");
    assert_eq(tree("a < b == c > d"), "(Eq (Lt a b) (Gt c d))");
    assert_eq(tree("x or y and !z"), "(Or x (And y (Not z)))");
    assert_eq(tree("a = b = 1 + 1"), "(= a (= b (Add 1 1)))");
    assert_eq(tree("f(1)(2)[3]"), "(Index (Call (Call f 1) 2) 3)");
}

#[test]
fn closures() {
    let src = "fn counter() { let n = 0; fn() { n = n + 1; n } }\n"
        + "let a = counter(); let b = counter();\n"
        + "a(); a(); b();\n"
        + "print(a(), b());\n";
    assert_eq(output(src), "3 2\n");
    assert_eq(output("let adder = fn(x) { fn(y) { x + y } }; print(adder(2)(40))"), "42\n");
    assert_eq(output("fn f(n) { if n > 3 { return n } f(n + 1) } print(f(0))"), "4\n");
}

#[test]
fn caret() {
    let src = "let x = 1;\nprint(x + true);\n";
    assert_eq(failure(src), "t.lang:2:9: error: cannot apply `+` to a number and a bool\n  |\n2 | print(x + true);\n  |         ^");
    assert_eq(failure("let s = \"a\\qb\""), "t.lang:1:11: error: unknown escape `\\q`\n  |\n1 | let s = \"a\\qb\"\n  |           ^^");
    assert_eq(failure("print(nope)"), "t.lang:1:7: error: undefined variable `nope`\n  |\n1 | print(nope)\n  |       ^^^^");
}
