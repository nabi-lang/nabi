// Time to safepoint: one thread churns garbage (its collections are
// logged) while a second thread does something that may hold a stop
// back. The logged pause runs from the stop request, so it includes
// the wait for the other thread.
//
//     ttsp <none|loop|count|find|grow|hand|sleep|cblock> <churn MiB>
//
// loop:   arithmetic loop without calls (back-edge polls only)
// count:  str::char_count of a 256 MiB string (a long runtime call)
// find:   str::contains on it (a long search)
// grow:   a StrBuf grown to 256 MiB again and again (reserve copies)
// hand:   a 128 MiB List<u8> handed to a new thread (spawn copies it)
// sleep:  thread::sleep in a loop (parked)
// cblock: a blocking C call (usleep) in a loop (extern "C": parked)
use std::env;
use std::thread;

extern "C" {
    fn usleep(us: u32) -> i32;
}

trait Weigh { fn w(self) -> i64; }
struct Blob { a: i64; b: i64; c: i64; d: i64; }
impl Weigh for Blob { fn w(self) -> i64 { return self.a + self.d; } }

fn make(i: i64) -> any Weigh { return Blob { a: i, b: i, c: i, d: 1 }; }

fn churn(mb: i64) -> i64 {
    let steps = mb * 1048576 / 48;
    let ring: List<any Weigh> = [];
    let total: i64 = 0;
    let i: i64 = 0;
    while i < steps {
        let x = make(i);
        total += x.w();
        if i & 15 == 0 {
            if ring.len() < 1024 { ring.push(x); } else { ring[((i >> 4) & 1023) as usize] = x; }
        }
        i += 1;
    }
    return total;
}

fn spin(n: i64) -> i64 {
    let x: i64 = 88172645463325252;
    let i: i64 = 0;
    while i < n {
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        i += 1;
    }
    return x;
}

fn side(mode: str, rounds: i64) -> i64 {
    let total: i64 = 0;
    let r: i64 = 0;
    if mode == "count" || mode == "find" {
        let big = "abcdefgh".repeat(32 * 1048576);
        while r < rounds {
            if mode == "count" { total += big.char_count() as i64; }
            else if big.contains("zz") { total += 1; }
            r += 1;
        }
    } else if mode == "grow" {
        while r < rounds {
            let b = StrBuf::new();
            let piece = "abcdefgh".repeat(1048576);
            let k = 0;
            while k < 32 { b.push_str(piece); k += 1; }
            total += b.len() as i64;
            r += 1;
        }
    } else if mode == "hand" {
        while r < rounds {
            let bytes: List<u8> = List::with_capacity(128 * 1048576);
            let k = 0;
            while k < 128 * 1048576 { bytes.push((k & 255) as u8); k += 1; }
            let h = thread::spawn([move bytes] || bytes.len() as i64);
            total += try! h.join();
            r += 1;
        }
    } else if mode == "loop" {
        while r < rounds { total = total ^ spin(100000000); r += 1; }
    } else if mode == "sleep" {
        while r < rounds { thread::sleep(core::time::Duration::ms(5)); r += 1; }
    } else if mode == "cblock" {
        while r < rounds { unsafe { usleep(5000) }; r += 1; }
    }
    return total;
}

fn main() -> i32 {
    let args = env::args();
    let mode = args[1];
    let mb = try! args[2].parse::<i64>();
    let rounds: i64 = if mode == "none" { 0 } else { 1000000 };
    // The side thread runs until the churn is done: it is detached and
    // the process exits under it.
    _ = thread::spawn(|| side(mode, rounds));
    // Let the side thread build its data first.
    thread::sleep(core::time::Duration::ms(1500));
    let t = churn(mb);
    println(f"{t}");
    return 0;
}
