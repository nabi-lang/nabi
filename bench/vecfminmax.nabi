// Float min / max reductions over 1M elements, 100 times: `f64` and
// `f32` through `min` / `max` (runtime calls in the scalar loop) and a
// test (`if x < m`). Vector reductions whose lanes leave NaNs and zeros
// to the scalar loop.
fn least(xs: List<f64>) -> f64 {
    let m = 1.0 / 0.0;
    for x in xs {
        m = m.min(x);
    }
    m
}

fn greatest(xs: List<f64>) -> f64 {
    let m = -1.0 / 0.0;
    for x in xs {
        if x > m {
            m = x;
        }
    }
    m
}

fn spread(fs: List<f32>) -> f32 {
    let lo = 1.0f32 / 0.0f32;
    let hi = -1.0f32 / 0.0f32;
    for x in fs {
        lo = lo.min(x);
        hi = x.max(hi);
    }
    hi - lo
}

fn main() -> i32 {
    let n: usize = 1 << 20;
    let xs: List<f64> = List::filled(n, 0.0);
    let fs: List<f32> = List::filled(n, 0.0f32);
    let x: u64 = 3;
    for i in 0..n {
        x = x.wrapping_mul(6364136223846793005u64).wrapping_add(1442695040888963407u64);
        xs[i] = ((x >> 11) as f64) / 9007199254740992.0 - 0.25;
        fs[i] = ((x >> 40) as f32) / 16777216.0 + 0.5;
    }
    let t: f64 = 0.0;
    for r in 0..100 {
        xs[r * 7] = -1.0 - r as f64;
        t += least(xs) + greatest(xs) + spread(fs) as f64;
    }
    println(f"{t}");
    return 0;
}
